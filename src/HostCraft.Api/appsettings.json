{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Docker": {
    "Registry": {
      "Enabled": true,
      "Url": "localhost:5000",
      "Namespace": "hostcraft",
      "Secure": false,
      "Username": null,
      "Password": null
    }
  },
  "Storage": {
    "Type": "glusterfs",
    "GlusterFs": {
      "Enabled": true,
      "VolumeName": "hostcraft-volumes",
      "ReplicaCount": 3,
      "BrickPath": "/data/gluster/hostcraft",
      "MountPath": "/mnt/gluster/hostcraft",
      "AutoInstallServer": true,
      "AutoInstallClient": true
    },
    "Nfs": {
      "Enabled": false,
      "Server": "localhost",
      "ExportPath": "/nfs/hostcraft",
      "Version": 4,
      "AutoInstallClient": true
    }
  },
  "GitHub": {
    "ClientId": "",
    "ClientSecret": ""
  },
  "GitLab": {
    "ClientId": "",
    "ClientSecret": ""
  },
  "Bitbucket": {
    "ClientId": "",
    "ClientSecret": ""
  }
}
