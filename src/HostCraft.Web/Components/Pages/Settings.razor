    private async Task LoadHostCraftDomain()
    {
        try
        {
            var settings = await Http.GetFromJsonAsync<SystemSettingsDto>("api/systemsettings");
            if (settings != null)
            {
                hostcraftDomain = settings.HostCraftDomain;
                hostcraftApiDomain = settings.HostCraftApiDomain;
                hostcraftEnableHttps = settings.HostCraftEnableHttps;
                hostcraftLetsEncryptEmail = settings.HostCraftLetsEncryptEmail;
            }
        }
        catch (Exception ex)
        {
            domainError = $"Failed to load domain configuration: {ex.Message}";
            // Leave fields empty
            hostcraftDomain = null;
            hostcraftApiDomain = null;
            hostcraftEnableHttps = false;
            hostcraftLetsEncryptEmail = null;
        }
    }

    private async Task LoadTraefikDashboardSettings()
    {
        try
        {
            var settings = await Http.GetFromJsonAsync<SystemSettingsDto>("api/systemsettings");
            if (settings != null)
            {
                traefikDashboardDomain = settings.TraefikDashboardDomain;
                traefikDashboardAuthEnabled = settings.TraefikDashboardAuthEnabled;
                traefikDashboardUsername = settings.TraefikDashboardUsername;
                // Don't load password - it's a hash and shouldn't be displayed
            }
        }
        catch (Exception ex)
        {
            traefikDashboardError = $"Failed to load Traefik dashboard configuration: {ex.Message}";
        }
    }

    private async Task SaveTraefikDashboard()
    {
        savingTraefikDashboard = true;
        traefikDashboardError = null;
        traefikDashboardSuccess = null;

        try
        {
            // Validate
            if (traefikDashboardAuthEnabled)
            {
                if (string.IsNullOrWhiteSpace(traefikDashboardUsername))
                {
                    traefikDashboardError = "Username is required when authentication is enabled";
                    savingTraefikDashboard = false;
                    return;
                }

                if (string.IsNullOrWhiteSpace(traefikDashboardPassword))
                {
                    traefikDashboardError = "Password is required when authentication is enabled";
                    savingTraefikDashboard = false;
                    return;
                }
            }

            // Call API to save Traefik dashboard configuration
            var request = new ConfigureTraefikDashboardRequest(
                traefikDashboardDomain,
                traefikDashboardAuthEnabled,
                traefikDashboardUsername,
                traefikDashboardPassword
            );

            var response = await Http.PostAsJsonAsync("api/systemsettings/traefik-dashboard", request);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ConfigureTraefikDashboardResponse>();
                if (result?.Success == true)
                {
                    traefikDashboardSuccess = result.Message;
                    // Clear password field after successful save
                    traefikDashboardPassword = null;
                    // Update dashboard URL if domain is set
                    if (!string.IsNullOrEmpty(traefikDashboardDomain))
                    {
                        traefikDashboardUrl = $"https://{traefikDashboardDomain}";
                    }
                }
                else
                {
                    traefikDashboardError = result?.Message ?? "Configuration failed";
                }
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                traefikDashboardError = $"Failed to save configuration: {errorText}";
            }
        }
        catch (Exception ex)
        {
            traefikDashboardError = $"Failed to save Traefik dashboard configuration: {ex.Message}";
        }
        finally
        {
            savingTraefikDashboard = false;
        }
    }

    private async Task SaveHostCraftDomain()
    {
        savingDomain = true;
        domainError = null;
        domainSuccess = null;

        try
        {
            // Validate
            if (string.IsNullOrWhiteSpace(hostcraftDomain))
            {
                domainError = "Domain is required";
                savingDomain = false;
                return;
            }

            if (hostcraftEnableHttps && string.IsNullOrWhiteSpace(hostcraftLetsEncryptEmail))
            {
                domainError = "Email is required when HTTPS is enabled";
                savingDomain = false;
                return;
            }

            // Call API to save HostCraft domain configuration
            var request = new ConfigureHostCraftRequest(
                hostcraftDomain,
                hostcraftApiDomain,
                hostcraftEnableHttps,
                hostcraftLetsEncryptEmail
            );

            var response = await Http.PostAsJsonAsync("api/systemsettings", request);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ConfigureHostCraftResponse>();
                if (result?.Success == true)
                {
                    domainSuccess = result.Message;
                }
                else
                {
                    domainError = result?.Message ?? "Configuration failed";
                }
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                domainError = $"Failed to save configuration: {errorText}";
            }
        }
        catch (Exception ex)
        {
            domainError = $"Failed to save domain configuration: {ex.Message}";
        }
        finally
        {
            savingDomain = false;
        }
    }

