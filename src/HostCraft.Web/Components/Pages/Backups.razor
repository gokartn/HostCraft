@page "/backups"
@rendermode InteractiveServer
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject ILogger<Backups> Logger
@inject IJSRuntime JSRuntime
@using System.Text.Json
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Backup Management - HostCraft</PageTitle>

<div class="backups-page">
    <section class="hero-panel">
        <div class="hero-copy">
            <p class="eyebrow">Disaster recovery & data protection</p>
            <h1>Backup & Restore</h1>
            <p class="subtitle">Create, manage, and restore system backups with automated scheduling</p>
        </div>
        <div class="hero-metrics">
            <div class="metric-card">
                <span>Backups</span>
                <strong>@backups.Count</strong>
                <p>Total backups</p>
            </div>
            <div class="metric-card">
                <span>Providers</span>
                <strong>@configurations.Count(c => c.IsActive)</strong>
                <p>Active storage</p>
            </div>
            <div class="metric-card">
                <span>Latest</span>
                <strong>@(backups.Any() ? backups.First().StartedAt.ToString("MMM d") : "None")</strong>
                <p>Last backup</p>
            </div>
        </div>
    </section>

    <!-- Tabs -->
    <div class="tabs-container">
        <div class="tabs">
            <button class="tab @(activeTab == "overview" ? "active" : "")" @onclick='() => activeTab = "overview"'>
                <span class="tab-icon">📊</span>
                Overview
            </button>
            <button class="tab @(activeTab == "providers" ? "active" : "")" @onclick='() => activeTab = "providers"'>
                <span class="tab-icon">☁️</span>
                Storage Providers
            </button>
        </div>
    </div>

    <!-- Overview Tab -->
    @if (activeTab == "overview")
    {
        <!-- Backup Actions Section -->
        <section class="backup-actions-panel">
        <div>
            <h2>System Backups</h2>
            <p>Create and manage complete system backups</p>
        </div>
        <div class="action-buttons">
            <button class="btn btn-primary" @onclick="ShowBackupModal">
                <span class="icon">💾</span>
                Create Backup Now
            </button>
            <button class="btn btn-secondary" @onclick="ShowUploadModal">
                <span class="icon">📤</span>
                Upload Backup
            </button>
            <button class="btn btn-secondary" @onclick="LoadBackups">
                <span class="icon">🔄</span>
                Refresh
            </button>
        </div>
    </section>

    <!-- Backups List -->
    @if (loadingBackups)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading backups...</p>
        </div>
    }
    else if (backups.Count > 0)
    {
        <div class="backups-list">
            <h3>Recent Backups</h3>
            <div class="backups-table">
                <div class="table-header">
                    <div class="col-status">Status</div>
                    <div class="col-date">Created</div>
                    <div class="col-size">Size</div>
                    <div class="col-scope">Scope</div>
                    <div class="col-counts">Contents</div>
                    <div class="col-actions">Actions</div>
                </div>
                @foreach (var backup in backups.Take(10))
                {
                    <div class="table-row @(backup.Status == "Success" ? "success" : backup.Status == "Failed" ? "failed" : "")">
                        <div class="col-status">
                            <span class="status-badge status-@backup.Status.ToLower()">@backup.Status</span>
                        </div>
                        <div class="col-date">
                            <div class="date-info">
                                <span class="date">@backup.StartedAt.ToString("MMM d, yyyy")</span>
                                <span class="time">@backup.StartedAt.ToString("HH:mm:ss")</span>
                            </div>
                        </div>
                        <div class="col-size">@FormatBytes(backup.SizeBytes)</div>
                        <div class="col-scope">@backup.Scope</div>
                        <div class="col-counts">
                            @if (backup.ServerCount > 0) {<span class="count-badge">🖥️ @backup.ServerCount</span>}
                            @if (backup.ApplicationCount > 0) {<span class="count-badge">📦 @backup.ApplicationCount</span>}
                            @if (backup.ProjectCount > 0) {<span class="count-badge">📁 @backup.ProjectCount</span>}
                        </div>
                        <div class="col-actions">
                            <button class="btn btn-icon btn-sm" title="Download" @onclick="() => DownloadBackup(backup.Id)" disabled="@(backup.Status != "Success")">
                                <span>⬇️</span>
                            </button>
                            <button class="btn btn-icon btn-sm" title="Restore" @onclick="() => NavigateToRestore(backup.Id)" disabled="@(backup.Status != "Success")">
                                <span>♻️</span>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    }

    <!-- Storage Providers Tab -->
    @if (activeTab == "providers")
    {
    @if (loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading backup configurations...</p>
        </div>
    }
    else if (error != null)
    {
        <div class="error-banner">
            <span class="icon">❌</span>
            <div>
                <strong>Error loading configurations</strong>
                <p>@error</p>
            </div>
            <button class="btn btn-secondary" @onclick="LoadConfigurations">Retry</button>
        </div>
    }
    else
    {
        <section class="filters-panel">
            <div>
                <h2>Storage Providers</h2>
                <p>Configure S3-compatible storage, Google Drive, or local filesystem for your backups.</p>
            </div>
            <div class="filter-actions">
                <button class="btn btn-primary" @onclick="ShowCreateModal">
                    <span class="icon">➕</span>
                    Add Configuration
                </button>
            </div>
        </section>

        @if (configurations.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">💾</div>
                <h3>No backup configurations</h3>
                <p>Create your first storage provider configuration to start backing up your system.</p>
                <div class="mt-4">
                    <button class="btn btn-primary btn-lg" @onclick="ShowCreateModal">
                        <span class="icon">➕</span>
                        Create Configuration
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="configurations-grid">
                @foreach (var config in configurations)
                {
                    <article class="config-card @(config.IsActive ? "" : "inactive")">
                        <div class="card-accent"></div>
                        <div class="config-top">
                            <div class="config-icon">
                                @GetStorageIcon(config.StorageType)
                            </div>
                            <div class="config-heading">
                                <span class="config-type">@config.StorageType</span>
                                <h3>@config.Name</h3>
                            </div>
                            <div class="config-status">
                                @if (config.IsDefault)
                                {
                                    <span class="category-pill default">⭐ Default</span>
                                }
                                @if (config.IsActive)
                                {
                                    <span class="category-pill active">✓ Active</span>
                                }
                                else
                                {
                                    <span class="category-pill inactive">○ Inactive</span>
                                }
                            </div>
                        </div>

                        <div class="config-description">
                             Retention: @config.RetentionDays days • @(config.AutoBackupEnabled ? $"Scheduled: {config.AutoBackupSchedule}" : "Manual only")
                        </div>

                        <div class="config-specs">
                            <div class="spec-chip">
                                <span class="label">Compression</span>
                                <span class="value">@(config.EnableCompression ? "Enabled" : "Disabled")</span>
                            </div>
                            <div class="spec-chip">
                                <span class="label">Encryption</span>
                                <span class="value">@(config.EnableEncryption ? "Enabled" : "Disabled")</span>
                            </div>
                            <div class="spec-chip">
                                <span class="label">Created</span>
                                <span class="value">@config.CreatedAt.ToString("MMM d, yyyy")</span>
                            </div>
                        </div>

                        <div class="config-footer">
                            <div class="resource-hint">
                                <span class="hint-label">Last Backup</span>
                                <div class="hint-values">
                                    <span>@(config.LastBackupAt?.ToString("g") ?? "Never")</span>
                                </div>
                            </div>
                            <div class="config-actions">
                                <button class="btn btn-icon" title="Test connection" @onclick="() => TestConfiguration(config.Id)" disabled="@testingId.HasValue">
                                    @if (testingId == config.Id)
                                    {
                                        <span class="spinner-small"></span>
                                    }
                                    else
                                    {
                                        <span>🔌</span>
                                    }
                                </button>
                                <button class="btn btn-icon" title="Edit" @onclick="() => ShowEditModal(config)">
                                    <span>✏️</span>
                                </button>
                                <button class="btn btn-icon btn-danger" title="Delete" @onclick="() => ShowDeleteModal(config)">
                                    <span>🗑️</span>
                                </button>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    }
    }
</div>

<!-- Create/Edit Modal -->
@if (showModal && selectedConfig != null)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-content large" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>@(isEditing ? "Edit" : "Create") Backup Configuration</h2>
                <button class="modal-close" @onclick="CloseModal">×</button>
            </div>

            <div class="modal-body">
                @if (modalError != null)
                {
                    <div class="error-message">
                        <span class="icon">❌</span>
                        <span>@modalError</span>
                    </div>
                }

                <div class="form-group">
                    <label>Configuration Name *</label>
                    <input type="text" class="form-control" @bind="selectedConfig.Name" placeholder="e.g., AWS S3 Production" />
                </div>

                <div class="form-group">
                    <label>Storage Type *</label>
                    <select class="form-control" @bind="selectedConfig.StorageType" @bind:after="OnStorageTypeChanged">
                        <option value="">-- Select Storage Type --</option>
                        <option value="S3Compatible">S3-Compatible (AWS, MinIO, DigitalOcean Spaces)</option>
                        <option value="GoogleDrive">Google Drive</option>
                        <option value="LocalFileSystem">Local Filesystem</option>
                    </select>
                </div>

                <!-- S3 Configuration -->
                @if (selectedConfig.StorageType == "S3Compatible")
                {
                    <div class="provider-config-section">
                        <h4>S3 Configuration</h4>
                        <div class="form-row">
                            <div class="form-group">
                                <label>Endpoint URL *</label>
                                <input type="text" class="form-control" @bind="s3Endpoint" placeholder="https://s3.amazonaws.com" />
                            </div>
                            <div class="form-group">
                                <label>Bucket Name *</label>
                                <input type="text" class="form-control" @bind="s3BucketName" placeholder="my-backups" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>Region *</label>
                                <input type="text" class="form-control" @bind="s3Region" placeholder="us-east-1" />
                            </div>
                            <div class="form-group">
                                <label>Prefix (Optional)</label>
                                <input type="text" class="form-control" @bind="s3Prefix" placeholder="hostcraft/" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>Access Key ID *</label>
                                <input type="text" class="form-control" @bind="s3AccessKeyId" placeholder="AKIAIOSFODNN7EXAMPLE" />
                            </div>
                            <div class="form-group">
                                <label>Secret Access Key *</label>
                                <input type="password" class="form-control" @bind="s3SecretAccessKey" placeholder="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>
                                    <input type="checkbox" @bind="s3UsePathStyle" />
                                    Use Path Style (MinIO)
                                </label>
                            </div>
                            <div class="form-group">
                                <label>
                                    <input type="checkbox" @bind="s3UseSsl" />
                                    Use SSL
                                </label>
                            </div>
                        </div>
                    </div>
                }

                <!-- Google Drive Configuration -->
                @if (selectedConfig.StorageType == "GoogleDrive")
                {
                    <div class="provider-config-section">
                        <h4>Google Drive Configuration</h4>

                        <div class="oauth-flow-section">
                            <p class="section-description">Connect your Google account to automatically obtain access credentials</p>

                            <div class="form-row">
                                <div class="form-group">
                                    <label>Client ID *</label>
                                    <input type="text" class="form-control" @bind="gdClientId" placeholder="123456789-abc.apps.googleusercontent.com" />
                                    <small class="form-text">Get this from <a href="https://console.cloud.google.com/apis/credentials" target="_blank">Google Cloud Console</a></small>
                                </div>
                                <div class="form-group">
                                    <label>Client Secret *</label>
                                    <input type="password" class="form-control" @bind="gdClientSecret" />
                                </div>
                            </div>

                            <div class="oauth-button-container">
                                <button type="button" class="btn btn-google" @onclick="ConnectGoogleDrive" disabled="@(string.IsNullOrWhiteSpace(gdClientId) || string.IsNullOrWhiteSpace(gdClientSecret) || connectingGoogle)">
                                    @if (connectingGoogle)
                                    {
                                        <span class="spinner-small"></span>
                                        <text>Connecting...</text>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(gdRefreshToken))
                                    {
                                        <span>✓</span>
                                        <text>Connected - Reconnect</text>
                                    }
                                    else
                                    {
                                        <span>🔐</span>
                                        <text>Connect with Google</text>
                                    }
                                </button>
                                @if (!string.IsNullOrWhiteSpace(gdRefreshToken))
                                {
                                    <span class="success-badge">✓ Authenticated</span>
                                }
                            </div>

                            @if (oauthError != null)
                            {
                                <div class="error-message">
                                    <span class="icon">❌</span>
                                    <span>@oauthError</span>
                                </div>
                            }
                        </div>

                        <div class="divider-or">
                            <span>OR</span>
                        </div>

                        <div class="manual-config-section">
                            <p class="section-description">Manually enter tokens (advanced)</p>

                            <div class="form-group">
                                <label>Refresh Token @(string.IsNullOrWhiteSpace(gdRefreshToken) ? "*" : "(Auto-populated)")</label>
                                <input type="password" class="form-control" @bind="gdRefreshToken" placeholder="Enter manually or use 'Connect with Google'" readonly="@(!string.IsNullOrWhiteSpace(gdRefreshToken))" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Folder ID *</label>
                            <input type="text" class="form-control" @bind="gdFolderId" placeholder="1A2B3C4D5E6F7G8H9I0J" />
                            <small class="form-text">The Google Drive folder ID where backups will be stored. Leave empty for root folder.</small>
                        </div>

                        <div class="form-group">
                            <label>Service Account JSON (Optional)</label>
                            <textarea class="form-control" rows="4" @bind="gdServiceAccountJson" placeholder='{"type": "service_account", ...}'></textarea>
                            <small class="form-text">Alternative: Use service account authentication instead of OAuth2</small>
                        </div>
                    </div>
                }

                <!-- Local Filesystem Configuration -->
                @if (selectedConfig.StorageType == "LocalFileSystem")
                {
                    <div class="provider-config-section">
                        <h4>Local Filesystem Configuration</h4>
                        <div class="form-group">
                            <label>Storage Path *</label>
                            <input type="text" class="form-control" @bind="localStoragePath" placeholder="/var/backups/hostcraft" />
                            <small class="form-text">Absolute path on the server where backups will be stored</small>
                        </div>
                    </div>
                }

                <div class="form-section">
                    <h4>Backup Settings</h4>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Retention Days *</label>
                            <input type="number" class="form-control" @bind="selectedConfig.RetentionDays" min="1" placeholder="30" />
                        </div>
                        <div class="form-group">
                            <label>Auto-Backup Scope</label>
                            <select class="form-control" @bind="selectedConfig.AutoBackupScope">
                                <option value="15">Complete (Everything)</option>
                                <option value="1">System Configuration Only</option>
                                <option value="2">Servers Only</option>
                                <option value="4">Applications Only</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h4>Options</h4>
                    <div class="form-checkboxes">
                        <label>
                            <input type="checkbox" @bind="selectedConfig.IsActive" />
                            <span>Active (can be used for backups)</span>
                        </label>
                        <label>
                            <input type="checkbox" @bind="selectedConfig.IsDefault" />
                            <span>Set as default for this storage type</span>
                        </label>
                        <label>
                            <input type="checkbox" @bind="selectedConfig.EnableCompression" />
                            <span>Enable compression</span>
                        </label>
                        <label>
                            <input type="checkbox" @bind="selectedConfig.EnableEncryption" />
                            <span>Enable encryption</span>
                        </label>
                        <label>
                            <input type="checkbox" @bind="selectedConfig.VerifyAfterUpload" />
                            <span>Verify integrity after upload</span>
                        </label>
                        <label>
                            <input type="checkbox" @bind="selectedConfig.AutoBackupEnabled" />
                            <span>Enable automatic backups</span>
                        </label>
                    </div>
                </div>

                @if (selectedConfig.AutoBackupEnabled)
                {
                    <div class="form-group">
                        <label>Backup Schedule (Cron Expression)</label>
                        <input type="text" class="form-control" @bind="selectedConfig.AutoBackupSchedule" placeholder="0 2 * * *" />
                        <small class="form-text">Example: "0 2 * * *" = Daily at 2:00 AM</small>
                    </div>
                }

                @if (selectedConfig.EnableEncryption)
                {
                    <div class="form-group">
                        <label>Encryption Key</label>
                        <input type="password" class="form-control" @bind="selectedConfig.EncryptionKey" placeholder="Enter encryption key" />
                        <small class="form-text">Leave empty to auto-generate</small>
                    </div>
                }
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModal" disabled="@saving">
                    Cancel
                </button>
                <button class="btn btn-primary" @onclick="SaveConfiguration" disabled="@(!CanSave)">
                    @if (saving)
                    {
                        <span class="icon">⏳</span> <text>Saving...</text>
                    }
                    else
                    {
                        <span class="icon">💾</span> <text>@(isEditing ? "Update" : "Create") Configuration</text>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (showDeleteModal && configToDelete != null)
{
    <div class="modal-overlay" @onclick="CloseDeleteModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Delete Configuration</h2>
                <button class="modal-close" @onclick="CloseDeleteModal">×</button>
            </div>

            <div class="modal-body">
                <p>Are you sure you want to delete the backup configuration <strong>@configToDelete.Name</strong>?</p>
                <p class="warning-text">This action cannot be undone. Existing backups using this configuration will not be affected.</p>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseDeleteModal" disabled="@deleting">
                    Cancel
                </button>
                <button class="btn btn-danger" @onclick="DeleteConfiguration" disabled="@deleting">
                    @if (deleting)
                    {
                        <span class="icon">⏳</span> <text>Deleting...</text>
                    }
                    else
                    {
                        <span class="icon">🗑️</span> <text>Delete Configuration</text>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Create Backup Modal -->
@if (showBackupModal)
{
    <div class="modal-overlay" @onclick="CloseBackupModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Create System Backup</h2>
                <button class="modal-close" @onclick="CloseBackupModal">×</button>
            </div>

            <div class="modal-body">
                @if (backupError != null)
                {
                    <div class="error-message">
                        <span class="icon">❌</span>
                        <span>@backupError</span>
                    </div>
                }

                <div class="form-group">
                    <label>Backup Scope</label>
                    <select class="form-control" @bind="selectedBackupScope">
                        <option value="1023">Complete (Everything) - Recommended</option>
                        <option value="1">System Configuration Only</option>
                        <option value="2">Servers Only</option>
                        <option value="4">Applications Only</option>
                        <option value="6">Applications + Servers</option>
                        <option value="64">Certificates Only</option>
                        <option value="128">Git Integrations Only</option>
                    </select>
                    <small class="form-text">Choose what to include in the backup</small>
                </div>

                <div class="form-group">
                    <label>Storage Configuration (Optional)</label>
                    <select class="form-control" @bind="selectedBackupConfigId">
                        <option value="">Local only</option>
                        @foreach (var config in configurations.Where(c => c.IsActive))
                        {
                            <option value="@config.Id">@config.Name (@config.StorageType)</option>
                        }
                    </select>
                    <small class="form-text">Select a storage provider to upload the backup after creation</small>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseBackupModal" disabled="@creatingBackup">
                    Cancel
                </button>
                <button class="btn btn-primary" @onclick="CreateBackupNow" disabled="@creatingBackup">
                    @if (creatingBackup)
                    {
                        <span class="icon">⏳</span> <text>Creating...</text>
                    }
                    else
                    {
                        <span class="icon">💾</span> <text>Create Backup</text>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Upload Backup Modal -->
@if (showUploadModal)
{
    <div class="modal-overlay" @onclick="CloseUploadModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Upload Backup</h2>
                <button class="modal-close" @onclick="CloseUploadModal">×</button>
            </div>

            <div class="modal-body">
                @if (uploadError != null)
                {
                    <div class="error-message">
                        <span class="icon">❌</span>
                        <span>@uploadError</span>
                    </div>
                }

                @if (uploadSuccess)
                {
                    <div class="success-message">
                        <span class="icon">✓</span>
                        <span>Backup uploaded successfully! You can now restore from it.</span>
                    </div>
                }

                <div class="upload-area">
                    <InputFile id="backupFileInput" OnChange="HandleFileSelected" accept=".tar.gz" disabled="@uploading" />
                    <label for="backupFileInput" class="upload-label @(uploading ? "disabled" : "")">
                        <div class="upload-icon">📤</div>
                        @if (string.IsNullOrEmpty(uploadedFileName))
                        {
                            <div class="upload-text">
                                <strong>Click to select backup file</strong>
                                <span>or drag and drop</span>
                            </div>
                        }
                        else
                        {
                            <div class="upload-text">
                                <strong>@uploadedFileName</strong>
                                <span>@FormatBytes(uploadedFileSize)</span>
                            </div>
                        }
                        <div class="upload-hint">Only .tar.gz files are supported (max 10GB)</div>
                    </label>
                </div>

                @if (uploading)
                {
                    <div class="upload-progress">
                        <div class="progress-bar">
                            <div class="progress-fill" style="width: @uploadProgress%"></div>
                        </div>
                        <div class="progress-text">Uploading... @uploadProgress%</div>
                    </div>
                }
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseUploadModal" disabled="@uploading">
                    Cancel
                </button>
                <button class="btn btn-primary" @onclick="UploadBackupFile" disabled="@(uploading || string.IsNullOrEmpty(uploadedFileName) || uploadSuccess)">
                    @if (uploading)
                    {
                        <span class="icon">⏳</span> <text>Uploading...</text>
                    }
                    else if (uploadSuccess)
                    {
                        <span class="icon">✓</span> <text>Uploaded</text>
                    }
                    else
                    {
                        <span class="icon">📤</span> <text>Upload & Import</text>
                    }
                </button>
            </div>
        </div>
    </div>
}

