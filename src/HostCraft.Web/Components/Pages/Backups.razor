        uploadError = null;
        uploadSuccess = false;
        uploadedFileName = null;
        uploadedFileSize = 0;
        selectedFile = null;
        uploadProgress = 0;
    }

    private void CloseUploadModal()
    {
        showUploadModal = false;
        selectedFile = null;
        uploadedFileName = null;
        uploadError = null;
        uploadSuccess = false;
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        uploadedFileName = e.File.Name;
        uploadedFileSize = e.File.Size;
        uploadError = null;

        // Validate file extension
        if (!uploadedFileName.EndsWith(".tar.gz", StringComparison.OrdinalIgnoreCase))
        {
            uploadError = "Only .tar.gz backup files are supported";
            selectedFile = null;
            uploadedFileName = null;
            return;
        }

        // Validate file size (10GB max)
        if (uploadedFileSize > 10L * 1024 * 1024 * 1024)
        {
            uploadError = "File size exceeds 10GB limit";
            selectedFile = null;
            uploadedFileName = null;
            return;
        }
    }

    private async Task UploadBackupFile()
    {
        if (selectedFile == null)
        {
            uploadError = "Please select a file first";
            return;
        }

        uploading = true;
        uploadError = null;
        uploadProgress = 0;

        try
        {
            // Create multipart form content
            using var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(selectedFile.OpenReadStream(10L * 1024 * 1024 * 1024)); // 10GB max
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/gzip");
            content.Add(fileContent, "file", selectedFile.Name);

            // Upload with progress tracking
            var response = await Http.PostAsync("api/Backups/upload", content);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<UploadBackupResponse>();
                uploadSuccess = true;
                uploadProgress = 100;

                // Refresh backup list
                await LoadBackups();

                testResult = new TestResult
                {
                    Success = true,
                    Message = $"Backup uploaded successfully! Backup ID: {result?.BackupId}"
                };
                _ = Task.Delay(5000).ContinueWith(_ => testResult = null);

                // Close modal after delay
                _ = Task.Delay(2000).ContinueWith(_ =>
                {
                    CloseUploadModal();
                    StateHasChanged();
                });
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                uploadError = $"Upload failed: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error uploading backup file");
            uploadError = $"Upload error: {ex.Message}";
        }
        finally
        {
            uploading = false;
        }
    }

    private string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024 * 1024 * 1024) return $"{bytes / (1024.0 * 1024.0):F1} MB";
        return $"{bytes / (1024.0 * 1024.0 * 1024.0):F1} GB";
    }

