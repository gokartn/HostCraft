            {
                var contentDisposition = response.Content.Headers.ContentDisposition?.FileName ?? $"backup-{backupId}.tar.gz";
                var fileName = contentDisposition.Trim('"');

                var fileBytes = await response.Content.ReadAsByteArrayAsync();
                await JSRuntime.InvokeVoidAsync("downloadFile", fileName, Convert.ToBase64String(fileBytes));
            }
            else
            {
                testResult = new TestResult { Success = false, Message = "Failed to download backup" };
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error downloading backup");
