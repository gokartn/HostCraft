    private void ResetProviderFields()
    {
        // S3
        s3Endpoint = "https://s3.amazonaws.com";
        s3BucketName = "";
        s3Region = "us-east-1";
        s3AccessKeyId = "";
        s3SecretAccessKey = "";
        s3Prefix = "";
        s3UsePathStyle = false;
        s3UseSsl = true;

        // Google Drive
        gdClientId = "";
        gdClientSecret = "";
        gdRefreshToken = "";
        gdFolderId = "";
        gdServiceAccountJson = "";

        // Local
        localStoragePath = "/var/backups/hostcraft";
    }

    private void LoadProviderFields(BackupConfigurationDto config)
    {
        try
        {
            var providerConfig = JsonSerializer.Deserialize<JsonElement>(config.ProviderConfiguration);

            if (config.StorageType == "S3Compatible")
            {
                s3Endpoint = providerConfig.GetProperty("Endpoint").GetString() ?? "";
                s3BucketName = providerConfig.GetProperty("BucketName").GetString() ?? "";
                s3Region = providerConfig.GetProperty("Region").GetString() ?? "";
                s3AccessKeyId = providerConfig.GetProperty("AccessKeyId").GetString() ?? "";
                s3SecretAccessKey = providerConfig.GetProperty("SecretAccessKey").GetString() ?? "";
                s3Prefix = providerConfig.TryGetProperty("Prefix", out var prefix) ? prefix.GetString() ?? "" : "";
                s3UsePathStyle = providerConfig.TryGetProperty("UsePathStyle", out var pathStyle) && pathStyle.GetBoolean();
                s3UseSsl = providerConfig.TryGetProperty("UseSsl", out var useSsl) ? useSsl.GetBoolean() : true;
            }
            else if (config.StorageType == "GoogleDrive")
            {
                gdClientId = providerConfig.GetProperty("ClientId").GetString() ?? "";
                gdClientSecret = providerConfig.GetProperty("ClientSecret").GetString() ?? "";
                gdRefreshToken = providerConfig.GetProperty("RefreshToken").GetString() ?? "";
                gdFolderId = providerConfig.GetProperty("FolderId").GetString() ?? "";
                gdServiceAccountJson = providerConfig.TryGetProperty("ServiceAccountJson", out var sa) ? sa.GetString() ?? "" : "";
            }
            else if (config.StorageType == "LocalFileSystem")
            {
                localStoragePath = providerConfig.GetProperty("StoragePath").GetString() ?? "";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading provider configuration");
        }
    }

    private async Task SaveConfiguration()
    {
        if (selectedConfig == null) return;

        saving = true;
        modalError = null;

        try
        {
            // Build provider configuration JSON
            string providerConfigJson = selectedConfig.StorageType switch
            {
                "S3Compatible" => JsonSerializer.Serialize(new
                {
                    Endpoint = s3Endpoint,
                    BucketName = s3BucketName,
                    Region = s3Region,
                    AccessKeyId = s3AccessKeyId,
                    SecretAccessKey = s3SecretAccessKey,
                    Prefix = s3Prefix,
                    UsePathStyle = s3UsePathStyle,
                    UseSsl = s3UseSsl
                }),
                "GoogleDrive" => JsonSerializer.Serialize(new
                {
                    ClientId = gdClientId,
                    ClientSecret = gdClientSecret,
                    RefreshToken = gdRefreshToken,
                    FolderId = gdFolderId,
                    ServiceAccountJson = string.IsNullOrWhiteSpace(gdServiceAccountJson) ? null : gdServiceAccountJson
                }),
                "LocalFileSystem" => JsonSerializer.Serialize(new
                {
                    StoragePath = localStoragePath
                }),
                _ => "{}"
            };

            var request = new
            {
                Name = selectedConfig.Name,
                StorageType = selectedConfig.StorageType == "S3Compatible" ? 0 : selectedConfig.StorageType == "GoogleDrive" ? 1 : 2,
                IsActive = selectedConfig.IsActive,
                IsDefault = selectedConfig.IsDefault,
                RetentionDays = selectedConfig.RetentionDays,
                AutoBackupEnabled = selectedConfig.AutoBackupEnabled,
                AutoBackupSchedule = selectedConfig.AutoBackupSchedule,
                AutoBackupScope = selectedConfig.AutoBackupScope == "Complete" ? 15 : 1,
                EnableCompression = selectedConfig.EnableCompression,
                EnableEncryption = selectedConfig.EnableEncryption,
                EncryptionKey = selectedConfig.EncryptionKey,
                VerifyAfterUpload = selectedConfig.VerifyAfterUpload,
                S3Config = selectedConfig.StorageType == "S3Compatible" ? JsonSerializer.Deserialize<object>(providerConfigJson) : null,
                GoogleDriveConfig = selectedConfig.StorageType == "GoogleDrive" ? JsonSerializer.Deserialize<object>(providerConfigJson) : null,
                LocalFileSystemConfig = selectedConfig.StorageType == "LocalFileSystem" ? JsonSerializer.Deserialize<object>(providerConfigJson) : null
            };

            HttpResponseMessage response;
            if (isEditing)
            {
                response = await Http.PutAsJsonAsync($"api/BackupConfigurations/{selectedConfig.Id}", request);
            }
            else
            {
                response = await Http.PostAsJsonAsync("api/BackupConfigurations", request);
            }

            if (response.IsSuccessStatusCode)
            {
                await LoadConfigurations();
                CloseModal();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                modalError = $"Failed to save configuration: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving backup configuration");
            modalError = $"An error occurred: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteConfiguration()
    {
        if (configToDelete == null) return;

        deleting = true;

        try
        {
            var response = await Http.DeleteAsync($"api/BackupConfigurations/{configToDelete.Id}");
            if (response.IsSuccessStatusCode)
            {
                await LoadConfigurations();
                CloseDeleteModal();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                modalError = $"Failed to delete configuration: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting backup configuration");
            modalError = $"An error occurred: {ex.Message}";
        }
        finally
        {
            deleting = false;
        }
    }

    private async Task TestConfiguration(int id)
    {
        testingId = id;
        testResult = null;

        try
        {
            var response = await Http.PostAsync($"api/BackupConfigurations/{id}/test", null);
            var result = await response.Content.ReadFromJsonAsync<TestConnectionResponse>();
            
            testResult = new TestResult
            {
                Success = result?.Success ?? false,
                Message = result?.Message ?? "Unknown error"
            };

            // Auto-hide after 5 seconds
            _ = Task.Delay(5000).ContinueWith(_ => testResult = null);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error testing backup configuration");
            testResult = new TestResult
            {
                Success = false,
                Message = $"Test failed: {ex.Message}"
            };
        }
        finally
        {
            testingId = null;
        }
    }

    private string GetStorageIcon(string storageType)
    {
        return storageType switch
        {
            "S3Compatible" => "☁️",
            "GoogleDrive" => "📁",
            "LocalFileSystem" => "💾",
            _ => "📦"
        };
    }

    private async Task ConnectGoogleDrive()
    {
        connectingGoogle = true;
        oauthError = null;

        try
        {
            // Call backend to initiate OAuth flow
            var response = await Http.PostAsJsonAsync("api/GoogleDriveOAuth/initiate", new
            {
                ClientId = gdClientId,
                ClientSecret = gdClientSecret
            });

            if (!response.IsSuccessStatusCode)
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                oauthError = $"Failed to initiate OAuth: {errorContent}";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<OAuthInitiateResponse>();
            if (result == null || string.IsNullOrEmpty(result.AuthorizationUrl))
            {
                oauthError = "Invalid OAuth response";
                return;
            }

            // Open OAuth popup
            await OpenOAuthPopup(result.AuthorizationUrl);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error connecting to Google Drive");
            oauthError = $"Error: {ex.Message}";
        }
        finally
        {
            connectingGoogle = false;
        }
    }

    private async Task OpenOAuthPopup(string url)
    {
        // Use JavaScript to open popup and listen for message
        await JSRuntime.InvokeVoidAsync("openGoogleOAuthPopup", url, DotNetObjectReference.Create(this));
    }

    [JSInvokable]
    public void OnGoogleOAuthSuccess(string refreshToken)
    {
        gdRefreshToken = refreshToken;
        oauthError = null;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnGoogleOAuthError(string error)
    {
        oauthError = error;
        StateHasChanged();
    }

    private class BackupConfigurationDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string StorageType { get; set; } = "";
        public bool IsActive { get; set; }
        public bool IsDefault { get; set; }
        public string ProviderConfiguration { get; set; } = "";
        public int RetentionDays { get; set; }
        public bool AutoBackupEnabled { get; set; }
        public string? AutoBackupSchedule { get; set; }
        public string AutoBackupScope { get; set; } = "";
        public bool EnableCompression { get; set; }
        public bool EnableEncryption { get; set; }
        public string? EncryptionKey { get; set; }
        public bool VerifyAfterUpload { get; set; }
        public DateTime CreatedAt { get; set; }
        public DateTime? LastBackupAt { get; set; }
    }

    private class TestConnectionResponse
    {
        public bool Success { get; set; }
        public string Message { get; set; } = "";
    }

    private class TestResult
    {
        public bool Success { get; set; }
        public string Message { get; set; } = "";
    }

    private class OAuthInitiateResponse
    {
        public string AuthorizationUrl { get; set; } = "";
        public string State { get; set; } = "";
    }

    private class BackupDto
    {
        public int Id { get; set; }
        public string Status { get; set; } = "";
        public DateTime StartedAt { get; set; }
        public long SizeBytes { get; set; }
        public string Scope { get; set; } = "";
        public int ProjectCount { get; set; }
        public int ApplicationCount { get; set; }
        public int ServerCount { get; set; }
    }

    private class UploadBackupResponse
    {
        public int BackupId { get; set; }
        public Guid Uuid { get; set; }
        public string Message { get; set; } = "";
    }
}

