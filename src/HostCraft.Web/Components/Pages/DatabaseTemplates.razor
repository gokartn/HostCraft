@page "/databases/templates"
@page "/templates"
@rendermode InteractiveServer
@inject HttpClient Http
@inject IWebAuthService AuthService
@inject NavigationManager Navigation
@inject ILogger<DatabaseTemplates> Logger
@using System.Collections.Generic
@using System.Net
@using System.Linq
@using System.Security.Cryptography
@using System.Text
@using System.Text.Json
@using HostCraft.Web.Services

<PageTitle>Database Templates - HostCraft</PageTitle>

<div class="database-templates-page">
    <section class="hero-panel">
        <div class="hero-copy">
            <p class="eyebrow">High-availability data layers</p>
            <h1>Database Templates</h1>
            <p class="subtitle">Launch resilient, multi-node databases with opinionated defaults that honor HostCraft's HA/DR mandate.</p>
            <div class="hero-tags">
                <span class="tag">Swarm ready</span>
                <span class="tag">Zero-downtime deploy</span>
                <span class="tag">Project scoped</span>
            </div>
        </div>
        <div class="hero-metrics">
            <div class="metric-card">
                <span>Templates</span>
                <strong>@templates.Count</strong>
                <p>Curated service blueprints</p>
            </div>
            <div class="metric-card">
                <span>Categories</span>
                <strong>@categories.Count</strong>
                <p>Optimized stacks</p>
            </div>
            <div class="metric-card">
                <span>Ready Servers</span>
                <strong>@servers.Count</strong>
                <p>Eligible targets</p>
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(projectContextName))
    {
        <div class="project-context-banner">
            <div>
                <strong>Project Context:</strong> @projectContextName
                <p class="context-subtext">Deployed databases will be attached to this project.</p>
            </div>
            <button class="btn btn-secondary" @onclick="ClearProjectContext">Clear</button>
        </div>
    }

    @if (loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading database templates...</p>
        </div>
    }
    else if (error != null)
    {
        <div class="error-banner">
            <span class="icon">❌</span>
            <div>
                <strong>Error loading templates</strong>
                <p>@error</p>
            </div>
            <button class="btn btn-secondary" @onclick="LoadTemplates">Retry</button>
        </div>
    }
    else
    {
        var filteredTemplates = GetFilteredTemplates().ToList();

        <section class="filters-panel">
            <div>
                <h2>Explore templates</h2>
                <p>Pick a blueprint, wire it to a Swarm manager, and HostCraft handles the rest.</p>
            </div>
            <div class="filter-summary">
                <span>@filteredTemplates.Count templates</span>
                <span>Category: @selectedCategory</span>
            </div>
        </section>

        <div class="category-tabs">
            <button class="tab @(selectedCategory == "All" ? "active" : "")" @onclick="@(() => selectedCategory = "All")">
                <span class="icon">@GetCategoryIcon("All")</span>
                <span>All Templates</span>
            </button>
            @foreach (var category in categories)
            {
                var cat = category;
                <button class="tab @(selectedCategory == cat ? "active" : "")" @onclick="@(() => selectedCategory = cat)">
                    <span class="icon">@GetCategoryIcon(cat)</span>
                    <span>@cat</span>
                </button>
            }
        </div>

        @if (filteredTemplates.Count == 0)
        {
            <div class="empty-state">
                <h3>No templates in this category</h3>
                <p>Switch categories or sync new templates from Git to keep your catalog fresh.</p>
            </div>
        }
        else
        {
            <div class="templates-grid">
                @foreach (var template in filteredTemplates)
                {
                    <article class="template-card">
                        <div class="card-accent"></div>
                        <div class="template-top">
                            <div class="template-icon">
                                @GetDatabaseIcon(template.Type)
                            </div>
                            <div class="template-heading">
                                <span class="template-type">@template.Type</span>
                                <h3>@template.Name</h3>
                            </div>
                            <span class="category-pill">@GetCategoryIcon(template.Category) @template.Category</span>
                        </div>

                        <p class="template-description">@template.Description</p>

                        <div class="template-specs">
                            <div class="spec-chip">
                                <span class="label">Image</span>
                                <span class="value">@template.DockerImage</span>
                            </div>
                            <div class="spec-chip">
                                <span class="label">Port</span>
                                <span class="value">@template.DefaultPort</span>
                            </div>
                            <div class="spec-chip">
                                <span class="label">Memory</span>
                                <span class="value">@FormatMemory(template)</span>
                            </div>
                            <div class="spec-chip">
                                <span class="label">CPU</span>
                                <span class="value">@FormatCpu(template)</span>
                            </div>
                        </div>

                        <div class="template-footer">
                            <div class="resource-hint">
                                <span class="hint-label">Recommended footprint</span>
                                <div class="hint-values">
                                    <span>@FormatMemory(template)</span>
                                    <span>@FormatCpu(template)</span>
                                </div>
                            </div>
                            <button class="btn btn-primary" @onclick="async () => await ShowDeployModal(template)">
                                <span class="icon">🚀</span>
                                Deploy
                            </button>
                        </div>
                    </article>
                }
            </div>
        }
    }
</div>

<!-- Deploy Modal -->
@if (showDeployModal && selectedTemplate != null)
{
    <div class="modal-overlay" @onclick="CloseDeployModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Deploy @selectedTemplate.Name</h2>
                <button class="modal-close" @onclick="CloseDeployModal">×</button>
            </div>

            <div class="modal-body">
                @if (deployError != null)
                {
                    <div class="error-message">
                        <span class="icon">❌</span>
                        <span>@deployError</span>
                    </div>
                }
                @if (lastDeployResponse != null)
                {
                    <div class="success-panel">
                        <h3>Deployment queued</h3>
                        <p>Your database is provisioning with the hardened credentials below. Store them securely.</p>
                        <div class="success-grid">
                            @foreach (var envVar in lastDeployResponse.EnvironmentVariables.Where(e => e.DisplayInWizard))
                            {
                                <div class="success-card">
                                    <span class="label">@envVar.Label <small>@envVar.Key</small></span>
                                    <code>@envVar.Value</code>
                                </div>
                            }
                        </div>
                        <div class="success-meta">
                            <span>Image: @lastDeployResponse.DockerImage</span>
                            @if (lastDeployResponse.PublishedPort.HasValue)
                            {
                                <span>Published Port: @lastDeployResponse.PublishedPort</span>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="form-group">
                        <label>Database Name *</label>
                        <input type="text" class="form-control" value="@databaseName" @oninput="OnDatabaseNameChanged" placeholder="e.g., my-postgres-db" autocomplete="off" />
                    </div>

                    <div class="form-group">
                        <label>Server *</label>
                        <select class="form-control" @bind="selectedServerId">
                            <option value="0">-- Select a server --</option>
                            @foreach (var server in servers)
                            {
                                <option value="@server.Id">@server.Name (@server.Type)</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Project *</label>
                        <select class="form-control" @bind="selectedProjectId">
                            <option value="0">-- Select a project --</option>
                            @foreach (var project in projects)
                            {
                                <option value="@project.Id">@project.Name</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Docker Image</label>
                        <input type="text" class="form-control" @bind="dockerImageInput" placeholder="e.g., postgres:16-alpine" autocomplete="off" />
                        <small class="form-text">Preloaded from the template; override with your preferred tag if needed.</small>
                    </div>

                    <div class="form-group">
                        <label>Memory Limit (MB)</label>
                        <input type="number" class="form-control" @bind="memoryLimitMB" placeholder="@(selectedTemplate.RecommendedMemoryMB?.ToString() ?? "512")" />
                        <small class="form-text">Recommended: @(selectedTemplate.RecommendedMemoryMB ?? 512) MB</small>
                    </div>

                    <div class="form-group">
                        <label>CPU Limit (Cores)</label>
                        <input type="number" step="0.1" class="form-control" @bind="cpuLimitCores" placeholder="@(selectedTemplate.RecommendedCpuCores?.ToString("0.0") ?? "0.5")" />
                        <small class="form-text">Recommended: @(selectedTemplate.RecommendedCpuCores?.ToString("0.0") ?? "0.5") cores</small>
                    </div>

                    @if (templateDetailLoading)
                    {
                        <div class="loading-state inline">
                            <div class="spinner"></div>
                            <p>Loading hardening defaults…</p>
                        </div>
                    }
                    else if (credentialInputs.Any(ci => ci.DisplayInWizard))
                    {
                        <div class="credential-section">
                            <div class="section-header">
                                <h4>Credential &amp; policy defaults</h4>
                                <p>HostCraft generates secure usernames, passwords, and database names per template. Adjust only if required.</p>
                            </div>
                            @foreach (var variable in credentialInputs.Where(ci => ci.DisplayInWizard))
                            {
                                <div class="credential-field">
                                    <label>@variable.Label @if (variable.IsRequired) { <span class="required">*</span> }</label>
                                    <small class="env-key">@variable.Key</small>
                                    <div class="credential-input-row">
                                        <input type="@(variable.IsSecret && !variable.RevealSecret ? "password" : "text")"
                                               class="form-control"
                                               value="@variable.Value"
                                               autocomplete="off"
                                               @oninput="e => OnCredentialValueChanged(variable, e.Value?.ToString())" />

                                        @if (variable.IsSecret)
                                        {
                                            <button type="button" class="btn btn-icon" title="Toggle visibility" @onclick="() => ToggleSecretVisibility(variable)">
                                                @(variable.RevealSecret ? "🙈" : "👁️")
                                            </button>
                                        }
                                        <button type="button" class="btn btn-icon" title="Regenerate" @onclick="() => RegenerateCredential(variable)">
                                            ↻
                                        </button>
                                    </div>
                                    <small class="form-text">@variable.Description</small>
                                </div>
                            }
                        </div>
                    }

                    <div class="form-group">
                        <label>
                            <input type="checkbox" @bind="showAdvanced" /> Advanced Options
                        </label>
                    </div>

                    @if (showAdvanced)
                    {
                        <div class="advanced-section">
                            <h4>Environment Variables</h4>
                            <p class="help-text">Add extra variables or override the generated defaults.</p>
                            <div class="env-vars">
                                @for (int i = 0; i < envVarKeys.Count; i++)
                                {
                                    var index = i;
                                    <div class="env-var-row">
                                        <input type="text" class="form-control" @bind="envVarKeys[index]" placeholder="KEY" />
                                        <input type="text" class="form-control" @bind="envVarValues[index]" placeholder="value" />
                                        <button class="btn btn-danger btn-sm" @onclick="() => RemoveEnvVar(index)">×</button>
                                    </div>
                                }
                            </div>
                            <button class="btn btn-secondary btn-sm" @onclick="AddEnvVar">
                                <span class="icon">➕</span> Add Variable
                            </button>
                        </div>
                    }
                }
            </div>

            <div class="modal-footer">
                @if (lastDeployResponse != null)
                {
                    <button class="btn btn-secondary" @onclick="CloseDeployModal">Close</button>
                    <button class="btn btn-primary" @onclick="GoToApplicationsAfterSuccess">
                        View Applications
                    </button>
                }
                else
                {
                    <button class="btn btn-secondary" @onclick="CloseDeployModal" disabled="@deploying">
                        Cancel
                    </button>
                    <button class="btn btn-primary" @onclick="DeployDatabase" disabled="@(!CanDeploy)">
                        @if (deploying)
                        {
                            <span class="icon">⏳</span> <text>Deploying...</text>
                        }
                        else if (templateDetailLoading)
                        {
                            <span class="icon">⏳</span> <text>Loading...</text>
                        }
                        else if (string.IsNullOrWhiteSpace(databaseName))
                        {
                            <span class="icon">📝</span> <text>Enter Database Name</text>
                        }
                        else if (selectedServerId == 0)
                        {
                            <span class="icon">🖥️</span> <text>Select Server</text>
                        }
                        else if (selectedProjectId == 0)
                        {
                            <span class="icon">📁</span> <text>Select Project</text>
                        }
                        else
                        {
                            <span class="icon">🚀</span> <text>Deploy Database</text>
                        }
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<DatabaseTemplateDto> templates = new();
    private List<ServerDto> servers = new();
    private List<ProjectDto> projects = new();
    private bool loading = true;
    private string? error = null;
    private string selectedCategory = "All";
    private List<string> categories = new();
    private string? projectContextName;
    private int? projectIdFromQuery;

    // Deploy modal state
    private bool showDeployModal = false;
    private DatabaseTemplateDto? selectedTemplate = null;
    private string databaseName = "";
    private int selectedServerId = 0;
    private int selectedProjectId = 0;
    private string dockerImageInput = string.Empty;
    private long? memoryLimitMB = null;
    private double? cpuLimitCores = null;
    private bool showAdvanced = false;
    private List<string> envVarKeys = new();
    private List<string> envVarValues = new();
    private bool deploying = false;
    private string? deployError = null;
    private DatabaseTemplateDetailDto? selectedTemplateDetail;
    private bool templateDetailLoading = false;
    private List<EnvironmentVariableInputModel> credentialInputs = new();
    private DeployDatabaseResponseDto? lastDeployResponse;

    private bool CanDeploy => !deploying 
        && !templateDetailLoading 
        && !string.IsNullOrWhiteSpace(databaseName) 
        && selectedServerId > 0 
        && selectedProjectId > 0
        && credentialInputs.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        ReadProjectContextFromQuery();
        await LoadTemplates();
        await LoadServers();
        await LoadProjects();
    }

    private async Task LoadTemplates()
    {
        loading = true;
        error = null;

        try
        {
            var response = await Http.GetAsync("api/DatabaseTemplates");
            if (response.IsSuccessStatusCode)
            {
                templates = await response.Content.ReadFromJsonAsync<List<DatabaseTemplateDto>>() ?? new();
                categories = templates.Select(t => t.Category).Distinct().OrderBy(c => c).ToList();
            }
            else
            {
                error = $"Failed to load templates: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading database templates");
            error = "An error occurred while loading templates";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadServers()
    {
        try
        {
            servers = await Http.GetFromJsonAsync<List<ServerDto>>("api/Servers") ?? new();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading servers");
        }
    }

    private async Task LoadProjects()
    {
        try
        {
            projects = await Http.GetFromJsonAsync<List<ProjectDto>>("api/Projects") ?? new();
            ApplyProjectContext();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading projects");
        }
    }

    private void ApplyProjectContext()
    {
        if (projectIdFromQuery.HasValue)
        {
            var project = projects.FirstOrDefault(p => p.Id == projectIdFromQuery.Value);
            if (project != null)
            {
                projectContextName = project.Name;
                selectedProjectId = project.Id;
                return;
            }
        }

        if (selectedProjectId == 0)
        {
            selectedProjectId = projects.FirstOrDefault()?.Id ?? 0;
        }
    }

    private IEnumerable<DatabaseTemplateDto> GetFilteredTemplates()
    {
        if (selectedCategory == "All")
            return templates;
        return templates.Where(t => t.Category == selectedCategory);
    }

    private string GetDatabaseIcon(string type)
    {
        return type switch
        {
            "PostgreSQL" => "🐘",
            "MySQL" => "🐬",
            "MongoDB" => "🍃",
            "Redis" => "⚡",
            "MariaDB" => "🦭",
            "Clickhouse" => "📊",
            "DragonFly" => "🐉",
            "KeyDB" => "🔑",
            _ => "💾"
        };
    }

    private string GetCategoryIcon(string category)
    {
        return category switch
        {
            "Analytics" => "📈",
            "Cache" => "⚡",
            "NoSQL" => "🗂️",
            "SQL" => "🧮",
            "Message Queue" => "📨",
            "Search" => "🔎",
            "Monitoring" => "📡",
            _ => "✨"
        };
    }

    private string FormatMemory(DatabaseTemplateDto template)
        => template.RecommendedMemoryMB.HasValue
            ? $"{template.RecommendedMemoryMB.Value:N0} MB"
            : "Auto";

    private string FormatCpu(DatabaseTemplateDto template)
        => template.RecommendedCpuCores.HasValue
            ? $"{template.RecommendedCpuCores.Value:0.0} cores"
            : "Auto";

    private async Task ShowDeployModal(DatabaseTemplateDto template)
    {
        selectedTemplate = template;
        showDeployModal = true;
        databaseName = string.Empty;
        selectedServerId = servers.FirstOrDefault()?.Id ?? 0;
        selectedProjectId = DetermineProjectSelection();
        dockerImageInput = template.DockerImage;
        memoryLimitMB = template.RecommendedMemoryMB;
        cpuLimitCores = template.RecommendedCpuCores;
        showAdvanced = false;
        envVarKeys.Clear();
        envVarValues.Clear();
        deployError = null;
        lastDeployResponse = null;
        credentialInputs.Clear();
        selectedTemplateDetail = null;
        templateDetailLoading = true;

        try
        {
            Logger.LogInformation("[DatabaseTemplates] Fetching template detail for id={TemplateId}...", template.Id);
            var response = await Http.GetAsync($"api/DatabaseTemplates/{template.Id}");
            Logger.LogInformation("[DatabaseTemplates] Template detail response: {StatusCode}", response.StatusCode);
            
            if (response.IsSuccessStatusCode)
            {
                selectedTemplateDetail = await response.Content.ReadFromJsonAsync<DatabaseTemplateDetailDto>();
                Logger.LogInformation("[DatabaseTemplates] Template detail loaded: {Name}, {EnvCount} env vars", 
                    selectedTemplateDetail?.Name, selectedTemplateDetail?.EnvironmentVariables?.Count ?? 0);
                PrepareCredentialInputs();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Logger.LogError("[DatabaseTemplates] Failed to load template detail: {StatusCode} - {Error}", response.StatusCode, errorContent);
                deployError = $"Failed to load template details: {response.StatusCode}. {errorContent}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[DatabaseTemplates] Exception loading template detail {TemplateId}: {Message}", template.Id, ex.Message);
            deployError = $"Unable to load template hardening defaults: {ex.Message}";
        }
        finally
        {
            templateDetailLoading = false;
        }
    }

    private int DetermineProjectSelection()
    {
        if (projectIdFromQuery.HasValue)
        {
            var match = projects.FirstOrDefault(p => p.Id == projectIdFromQuery.Value);
            if (match != null)
            {
                projectContextName = match.Name;
                return match.Id;
            }
        }

        return selectedProjectId != 0 ? selectedProjectId : projects.FirstOrDefault()?.Id ?? 0;
    }

    private void ClearProjectContext()
    {
        projectIdFromQuery = null;
        projectContextName = null;
        selectedProjectId = projects.FirstOrDefault()?.Id ?? 0;
        Navigation.NavigateTo("/databases/templates", forceLoad: true);
    }

    private void ReadProjectContextFromQuery()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (string.IsNullOrEmpty(uri.Query))
        {
            projectIdFromQuery = null;
            return;
        }

        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("projectId", out var values) && int.TryParse(values.FirstOrDefault(), out var parsed))
        {
            projectIdFromQuery = parsed;
        }
    }

    private void CloseDeployModal()
    {
        showDeployModal = false;
        selectedTemplate = null;
        selectedTemplateDetail = null;
        credentialInputs.Clear();
        templateDetailLoading = false;
        lastDeployResponse = null;
        dockerImageInput = string.Empty;
    }

    private void GoToApplicationsAfterSuccess()
    {
        CloseDeployModal();
        Navigation.NavigateTo("/applications", forceLoad: true);
    }

    private void OnDatabaseNameChanged(ChangeEventArgs args)
    {
        databaseName = args.Value?.ToString()?.Trim() ?? string.Empty;
        SyncNameDerivedCredentials();
    }

    private void PrepareCredentialInputs()
    {
        credentialInputs.Clear();

        if (selectedTemplateDetail?.EnvironmentVariables == null)
        {
            return;
        }

        foreach (var definition in selectedTemplateDetail.EnvironmentVariables)
        {
            var input = new EnvironmentVariableInputModel
            {
                Key = definition.Key,
                Label = definition.Label,
                Description = definition.Description,
                IsSecret = definition.IsSecret,
                IsRequired = definition.IsRequired,
                Strategy = definition.Strategy,
                DefaultValue = definition.DefaultValue,
                SuggestedValue = definition.SuggestedValue,
                Length = definition.Length,
                Prefix = definition.Prefix,
                Suffix = definition.Suffix,
                DisplayInWizard = definition.DisplayInWizard
            };

            input.Value = GenerateDefaultValue(input);
            credentialInputs.Add(input);
        }

        SyncNameDerivedCredentials(force: true);
    }

    private void OnCredentialValueChanged(EnvironmentVariableInputModel variable, string? value)
    {
        variable.Value = value?.Trim() ?? string.Empty;
        variable.UserModified = true;
    }

    private void ToggleSecretVisibility(EnvironmentVariableInputModel variable)
    {
        variable.RevealSecret = !variable.RevealSecret;
    }

    private void RegenerateCredential(EnvironmentVariableInputModel variable)
    {
        variable.UserModified = false;
        variable.Value = GenerateDefaultValue(variable);
        if (StrategyEquals(variable, "ApplicationSlug"))
        {
            SyncNameDerivedCredentials(force: true);
        }
    }

    private void SyncNameDerivedCredentials(bool force = false)
    {
        foreach (var variable in credentialInputs.Where(v => StrategyEquals(v, "ApplicationSlug")))
        {
            if (!variable.UserModified || force)
            {
                variable.Value = BuildSlugValue(variable);
                if (force)
                {
                    variable.UserModified = false;
                }
            }
        }
    }

    private string GenerateDefaultValue(EnvironmentVariableInputModel variable)
    {
        if (StrategyEquals(variable, "ApplicationSlug"))
        {
            return BuildSlugValue(variable);
        }

        if (StrategyEquals(variable, "RandomSecure"))
        {
            return GenerateSecretValue(variable.Length ?? 32, includeSymbols: false);
        }

        if (StrategyEquals(variable, "RandomSecureWithSymbols"))
        {
            return GenerateSecretValue(variable.Length ?? 48, includeSymbols: true);
        }

        if (StrategyEquals(variable, "Literal"))
        {
            return variable.DefaultValue ?? variable.SuggestedValue ?? string.Empty;
        }

        return variable.SuggestedValue ?? variable.DefaultValue ?? string.Empty;
    }

    private string BuildSlugValue(EnvironmentVariableInputModel variable)
    {
        var seed = string.IsNullOrWhiteSpace(databaseName)
            ? selectedTemplate?.Name ?? variable.Key
            : databaseName;

        var slug = Slugify(seed, variable.Length ?? 32);
        var prefix = variable.Prefix ?? string.Empty;
        var suffix = variable.Suffix ?? string.Empty;
        return string.Concat(prefix, slug, suffix);
    }

    private static string Slugify(string value, int maxLength)
    {
        if (maxLength <= 0)
        {
            maxLength = 32;
        }

        var builder = new StringBuilder(value.Length);
        char previous = '\0';

        foreach (var character in value.ToLowerInvariant())
        {
            if (char.IsLetterOrDigit(character))
            {
                builder.Append(character);
                previous = character;
            }
            else if (previous != '-')
            {
                builder.Append('-');
                previous = '-';
            }
        }

        var slug = builder.ToString().Trim('-');
        if (string.IsNullOrWhiteSpace(slug))
        {
            slug = "hostcraft-db";
        }

        if (slug.Length > maxLength)
        {
            slug = slug[..maxLength];
        }

        return slug;
    }

    private static string GenerateSecretValue(int length, bool includeSymbols)
    {
        if (length <= 0)
        {
            length = 32;
        }

        const string baseChars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
        const string symbolChars = "!@#$%^&*()-_=+[]{}:?";
        var charset = includeSymbols ? baseChars + symbolChars : baseChars;
        Span<byte> buffer = stackalloc byte[length];
        RandomNumberGenerator.Fill(buffer);
        var chars = new char[length];

        for (int i = 0; i < length; i++)
        {
            chars[i] = charset[buffer[i] % charset.Length];
        }

        return new string(chars);
    }

    private static bool StrategyEquals(EnvironmentVariableInputModel variable, string strategy)
    {
        return string.Equals(variable.Strategy, strategy, StringComparison.OrdinalIgnoreCase);
    }

    private void AddEnvVar()
    {
        envVarKeys.Add("");
        envVarValues.Add("");
    }

    private void RemoveEnvVar(int index)
    {
        envVarKeys.RemoveAt(index);
        envVarValues.RemoveAt(index);
    }

    private async Task DeployDatabase()
    {
        if (lastDeployResponse != null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(databaseName))
        {
            deployError = "Database name is required";
            return;
        }

        if (selectedServerId == 0)
        {
            deployError = "Please select a server";
            return;
        }

        if (selectedProjectId == 0)
        {
            deployError = "Please select a project";
            return;
        }

        if (templateDetailLoading)
        {
            deployError = "Template safeguards are still loading. Please wait.";
            return;
        }

        if (credentialInputs.Count == 0)
        {
            deployError = "Credential defaults are unavailable. Close and reopen the modal.";
            return;
        }

        foreach (var variable in credentialInputs.Where(v => v.IsRequired))
        {
            if (string.IsNullOrWhiteSpace(variable.Value))
            {
                deployError = $"{variable.Label} is required";
                return;
            }
        }

        deploying = true;
        deployError = null;
        lastDeployResponse = null;

        try
        {
            var envVars = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

            foreach (var variable in credentialInputs)
            {
                if (!string.IsNullOrWhiteSpace(variable.Key) && !string.IsNullOrWhiteSpace(variable.Value))
                {
                    envVars[variable.Key] = variable.Value;
                }
            }

            for (int i = 0; i < envVarKeys.Count; i++)
            {
                if (!string.IsNullOrWhiteSpace(envVarKeys[i]))
                {
                    envVars[envVarKeys[i]] = envVarValues[i];
                }
            }

            var request = new
            {
                Name = databaseName,
                ServerId = selectedServerId,
                ProjectId = selectedProjectId,
                DockerImage = string.IsNullOrWhiteSpace(dockerImageInput) ? selectedTemplate!.DockerImage : dockerImageInput.Trim(),
                EnvironmentVariables = envVars,
                MemoryLimitMB = memoryLimitMB,
                CpuLimitCores = cpuLimitCores
            };

            var response = await PostDeployWithRefreshAsync(selectedTemplate!.Id, request);

            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                deployError = "Session expired. Please log in again.";
                return;
            }

            if (response.IsSuccessStatusCode)
            {
                lastDeployResponse = await response.Content.ReadFromJsonAsync<DeployDatabaseResponseDto>();
                if (lastDeployResponse == null)
                {
                    deployError = "Deployment completed but credentials could not be loaded.";
                }
            }
            else
            {
                var rawError = await response.Content.ReadAsStringAsync();
                ErrorResponse? errorResponse = null;

                if (!string.IsNullOrWhiteSpace(rawError))
                {
                    try
                    {
                        errorResponse = JsonSerializer.Deserialize<ErrorResponse>(rawError, new JsonSerializerOptions
                        {
                            PropertyNameCaseInsensitive = true
                        });
                    }
                    catch (JsonException ex)
                    {
                        Logger.LogWarning(ex, "Failed to parse deployment error payload: {Payload}", rawError);
                    }
                }

                deployError = errorResponse?.Error
                    ?? (!string.IsNullOrWhiteSpace(rawError) ? rawError.Trim() : $"Deployment failed with status {response.StatusCode}");
                Logger.LogError("Failed to deploy database: {Error}", deployError);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deploying database");
            deployError = $"An error occurred: {ex.Message}";
        }
        finally
        {
            deploying = false;
        }
    }

    private async Task<HttpResponseMessage> PostDeployWithRefreshAsync(int templateId, object request)
    {
        var response = await Http.PostAsJsonAsync($"api/DatabaseTemplates/{templateId}/deploy", request);

        if (response.StatusCode != HttpStatusCode.Unauthorized)
        {
            return response;
        }

        Logger.LogWarning("Deploy request for template {TemplateId} returned 401; attempting token refresh", templateId);

        var refresh = await AuthService.RefreshTokenAsync();
        if (refresh.Success && !string.IsNullOrEmpty(refresh.Token))
        {
            response.Dispose();
            return await Http.PostAsJsonAsync($"api/DatabaseTemplates/{templateId}/deploy", request);
        }

        Logger.LogWarning("Token refresh failed for deploy request; keeping 401 response");
        return response;
    }

