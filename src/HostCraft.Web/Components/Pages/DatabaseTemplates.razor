    {
        public string Key { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public bool IsSecret { get; set; }
        public bool IsRequired { get; set; }
        public string Strategy { get; set; } = string.Empty;
        public string? DefaultValue { get; set; }
        public string? SuggestedValue { get; set; }
        public int? Length { get; set; }
        public string? Prefix { get; set; }
        public string? Suffix { get; set; }
        public bool DisplayInWizard { get; set; } = true;
    }

    private class ServerDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public ServerType Type { get; set; }
    }

    private class ProjectDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
    }
    private class ErrorResponse
    {
        public string? Error { get; set; }
    }

    private class DeployDatabaseResponseDto
    {
        public int ApplicationId { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Message { get; set; } = string.Empty;
        public DateTime DeployedAt { get; set; }
        public int? PublishedPort { get; set; }
        public string? DockerImage { get; set; }
        public List<ResolvedEnvironmentVariableDto> EnvironmentVariables { get; set; } = new();
    }

    private class ResolvedEnvironmentVariableDto
    {
        public string Key { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
        public string Value { get; set; } = string.Empty;
        public bool IsSecret { get; set; }
        public bool IsUserProvided { get; set; }
        public string Description { get; set; } = string.Empty;
        public bool DisplayInWizard { get; set; }
    }

    private class EnvironmentVariableInputModel
    {
        public string Key { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public bool IsSecret { get; set; }
        public bool IsRequired { get; set; }
        public string Strategy { get; set; } = string.Empty;
        public string? DefaultValue { get; set; }
        public string? SuggestedValue { get; set; }
        public int? Length { get; set; }
        public string? Prefix { get; set; }
        public string? Suffix { get; set; }
        public bool DisplayInWizard { get; set; } = true;
        public string Value { get; set; } = string.Empty;
        public bool RevealSecret { get; set; }
        public bool UserModified { get; set; }
    }
