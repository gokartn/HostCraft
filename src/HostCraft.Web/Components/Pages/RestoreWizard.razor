@page "/backups/restore/{BackupId:int}"
@rendermode InteractiveServer
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject ILogger<RestoreWizard> Logger
@using System.Text.Json
@using Microsoft.JSInterop

<PageTitle>Restore Backup #{BackupId} - HostCraft</PageTitle>

<div class="restore-wizard-page">
    <section class="wizard-header">
        <button class="btn-back" @onclick="GoBack">
            <span>←</span> Back to Backups
        </button>
        <div class="header-info">
            <h1>Restore Backup #{BackupId}</h1>
            <p class="subtitle">Follow the wizard to safely restore your HostCraft instance</p>
        </div>
    </section>

    <!-- Progress Indicator -->
    <div class="wizard-progress">
        @for (int i = 0; i < steps.Count; i++)
        {
            var step = steps[i];
            var stepNum = i + 1;
            var isCurrent = currentStep == stepNum;
            var isComplete = stepNum < currentStep;
            var cssClass = isCurrent ? "active" : isComplete ? "completed" : "";

            <div class="progress-step @cssClass">
                <div class="step-number">
                    @if (isComplete)
                    {
                        <span>✓</span>
                    }
                    else
                    {
                        <span>@stepNum</span>
                    }
                </div>
                <div class="step-label">@step</div>
            </div>

            @if (i < steps.Count - 1)
            {
                <div class="progress-line @(isComplete ? "completed" : "")"></div>
            }
        }
    </div>

    @if (loading)
    {
        <div class="wizard-loading">
            <div class="spinner"></div>
            <p>@loadingMessage</p>
        </div>
    }
    else if (error != null)
    {
        <div class="wizard-error">
            <span class="icon">❌</span>
            <div>
                <strong>Error</strong>
                <p>@error</p>
            </div>
            <button class="btn btn-secondary" @onclick="RetryAnalysis">Retry</button>
        </div>
    }
    else
    {
        <!-- Step 1: Analyze Backup -->
        @if (currentStep == 1)
        {
            <div class="wizard-step">
                <h2>Step 1: Backup Analysis</h2>
                <p>Analyzing backup contents and requirements...</p>

                @if (requirements != null && backup != null)
                {
                    <div class="analysis-result">
                        <div class="info-card">
                            <h3>Backup Information</h3>
                            <div class="info-grid">
                                <div class="info-item">
                                    <span class="label">Created:</span>
                                    <span class="value">@backup.StartedAt.ToString("g")</span>
                                </div>
                                <div class="info-item">
                                    <span class="label">Size:</span>
                                    <span class="value">@FormatBytes(backup.SizeBytes)</span>
                                </div>
                                <div class="info-item">
                                    <span class="label">Scope:</span>
                                    <span class="value">@backup.Scope</span>
                                </div>
                                <div class="info-item">
                                    <span class="label">Projects:</span>
                                    <span class="value">@backup.ProjectCount</span>
                                </div>
                                <div class="info-item">
                                    <span class="label">Applications:</span>
                                    <span class="value">@backup.ApplicationCount</span>
                                </div>
                                <div class="info-item">
                                    <span class="label">Servers:</span>
                                    <span class="value">@backup.ServerCount</span>
                                </div>
                            </div>
                        </div>

                        @if (requirements.ServerInputs.Any())
                        {
                            <div class="alert alert-info">
                                <strong>⚠️ Server Configuration Required</strong>
                                <p>This backup contains @requirements.ServerInputs.Count server(s) that need new connection details.</p>
                            </div>
                        }

                        @if (requirements.DomainInputs.Any())
                        {
                            <div class="alert alert-warning">
                                <strong>🌐 Domain Remapping Available</strong>
                                <p>This backup uses @requirements.DomainInputs.Count domain(s) that you may want to remap.</p>
                            </div>
                        }

                        @if (!requirements.ServerInputs.Any() && !requirements.DomainInputs.Any())
                        {
                            <div class="alert alert-success">
                                <strong>✓ Ready to Restore</strong>
                                <p>No server configuration required. You can proceed directly to restore.</p>
                            </div>
                        }
                    </div>

                    <div class="wizard-actions">
                        <button class="btn btn-secondary" @onclick="GoBack">Cancel</button>
                        <button class="btn btn-primary" @onclick="NextStep">
                            Continue <span>→</span>
                        </button>
                    </div>
                }
            </div>
        }

        <!-- Step 2: Server Mapping -->
        @if (currentStep == 2)
        {
            <div class="wizard-step">
                <h2>Step 2: Server Configuration</h2>
                <p>Provide new connection details for servers from the backup</p>

                @if (requirements!.ServerInputs.Any())
                {
                    @foreach (var serverInput in requirements.ServerInputs)
                    {
                        <div class="server-mapping-card">
                            <div class="card-header">
                                <h3>Server: @serverInput.OriginalHostname</h3>
                                <p class="hint">@serverInput.Prompt</p>
                            </div>

                            <div class="form-grid">
                                <div class="form-group">
                                    <label>New Hostname / IP *</label>
                                    <input type="text"
                                           class="form-control"
                                           @bind="GetOrCreateServerMapping(serverInput.OriginalServerId).NewHostname"
                                           placeholder="e.g., 203.0.113.5 or server.example.com" />
                                    <small>SSH hostname or IP address for the new server</small>
                                </div>

                                <div class="form-group">
                                    <label>SSH Port</label>
                                    <input type="number"
                                           class="form-control"
                                           @bind="GetOrCreateServerMapping(serverInput.OriginalServerId).NewSshPort"
                                           placeholder="22" />
                                </div>

                                <div class="form-group">
                                    <label>SSH Username</label>
                                    <input type="text"
                                           class="form-control"
                                           @bind="GetOrCreateServerMapping(serverInput.OriginalServerId).NewSshUsername"
                                           placeholder="root" />
                                </div>

                                <div class="form-group">
                                    <label>Public IP (Optional)</label>
                                    <input type="text"
                                           class="form-control"
                                           @bind="GetOrCreateServerMapping(serverInput.OriginalServerId).NewPublicIp"
                                           placeholder="For Swarm advertise address" />
                                    <small>Required for Docker Swarm setups</small>
                                </div>
                            </div>

                            <div class="server-options">
                                <label class="checkbox-label">
                                    <input type="checkbox"
                                           @bind="GetOrCreateServerMapping(serverInput.OriginalServerId).Skip" />
                                    <span>Skip this server during restore</span>
                                </label>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info">
                        <p>No server configuration required. Click Next to continue.</p>
                    </div>
                }

                <div class="wizard-actions">
                    <button class="btn btn-secondary" @onclick="PreviousStep">
                        <span>←</span> Back
                    </button>
                    <button class="btn btn-primary" @onclick="NextStep">
                        Continue <span>→</span>
                    </button>
                </div>
            </div>
        }

        <!-- Step 3: Domain Mapping -->
        @if (currentStep == 3)
        {
            <div class="wizard-step">
                <h2>Step 3: Domain Remapping (Optional)</h2>
                <p>Map old domains to new domains if deploying to a different environment</p>

                @if (requirements!.DomainInputs.Any())
                {
                    @foreach (var domainInput in requirements.DomainInputs)
                    {
                        <div class="domain-mapping-card">
                            <div class="card-header">
                                <h3>@domainInput.OriginalDomain</h3>
                                <p class="hint">Used by: @domainInput.UsedByApplications</p>
                            </div>

                            <div class="form-group">
                                <label>New Domain</label>
                                <input type="text"
                                       class="form-control"
                                       value="@GetDomainMapping(domainInput.OriginalDomain)"
                                       @oninput="@(e => UpdateDomainMapping(domainInput.OriginalDomain, e.Value?.ToString() ?? ""))"
                                       placeholder="@domainInput.OriginalDomain (leave empty to keep same)" />
                                <small>Leave empty to use the original domain</small>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info">
                        <p>No domain remapping needed. Click Next to continue.</p>
                    </div>
                }

                <div class="wizard-actions">
                    <button class="btn btn-secondary" @onclick="PreviousStep">
                        <span>←</span> Back
                    </button>
                    <button class="btn btn-primary" @onclick="NextStep">
                        Continue <span>→</span>
                    </button>
                </div>
            </div>
        }

        <!-- Step 4: Restore Options -->
        @if (currentStep == 4)
        {
            <div class="wizard-step">
                <h2>Step 4: Restore Options</h2>
                <p>Choose what to restore and how to handle conflicts</p>

                <div class="options-section">
                    <h3>Restore Scope</h3>
                    <p class="section-hint">Select what components to restore from the backup</p>

                    <div class="scope-options">
                        <label class="checkbox-label">
                            <input type="checkbox"
                                   checked="@restoreScope.HasFlag(BackupScope.SystemConfiguration)"
                                   @onchange="(e) => ToggleScope(BackupScope.SystemConfiguration, (bool)e.Value!)" />
                            <span>System Configuration</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox"
                                   checked="@restoreScope.HasFlag(BackupScope.Servers)"
                                   @onchange="(e) => ToggleScope(BackupScope.Servers, (bool)e.Value!)" />
                            <span>Servers</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox"
                                   checked="@restoreScope.HasFlag(BackupScope.ApplicationConfigurations)"
                                   @onchange="(e) => ToggleScope(BackupScope.ApplicationConfigurations, (bool)e.Value!)" />
                            <span>Application Configurations</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox"
                                   checked="@restoreScope.HasFlag(BackupScope.Certificates)"
                                   @onchange="(e) => ToggleScope(BackupScope.Certificates, (bool)e.Value!)" />
                            <span>SSL Certificates</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox"
                                   checked="@restoreScope.HasFlag(BackupScope.GitIntegrations)"
                                   @onchange="(e) => ToggleScope(BackupScope.GitIntegrations, (bool)e.Value!)" />
                            <span>Git Integrations</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox"
                                   checked="@restoreScope.HasFlag(BackupScope.DeploymentHistory)"
                                   @onchange="(e) => ToggleScope(BackupScope.DeploymentHistory, (bool)e.Value!)" />
                            <span>Deployment History</span>
                        </label>
                    </div>
                </div>

                <div class="options-section">
                    <h3>Conflict Resolution Strategy</h3>
                    <p class="section-hint">How should existing data be handled?</p>

                    <div class="radio-group">
                        <label class="radio-label">
                            <input type="radio"
                                   name="strategy"
                                   checked="@(restoreStrategy == RestoreStrategy.FailOnConflict)"
                                   @onchange="() => restoreStrategy = RestoreStrategy.FailOnConflict" />
                            <div>
                                <strong>Fail on Conflict</strong>
                                <p>Stop restore if any existing data conflicts (safest)</p>
                            </div>
                        </label>
                        <label class="radio-label">
                            <input type="radio"
                                   name="strategy"
                                   checked="@(restoreStrategy == RestoreStrategy.SkipExisting)"
                                   @onchange="() => restoreStrategy = RestoreStrategy.SkipExisting" />
                            <div>
                                <strong>Skip Existing</strong>
                                <p>Keep existing data, only restore what's missing</p>
                            </div>
                        </label>
                        <label class="radio-label">
                            <input type="radio"
                                   name="strategy"
                                   checked="@(restoreStrategy == RestoreStrategy.OverwriteExisting)"
                                   @onchange="() => restoreStrategy = RestoreStrategy.OverwriteExisting" />
                            <div>
                                <strong>Overwrite Existing</strong>
                                <p>Replace existing data with backup data (destructive)</p>
                            </div>
                        </label>
                        <label class="radio-label">
                            <input type="radio"
                                   name="strategy"
                                   checked="@(restoreStrategy == RestoreStrategy.Merge)"
                                   @onchange="() => restoreStrategy = RestoreStrategy.Merge" />
                            <div>
                                <strong>Merge</strong>
                                <p>Merge backup with existing data (advanced)</p>
                            </div>
                        </label>
                    </div>
                </div>

                <div class="options-section">
                    <h3>Advanced Options</h3>

                    <label class="checkbox-label">
                        <input type="checkbox" @bind="restoreMapping.RegenerateSecrets" />
                        <div>
                            <strong>Regenerate Secrets</strong>
                            <p>Generate new secrets for the restored environment (recommended)</p>
                        </div>
                    </label>

                    <label class="checkbox-label">
                        <input type="checkbox" @bind="restoreMapping.RegenerateCertificates" />
                        <div>
                            <strong>Regenerate SSL Certificates</strong>
                            <p>Re-issue SSL certificates for new domains/IPs</p>
                        </div>
                    </label>

                    <label class="checkbox-label">
                        <input type="checkbox" @bind="restoreMapping.PreserveUuids" />
                        <div>
                            <strong>Preserve UUIDs</strong>
                            <p>Keep original UUIDs (useful for migrations)</p>
                        </div>
                    </label>
                </div>

                <div class="wizard-actions">
                    <button class="btn btn-secondary" @onclick="PreviousStep">
                        <span>←</span> Back
                    </button>
                    <button class="btn btn-primary" @onclick="NextStep">
                        Review <span>→</span>
                    </button>
                </div>
            </div>
        }

        <!-- Step 5: Review & Execute -->
        @if (currentStep == 5)
        {
            <div class="wizard-step">
                <h2>Step 5: Review & Confirm</h2>
                <p>Review your restore configuration before proceeding</p>

                <div class="review-section">
                    <h3>Restore Summary</h3>

                    <div class="review-item">
                        <span class="review-label">Backup:</span>
                        <span class="review-value">#@BackupId (@backup!.Scope)</span>
                    </div>

                    <div class="review-item">
                        <span class="review-label">Strategy:</span>
                        <span class="review-value">@restoreStrategy</span>
                    </div>

                    <div class="review-item">
                        <span class="review-label">Scope:</span>
                        <span class="review-value">@restoreScope</span>
                    </div>

                    @if (restoreMapping.ServerMappings.Any())
                    {
                        <div class="review-item">
                            <span class="review-label">Servers:</span>
                            <span class="review-value">@restoreMapping.ServerMappings.Count server(s) mapped</span>
                        </div>
                    }

                    @if (restoreMapping.DomainMappings.Any())
                    {
                        <div class="review-item">
                            <span class="review-label">Domains:</span>
                            <span class="review-value">@restoreMapping.DomainMappings.Count domain(s) remapped</span>
                        </div>
                    }
                </div>

                <div class="alert alert-warning">
                    <strong>⚠️ Warning</strong>
                    <p>This restore operation will modify your HostCraft instance. Make sure you have a backup of your current state before proceeding.</p>
                </div>

                <div class="wizard-actions">
                    <button class="btn btn-secondary" @onclick="PreviousStep">
                        <span>←</span> Back
                    </button>
                    <button class="btn btn-danger" @onclick="ExecuteRestore" disabled="@executing">
                        @if (executing)
                        {
                            <span class="spinner-small"></span>
                            <text>Restoring...</text>
                        }
                        else
                        {
                            <text>Execute Restore</text>
                        }
                    </button>
                </div>
            </div>
        }

        <!-- Step 6: Restore Progress -->
        @if (currentStep == 6 && restoreOperation != null)
        {
            <div class="wizard-step">
                <h2>Step 6: Restore in Progress</h2>
                <p>Monitoring restore operation...</p>

                <div class="restore-progress-card">
                    <div class="progress-header">
                        <h3>Restore Operation #@restoreOperation.Id</h3>
                        <span class="status-pill @restoreOperation.Status.ToLower()">@restoreOperation.Status</span>
                    </div>

                    <div class="progress-stats">
                        <div class="stat-item">
                            <span class="stat-value">@restoreOperation.ProjectsRestored</span>
                            <span class="stat-label">Projects</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-value">@restoreOperation.ApplicationsRestored</span>
                            <span class="stat-label">Applications</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-value">@restoreOperation.ServersRestored</span>
                            <span class="stat-label">Servers</span>
                        </div>
                    </div>

                    @if (restoreOperation.Status == "Running")
                    {
                        <div class="loading-bar">
                            <div class="loading-bar-fill"></div>
                        </div>
                        <p class="progress-message">Restore in progress... This may take several minutes.</p>
                    }
                    else if (restoreOperation.Status == "Completed")
                    {
                        <div class="alert alert-success">
                            <strong>✓ Restore Completed Successfully</strong>
                            <p>Your HostCraft instance has been restored from backup #@BackupId</p>
                        </div>
                    }
                    else if (restoreOperation.Status == "Failed")
                    {
                        <div class="alert alert-error">
                            <strong>✗ Restore Failed</strong>
                            <p>@restoreOperation.ErrorMessage</p>
                        </div>
                    }
                </div>

                <div class="wizard-actions">
                    @if (restoreOperation.Status == "Completed" || restoreOperation.Status == "Failed")
                    {
                        <button class="btn btn-primary" @onclick="@(() => NavigationManager.NavigateTo("/backups/history"))">
                            Return to Backup History
                        </button>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public int BackupId { get; set; }

    private List<string> steps = new() { "Analyze", "Servers", "Domains", "Options", "Review", "Restore" };
    private int currentStep = 1;

    private bool loading = true;
    private bool executing = false;
    private string loadingMessage = "Loading backup information...";
    private string? error = null;

    private BackupDto? backup;
    private RestoreRequiredInput? requirements;
    private RestoreMapping restoreMapping = new();
    private BackupScope restoreScope = BackupScope.Complete;
    private RestoreStrategy restoreStrategy = RestoreStrategy.FailOnConflict;
    private RestoreOperationDto? restoreOperation;

    private Dictionary<string, string> tempDomainMappings = new();

    // Enums for UI
    [Flags]
    private enum BackupScope
    {
        None = 0,
        SystemConfiguration = 1,
        Servers = 2,
        ApplicationConfigurations = 4,
        ApplicationData = 8,
        DatabaseData = 16,
        DockerNetworks = 32,
        Certificates = 64,
        GitIntegrations = 128,
        Secrets = 256,
        DeploymentHistory = 512,
        Complete = SystemConfiguration | Servers | ApplicationConfigurations | ApplicationData |
                   DatabaseData | DockerNetworks | Certificates | GitIntegrations | Secrets | DeploymentHistory
    }

    private enum RestoreStrategy
    {
        FailOnConflict,
        SkipExisting,
        OverwriteExisting,
        Merge
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadBackupAndAnalyze();
    }

    private async Task LoadBackupAndAnalyze()
    {
        loading = true;
        loadingMessage = "Analyzing backup...";
        error = null;

        try
        {
            // Get backup details
            var backupResponse = await Http.GetAsync($"api/Backups/{BackupId}");
            if (!backupResponse.IsSuccessStatusCode)
            {
                error = "Failed to load backup details";
                return;
            }
            backup = await backupResponse.Content.ReadFromJsonAsync<BackupDto>();

            // Analyze restore requirements
            var requirementsResponse = await Http.GetAsync($"api/Backups/{BackupId}/restore/analyze");
            if (!requirementsResponse.IsSuccessStatusCode)
            {
                error = "Failed to analyze backup requirements";
                return;
            }
            requirements = await requirementsResponse.Content.ReadFromJsonAsync<RestoreRequiredInput>();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading backup");
            error = $"Error: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task RetryAnalysis()
    {
        await LoadBackupAndAnalyze();
    }

    private void NextStep()
    {
        currentStep++;
        StateHasChanged();
    }

    private void PreviousStep()
    {
        currentStep--;
        StateHasChanged();
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/backups/history");
    }

    private ServerRestoreMapping GetOrCreateServerMapping(int originalServerId)
    {
        if (!restoreMapping.ServerMappings.ContainsKey(originalServerId))
        {
            restoreMapping.ServerMappings[originalServerId] = new ServerRestoreMapping
            {
                OriginalServerId = originalServerId,
                NewSshPort = 22,
                NewSshUsername = "root"
            };
        }
        return restoreMapping.ServerMappings[originalServerId];
    }

    private string GetDomainMapping(string originalDomain)
    {
        tempDomainMappings.TryGetValue(originalDomain, out var mapped);
        return mapped ?? "";
    }

    private void UpdateDomainMapping(string originalDomain, string newDomain)
    {
        // Store in temp dictionary for UI binding
        tempDomainMappings[originalDomain] = newDomain;

        // Update actual restore mapping
        if (!string.IsNullOrWhiteSpace(newDomain) && newDomain != originalDomain)
        {
            restoreMapping.DomainMappings[originalDomain] = newDomain;
        }
        else
        {
            restoreMapping.DomainMappings.Remove(originalDomain);
        }
    }

    private void ToggleScope(BackupScope scope, bool enabled)
    {
        if (enabled)
        {
            restoreScope |= scope;
        }
        else
        {
            restoreScope &= ~scope;
        }
    }

    private async Task ExecuteRestore()
    {
        executing = true;

        try
        {
            var request = new
            {
                RestoreScope = restoreScope.ToString(),
                Strategy = restoreStrategy.ToString(),
                Mapping = restoreMapping
            };

            var response = await Http.PostAsJsonAsync($"api/Backups/{BackupId}/restore", request);
            if (!response.IsSuccessStatusCode)
            {
                error = $"Restore failed: {await response.Content.ReadAsStringAsync()}";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<RestoreOperationResponse>();
            if (result != null)
            {
                restoreOperation = new RestoreOperationDto
                {
                    Id = result.RestoreOperationId,
                    Status = result.Status
                };

                currentStep = 6;
                await MonitorRestoreProgress(result.RestoreOperationId);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error executing restore");
            error = $"Error: {ex.Message}";
        }
        finally
        {
            executing = false;
        }
    }

    private async Task MonitorRestoreProgress(int restoreOperationId)
    {
        while (restoreOperation!.Status == "Running")
        {
            await Task.Delay(2000); // Poll every 2 seconds

            try
            {
                var response = await Http.GetAsync($"api/Backups/restore/{restoreOperationId}");
                if (response.IsSuccessStatusCode)
                {
                    restoreOperation = await response.Content.ReadFromJsonAsync<RestoreOperationDto>();
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error monitoring restore");
                break;
            }
        }
    }

    private string FormatBytes(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    private class BackupDto
    {
        public int Id { get; set; }
        public string Scope { get; set; } = "";
        public long SizeBytes { get; set; }
        public int ProjectCount { get; set; }
        public int ApplicationCount { get; set; }
        public int ServerCount { get; set; }
        public DateTime StartedAt { get; set; }
    }

    private class RestoreRequiredInput
    {
        public List<ServerInputRequired> ServerInputs { get; set; } = new();
        public List<DomainInputRequired> DomainInputs { get; set; } = new();
        public List<IpAddressInputRequired> IpAddressInputs { get; set; } = new();
    }

    private class ServerInputRequired
    {
        public int OriginalServerId { get; set; }
        public string OriginalHostname { get; set; } = "";
        public string OriginalIpAddress { get; set; } = "";
        public string Prompt { get; set; } = "";
    }

    private class DomainInputRequired
    {
        public string OriginalDomain { get; set; } = "";
        public string UsedByApplications { get; set; } = "";
        public string Prompt { get; set; } = "";
    }

    private class IpAddressInputRequired
    {
        public string OriginalIpAddress { get; set; } = "";
        public string UsedBy { get; set; } = "";
        public string Prompt { get; set; } = "";
    }

    private class RestoreMapping
    {
        public Dictionary<int, ServerRestoreMapping> ServerMappings { get; set; } = new();
