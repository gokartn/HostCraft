@code {
    [Parameter]
    public int Id { get; set; }

    private ApplicationWithDeploymentsDto? app;
    private bool isLoading = true;
    private bool isRedeploying = false;
    private bool isDeleting = false;
    private bool isScaling = false;
    private int scaleReplicas = 1;
    private string activeTab = "General";
    private string? scaleError;
    private string? scaleSuccess;
    private readonly HashSet<string> revealedKeys = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, bool> secretOverrides = new(StringComparer.OrdinalIgnoreCase);
    private string? copyMessage;
    private CancellationTokenSource? copyMessageCts;

    // Traefik advanced config state
    private TraefikPreviewResponse? traefikPreview;
    private string overridesInput = string.Empty;
    private bool isPreviewLoading;
    private bool isSavingOverrides;
    private string? previewError;
    private List<string> previewWarnings = new();

    // Build logs state
    private DeploymentInfo? selectedDeployment;
    private DeploymentInfo? activeDeployment;
    private List<DeploymentLogDto> buildLogs = new();
    private int lastLogId = 0;
    private System.Timers.Timer? logPollingTimer;

    // Runtime monitoring state
    private ApplicationMetricsDto? runtimeMetrics;
    private bool isMetricsLoading;
    private string? metricsError;
    private bool metricsStreamingEnabled = true;
    private System.Timers.Timer? metricsTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadApplication();
        CheckForActiveDeployment();
        if (HasRuntimeTarget())
        {
            StartMetricsPolling();
        }
    }

    protected override void OnParametersSet()
    {
        SyncActiveTabWithFragment();
    }

    private void CheckForActiveDeployment()
    {
        // Find any running or queued deployment
        activeDeployment = app?.Deployments?.FirstOrDefault(d =>
            d.Status == DeploymentStatus.Running || d.Status == DeploymentStatus.Queued);

        if (activeDeployment != null)
        {
            StartLogPolling(activeDeployment.Id);
        }
    }

    private void StartLogPolling(int deploymentId)
    {
        StopLogPolling();
        lastLogId = 0;
        buildLogs.Clear();

        logPollingTimer = new System.Timers.Timer(1000); // Poll every second
        logPollingTimer.Elapsed += async (sender, e) => await PollBuildLogs(deploymentId);
        logPollingTimer.AutoReset = true;
        logPollingTimer.Start();

        // Initial fetch
        _ = PollBuildLogs(deploymentId);
    }

    private void StopLogPolling()
    {
        logPollingTimer?.Stop();
        logPollingTimer?.Dispose();
        logPollingTimer = null;
    }

    private async Task PollBuildLogs(int deploymentId)
    {
        try
        {
            // Fetch new logs
            var logs = await Http.GetFromJsonAsync<List<DeploymentLogDto>>($"api/deployments/{deploymentId}/logs?afterId={lastLogId}");
            if (logs != null && logs.Count > 0)
            {
                foreach (var log in logs)
                {
                    buildLogs.Add(log);
                    if (log.Id > lastLogId) lastLogId = log.Id;
                }
                await InvokeAsync(StateHasChanged);
            }

            // Check deployment status
            var status = await Http.GetFromJsonAsync<DeploymentStatusDto>($"api/deployments/{deploymentId}/status");
            if (status != null && (status.Status == "Success" || status.Status == "Failed" || status.Status == "Cancelled"))
            {
                StopLogPolling();
                await LoadApplication(); // Refresh the app state
                activeDeployment = null;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error polling build logs");
        }
    }

    private bool HasRuntimeTarget()
    {
        return !string.IsNullOrWhiteSpace(app?.ContainerId) || !string.IsNullOrWhiteSpace(app?.ServiceId);
    }

    private void StartMetricsPolling()
    {
        if (!metricsStreamingEnabled || !HasRuntimeTarget())
        {
            return;
        }

        StopMetricsPolling();

        metricsTimer = new System.Timers.Timer(2000);
        metricsTimer.Elapsed += async (_, _) => await LoadMetricsAsync();
        metricsTimer.AutoReset = true;
        metricsTimer.Start();

        _ = LoadMetricsAsync();
    }

    private void StopMetricsPolling()
    {
        metricsTimer?.Stop();
        metricsTimer?.Dispose();
        metricsTimer = null;
    }

    private async Task LoadMetricsAsync()
    {
        if (!metricsStreamingEnabled || isMetricsLoading)
        {
            return;
        }

        isMetricsLoading = true;

        try
        {
            var metrics = await Http.GetFromJsonAsync<ApplicationMetricsDto>($"api/applications/{Id}/metrics");
            if (metrics != null)
            {
                runtimeMetrics = metrics;
                metricsError = null;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            metricsError = "Live metrics temporarily unavailable";
            Logger.LogWarning(ex, "Failed to load runtime metrics for application {ApplicationId}", Id);
        }
        finally
        {
            isMetricsLoading = false;
        }
    }

    private async Task RefreshMetricsAsync()
    {
        await LoadMetricsAsync();
    }

    private void ToggleMetricsStreaming()
    {
        metricsStreamingEnabled = !metricsStreamingEnabled;
        if (metricsStreamingEnabled)
        {
            StartMetricsPolling();
        }
        else
        {
            StopMetricsPolling();
        }
    }

    private async Task SelectDeployment(DeploymentInfo deployment)
    {
        if (selectedDeployment?.Id == deployment.Id)
        {
            // Toggle off if clicking the same one
            ClearSelectedDeployment();
            return;
        }

        selectedDeployment = deployment;
        buildLogs.Clear();
        lastLogId = 0;

        // If it's an active deployment, start polling
        if (deployment.Status == DeploymentStatus.Running || deployment.Status == DeploymentStatus.Queued)
        {
            StartLogPolling(deployment.Id);
        }
        else
        {
            // Load all logs at once for completed deployments
            StopLogPolling();
            try
            {
                var logs = await Http.GetFromJsonAsync<List<DeploymentLogDto>>($"api/deployments/{deployment.Id}/logs");
                if (logs != null)
                {
                    buildLogs = logs;
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error loading deployment logs");
            }
        }
        StateHasChanged();
    }

    private void ClearSelectedDeployment()
    {
        selectedDeployment = null;
        if (activeDeployment == null)
        {
            StopLogPolling();
            buildLogs.Clear();
        }
        StateHasChanged();
    }

    private void BackToApplications()
    {
        if (app != null)
        {
            Navigation.NavigateTo($"/projects/{app.ProjectId}");
        }
        else
        {
            Navigation.NavigateTo("/projects");
        }
    }

    private void NavigateToGeneral()
    {
        activeTab = "General";
        Navigation.NavigateTo($"/applications/{Id}");
    }

    private void NavigateToEdit()
    {
        Navigation.NavigateTo($"/applications/{Id}/edit");
    }

    private void NavigateToDomains()
    {
        Navigation.NavigateTo($"/applications/{Id}/domains");
    }

    private void NavigateToAdvanced()
    {
        activeTab = "Advanced";
        Navigation.NavigateTo($"/applications/{Id}#traefik-advanced");
    }

    private void NavigateToLogs()
    {
        Navigation.NavigateTo($"/applications/{Id}/logs");
    }

    private void IncrementScale()
    {
        scaleReplicas = Math.Clamp(scaleReplicas + 1, 0, 100);
    }

    private void DecrementScale()
    {
        scaleReplicas = Math.Clamp(scaleReplicas - 1, 0, 100);
    }

    private void SyncActiveTabWithFragment()
    {
        var fragment = Navigation.ToAbsoluteUri(Navigation.Uri).Fragment;
        if (!string.IsNullOrWhiteSpace(fragment))
        {
            var frag = fragment.TrimStart('#');
            if (string.Equals(frag, "traefik-advanced", StringComparison.OrdinalIgnoreCase))
            {
                activeTab = "Advanced";
                return;
            }
        }

        activeTab = "General";
    }

    private bool CanScale()
    {
        return !string.IsNullOrWhiteSpace(app?.ServiceId);
    }

    private async Task ApplyScaleAsync()
    {
        if (app == null)
        {
            return;
        }

        if (!CanScale())
        {
            scaleError = "Scaling is only available for swarm services.";
            return;
        }

        isScaling = true;
        scaleError = null;
        scaleSuccess = null;
        StateHasChanged();

        try
        {
            var target = Math.Clamp(scaleReplicas, 0, 100);
            var response = await Http.PostAsync($"api/applications/{Id}/scale?replicas={target}", null);
            if (response.IsSuccessStatusCode)
            {
                scaleSuccess = $"Scaling to {target} replica{(target == 1 ? string.Empty : "s")} requested.";
                await LoadApplication();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                scaleError = string.IsNullOrWhiteSpace(err) ? "Failed to scale application." : err;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error scaling application {Id}", Id);
            scaleError = "Scaling failed. Check connection and try again.";
        }
        finally
        {
            isScaling = false;
            StateHasChanged();
        }
    }

    private async Task LoadApplication()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            app = await Http.GetFromJsonAsync<ApplicationWithDeploymentsDto>($"api/applications/{Id}");
            runtimeMetrics = null;
            scaleReplicas = Math.Max(0, app?.Replicas ?? 1);
            scaleError = null;
            scaleSuccess = null;
            overridesInput = app?.TraefikLabelOverrides ?? string.Empty;
            await LoadTraefikPreviewAsync(useEditorInput: false);
            if (metricsStreamingEnabled && HasRuntimeTarget())
            {
                StartMetricsPolling();
            }
            secretOverrides.Clear();
            revealedKeys.Clear();
            copyMessage = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading application");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task Redeploy()
    {
        isRedeploying = true;
        StateHasChanged();

        try
        {
            var response = await Http.PostAsync($"api/applications/{Id}/deploy", null);
            if (response.IsSuccessStatusCode)
            {
                // Some responses are empty (204). Only parse JSON when present.
                DeployResponse? result = null;
                var content = await response.Content.ReadAsStringAsync();
                if (!string.IsNullOrWhiteSpace(content))
                {
                    try
                    {
                        result = System.Text.Json.JsonSerializer.Deserialize<DeployResponse>(content);
                    }
                    catch (System.Text.Json.JsonException jsonEx)
                    {
                        Logger.LogWarning(jsonEx, "Deploy response was not valid JSON; proceeding without id");
                    }
                }

                await Task.Delay(500);
                await LoadApplication();
                CheckForActiveDeployment();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error redeploying application");
        }
        finally
        {
            isRedeploying = false;
            StateHasChanged();
        }
    }

