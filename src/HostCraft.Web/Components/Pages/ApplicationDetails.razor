    private async Task LoadTraefikPreviewAsync(bool useEditorInput)
    {
        if (app == null)
        {
            return;
        }

        isPreviewLoading = true;
        previewError = null;
        previewWarnings.Clear();
        StateHasChanged();

        try
        {
            HttpResponseMessage response;

            if (useEditorInput)
            {
                var payload = new TraefikOverridesRequest { Overrides = NormalizeOverridesInput(overridesInput) };
                response = await Http.PostAsJsonAsync($"api/applications/{Id}/traefik/preview", payload);
            }
            else
            {
                response = await Http.GetAsync($"api/applications/{Id}/traefik/preview");
            }

            if (response.IsSuccessStatusCode)
            {
                traefikPreview = await response.Content.ReadFromJsonAsync<TraefikPreviewResponse>();
                previewWarnings = traefikPreview?.Warnings ?? new List<string>();
            }
            else
            {
                previewError = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading Traefik preview");
            previewError = "Unable to load Traefik preview";
        }
        finally
        {
            isPreviewLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task PreviewOverridesAsync() => LoadTraefikPreviewAsync(useEditorInput: true);

    private async Task SaveOverridesAsync()
    {
        isSavingOverrides = true;
        previewError = null;
        StateHasChanged();

        try
        {
            var payload = new TraefikOverridesRequest { Overrides = NormalizeOverridesInput(overridesInput) };
            var response = await Http.PutAsJsonAsync($"api/applications/{Id}/traefik/overrides", payload);

            if (response.IsSuccessStatusCode)
            {
                await LoadApplication();
            }
            else
            {
                previewError = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving Traefik overrides");
            previewError = "Unable to save overrides";
        }
        finally
        {
            isSavingOverrides = false;
            await LoadTraefikPreviewAsync(useEditorInput: false);
        }
    }

