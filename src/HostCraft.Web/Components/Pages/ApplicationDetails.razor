    private bool TryBuildDatabaseCredentials(out DatabaseCredentialSummary summary)
    {
        summary = default!;
        if (app == null || app.SourceType != ApplicationSourceType.DatabaseTemplate || app.EnvironmentVariables == null)
        {
            return false;
        }

        var internalEntries = new List<CredentialEntry>();
        var externalEntries = new List<CredentialEntry>();
        var env = new Dictionary<string, string>(app.EnvironmentVariables, StringComparer.OrdinalIgnoreCase);

        var scheme = GetDatabaseScheme(app.DatabaseType);
        var internalHost = ResolveInternalHost(app);
        var internalPort = ResolveInternalPort(app);
        var externalHost = ResolveExternalHost(app);
        var externalPort = ResolveExternalPort(app, internalPort);

        var hints = ResolveDatabaseKeyHints(app.DatabaseType);
        var user = TryGetAny(env, hints.UserKeys);
        var password = TryGetAny(env, hints.PasswordKeys);
        var databaseName = TryGetAny(env, hints.DatabaseKeys);

        if (app.DatabaseType.HasValue)
        {
            foreach (var definition in DatabaseTemplateBestPractices.GetDefinitions(app.DatabaseType.Value))
            {
                if (!ShouldDisplayDefinition(definition))
                {
                    continue;
                }

                env.TryGetValue(definition.Key, out var value);
                AddCredentialEntry(internalEntries, definition.Label, definition.Key, value, definition.IsSecret, skipIfEmpty: false);
            }
        }

        AddCredentialEntry(internalEntries, "Internal Host", "__internal_host", internalHost, false);
        if (internalPort.HasValue)
        {
            AddCredentialEntry(internalEntries, "Internal Port", "__internal_port", internalPort.Value.ToString(), false);
        }

        var internalUrl = BuildConnectionString(scheme, internalHost, internalPort, user, password, databaseName);
        AddCredentialEntry(internalEntries, "Internal Connection URL", "__internal_connection_url", internalUrl, true);

        AddCredentialEntry(externalEntries, "External Host", "__external_host", externalHost, false);
        if (externalPort.HasValue)
        {
            AddCredentialEntry(externalEntries, "External Port", "__external_port", externalPort.Value.ToString(), false);
        }

        var externalUrl = BuildConnectionString(scheme, externalHost, externalPort, user, password, databaseName);
        AddCredentialEntry(externalEntries, "External Connection URL", "__external_connection_url", externalUrl, true);

        summary = new DatabaseCredentialSummary(internalEntries, externalEntries);
        return internalEntries.Any() || externalEntries.Any();
    }

    private void AddCredentialEntry(List<CredentialEntry> list, string label, string key, string? value, bool isSecret, bool skipIfEmpty = true)
    {
        if (skipIfEmpty && string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        var normalizedValue = value ?? string.Empty;
        SetExplicitSecretFlag(key, isSecret);
        list.Add(new CredentialEntry(label, key, normalizedValue, isSecret));
    }

    private static string ResolveInternalHost(ApplicationWithDeploymentsDto application)
    {
        return !string.IsNullOrWhiteSpace(application.ServiceName) ? application.ServiceName : NormalizeResourceName(application.Name);
    }

    private static int? ResolveInternalPort(ApplicationWithDeploymentsDto application)
    {
        if (application.Port.HasValue && application.Port > 0)
        {
            return application.Port;
        }

        var fallbackPort = GetDefaultDatabasePort(application.DatabaseType);
        return fallbackPort > 0 ? fallbackPort : null;
    }

    private static string? ResolveExternalHost(ApplicationWithDeploymentsDto application)
    {
        if (!string.IsNullOrWhiteSpace(application.Domain))
        {
            return application.Domain;
        }

        var additional = ExtractFirstAdditionalDomain(application.AdditionalDomains);
        if (!string.IsNullOrWhiteSpace(additional))
        {
            return additional;
        }

        return string.IsNullOrWhiteSpace(application.ServerHost) ? null : application.ServerHost;
    }

    private static int? ResolveExternalPort(ApplicationWithDeploymentsDto application, int? internalPort)
    {
        if (application.PublishedPort.HasValue && application.PublishedPort > 0)
        {
            return application.PublishedPort;
        }

        return internalPort;
    }

    private static string? ExtractFirstAdditionalDomain(string? additionalDomains)
    {
        if (string.IsNullOrWhiteSpace(additionalDomains))
        {
            return null;
        }

        var segments = additionalDomains
            .Split(new[] { ',', ';', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(static segment => segment.Trim())
            .Where(static segment => !string.IsNullOrWhiteSpace(segment));

        return segments.FirstOrDefault();
    }

    private static DatabaseKeyHints ResolveDatabaseKeyHints(DatabaseType? type)
    {
        if (type.HasValue && DatabaseKeyHintMap.TryGetValue(type.Value, out var hints))
        {
            return hints;
        }

        return GenericDatabaseKeyHints;
    }

    private static bool ShouldDisplayDefinition(TemplateEnvironmentVariableDefinition definition)
    {
        return definition.DisplayInWizard || definition.IsSecret;
    }

    private static string? TryGetAny(IReadOnlyDictionary<string, string> env, IReadOnlyList<string> keys)
    {
        foreach (var key in keys)
        {
            if (env.TryGetValue(key, out var value) && !string.IsNullOrWhiteSpace(value))
            {
                return value;
            }
        }

        return null;
    }

    private void SetExplicitSecretFlag(string key, bool isSecret)
    {
        secretOverrides[key] = isSecret;
    }

    private bool AllowReveal(string key)
    {
        if (secretOverrides.TryGetValue(key, out var explicitSecret))
        {
            return explicitSecret;
        }

        return LooksSensitiveKey(key);
    }

    private bool IsValueMasked(string key, string value)
    {
        if (!AllowReveal(key))
        {
            return false;
        }

        return !revealedKeys.Contains(key);
    }

    private string FormatDisplayValue(string key, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "(empty)";
        }

        return IsValueMasked(key, value) ? MaskValue(value) : value;
    }

    private static string MaskValue(string value)
    {
        var length = Math.Max(value.Length, 8);
        return new string('•', length);
    }

    private static bool LooksSensitiveKey(string key)
    {
        return key.Contains("PASSWORD", StringComparison.OrdinalIgnoreCase)
               || key.Contains("SECRET", StringComparison.OrdinalIgnoreCase)
               || key.Contains("TOKEN", StringComparison.OrdinalIgnoreCase)
               || key.Contains("KEY", StringComparison.OrdinalIgnoreCase);
    }

    private void ToggleSecret(string key)
    {
        if (!revealedKeys.Remove(key))
        {
            revealedKeys.Add(key);
        }
        StateHasChanged();
    }

    private async Task CopyValueAsync(string value, string label)
    {
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", value);
            await ShowCopyMessageAsync($"{label} copied to clipboard");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to copy value for {Label}", label);
            await ShowCopyMessageAsync("Copy failed");
        }
    }

    private async Task ShowCopyMessageAsync(string message)
    {
        var previousCts = copyMessageCts;
        previousCts?.Cancel();

        var cts = new CancellationTokenSource();
        copyMessageCts = cts;
        previousCts?.Dispose();
        copyMessage = message;
        await InvokeAsync(StateHasChanged);

        try
        {
            await Task.Delay(TimeSpan.FromSeconds(2), cts.Token);
            copyMessage = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
        }
        finally
        {
            if (ReferenceEquals(copyMessageCts, cts))
            {
                copyMessageCts = null;
            }
            cts.Dispose();
        }
    }

    private static string NormalizeResourceName(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "hostcraft-db";
        }

        var builder = new StringBuilder();
        char previous = '\0';
        foreach (var ch in name.ToLowerInvariant())
        {
            if (char.IsLetterOrDigit(ch))
            {
                builder.Append(ch);
                previous = ch;
            }
            else if (previous != '-')
            {
                builder.Append('-');
                previous = '-';
            }
        }

        var result = builder.ToString().Trim('-');
        return string.IsNullOrEmpty(result) ? "hostcraft-db" : result;
    }

    private static int GetDefaultDatabasePort(DatabaseType? type) => type switch
    {
        DatabaseType.PostgreSQL => 5432,
        DatabaseType.MySQL => 3306,
        DatabaseType.MariaDB => 3306,
        DatabaseType.MongoDB => 27017,
        DatabaseType.Redis => 6379,
        DatabaseType.DragonFly => 6379,
        DatabaseType.KeyDB => 6379,
        DatabaseType.Clickhouse => 9000,
        _ => 0
    };

    private static string GetDatabaseScheme(DatabaseType? type) => type switch
    {
        DatabaseType.PostgreSQL => "postgresql",
        DatabaseType.MySQL => "mysql",
        DatabaseType.MariaDB => "mariadb",
        DatabaseType.MongoDB => "mongodb",
        DatabaseType.Redis => "redis",
        DatabaseType.DragonFly => "redis",
        DatabaseType.KeyDB => "redis",
        DatabaseType.Clickhouse => "clickhouse",
        _ => string.Empty
    };

    private static string? BuildConnectionString(string scheme, string? host, int? port, string? user, string? password, string? database)
    {
        if (string.IsNullOrWhiteSpace(scheme) || string.IsNullOrWhiteSpace(host) || !port.HasValue)
        {
            return null;
        }

        var hasUser = !string.IsNullOrWhiteSpace(user);
        var hasPassword = !string.IsNullOrWhiteSpace(password);
        var userInfo = string.Empty;

        if (hasUser || hasPassword)
        {
            if (hasUser)
            {
                var escapedUser = Uri.EscapeDataString(user!);
                var passwordSegment = hasPassword ? $":{Uri.EscapeDataString(password!)}" : string.Empty;
                userInfo = $"{escapedUser}{passwordSegment}@";
            }
            else if (hasPassword)
            {
                userInfo = $":{Uri.EscapeDataString(password!)}@";
            }
        }

        var databasePart = string.IsNullOrWhiteSpace(database) ? string.Empty : $"/{Uri.EscapeDataString(database)}";

        return $"{scheme}://{userInfo}{host}:{port.Value}{databasePart}";
    }

