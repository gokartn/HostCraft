@page "/applications/{Id:int}"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using System.Linq
@using System.Text
@using HostCraft.Core.Enums
@using HostCraft.Core.Models
@using System.Timers
@using Microsoft.JSInterop
@using System.Threading
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ILogger<ApplicationDetails> Logger
@inject IJSRuntime Js
@implements IDisposable

<div class="page-container">
    @if (isLoading)
    {
        <div class="loading-spinner">
            <div class="spinner"></div>
            <p>Loading application...</p>
        </div>
    }
    else if (app == null)
    {
        <div class="empty-state">
            <div class="empty-icon">❌</div>
            <h2>Application Not Found</h2>
            <button class="btn btn-primary" @onclick="BackToApplications">
                Back to Projects
            </button>
        </div>
    }
    else
    {
        <div class="page-header">
            <div class="header-left">
                <div class="breadcrumb">
                    <a href="/projects">Projects</a>
                    <span>/</span>
                    <a href="/projects/@app.ProjectId">@app.ProjectName</a>
                    <span>/</span>
                    <span>@app.Name</span>
                </div>
                <h1>@app.Name</h1>
                <p class="subtitle">@app.Description</p>
            </div>
            <div class="header-actions">
                <span class="status-badge @GetStatusClass(app.Status)">
                    @GetStatusIcon(app.Status) @app.Status
                </span>
            </div>
        </div>

        @* Tab Navigation *@
        <div class="tabs-container">
            <button class="tab @(activeTab == "General" ? "active" : string.Empty)" @onclick="NavigateToGeneral">General</button>
            <button class="tab" @onclick="NavigateToEdit">Edit</button>
            <button class="tab" @onclick="NavigateToDomains">Domains</button>
            <button class="tab @(activeTab == "Advanced" ? "active" : string.Empty)" @onclick="NavigateToAdvanced">Advanced</button>
            <button class="tab" @onclick="NavigateToLogs">Logs</button>
        </div>
        
        <div class="details-grid">
            <div class="details-main">
                @if (!string.IsNullOrEmpty(copyMessage))
                {
                    <div class="copy-toast">@copyMessage</div>
                }

                @if (CanScale())
                {
                    <div class="card compact-card scale-card" id="replica-scale">
                        <div class="card-header scale-header">
                            <div>
                                <h3>Replicas</h3>
                                <p class="card-subtitle">Adjust how many instances run in your cluster.</p>
                            </div>
                            <div class="scale-controls">
                                <button class="btn btn-secondary btn-icon" @onclick="DecrementScale" disabled="@isScaling || scaleReplicas <= 0">-</button>
                                <input type="number" min="0" max="100" class="scale-input" @bind="scaleReplicas" />
                                <button class="btn btn-secondary btn-icon" @onclick="IncrementScale" disabled="@isScaling">+</button>
                                <button class="btn btn-primary btn-sm" @onclick="ApplyScaleAsync" disabled="@isScaling">@(isScaling ? "Scaling..." : "Apply")</button>
                            </div>
                        </div>
                        <div class="scale-meta">
                            <span class="pill">Current: @app.Replicas</span>
                            <span class="pill pill-accent">Swarm service</span>
                        </div>
                        @if (!string.IsNullOrEmpty(scaleError))
                        {
                            <div class="error-chip">@scaleError</div>
                        }
                        else if (!string.IsNullOrEmpty(scaleSuccess))
                        {
                            <div class="success-chip">@scaleSuccess</div>
                        }
                    </div>
                }

                @if (HasRuntimeTarget())
                {
                    <div class="card compact-card monitoring-card" id="monitoring">
                        <div class="card-header monitoring-header">
                            <div class="monitoring-title">
                                <h3>Runtime Monitoring</h3>
                                <span class="live-pill @(metricsStreamingEnabled ? "live" : "paused")">@(metricsStreamingEnabled ? "Live" : "Paused")</span>
                                <span class="pill">@GetRuntimeModeLabel()</span>
                            </div>
                            <div class="monitoring-actions">
                                <button class="btn btn-secondary btn-sm" @onclick="ToggleMetricsStreaming">
                                    @(metricsStreamingEnabled ? "Pause" : "Resume")
                                </button>
                                <button class="btn btn-secondary btn-sm" @onclick="RefreshMetricsAsync" disabled="@isMetricsLoading">↻ Refresh</button>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(metricsError))
                        {
                            <div class="error-chip">@metricsError</div>
                        }
                        else if (runtimeMetrics is null)
                        {
                            <p class="text-muted" style="margin: 0;">Collecting live metrics...</p>
                        }
                        else
                        {
                            var metrics = runtimeMetrics!;
                            var containers = metrics.Containers;
                            var containerCount = containers.Count;
                            var cpuWidth = Math.Clamp(metrics.TotalCpuPercent, 0, 100);
                            var memWidth = Math.Clamp(metrics.TotalMemoryPercent, 0, 100);

                            <div class="monitoring-summary-grid">
                                <div class="monitoring-stat-card accent-cpu">
                                    <div class="stat-top">
                                        <span class="stat-icon">🔥</span>
                                        <span class="stat-chip">@containerCount container@(containerCount == 1 ? string.Empty : "s")</span>
                                    </div>
                                    <div class="stat-main">@metrics.TotalCpuPercent.ToString("0.0")%</div>
                                    <div class="stat-sub">CPU across all containers</div>
                                    <div class="stat-meter">
                                        <div class="stat-meter-fill" style=$"width: {cpuWidth:0.#}%"></div>
                                    </div>
                                </div>

                                <div class="monitoring-stat-card accent-memory">
                                    <div class="stat-top">
                                        <span class="stat-icon">💾</span>
                                        <span class="stat-chip">@FormatBytes(metrics.TotalMemoryUsageBytes)</span>
                                    </div>
                                    <div class="stat-main">@metrics.TotalMemoryPercent.ToString("0.0")%</div>
                                    <div class="stat-sub">of @FormatBytes(metrics.TotalMemoryLimitBytes)</div>
                                    <div class="stat-meter">
                                        <div class="stat-meter-fill" style=$"width: {memWidth:0.#}%"></div>
                                    </div>
                                </div>

                                <div class="monitoring-stat-card accent-network">
                                    <div class="stat-top">
                                        <span class="stat-icon">🌐</span>
                                        <span class="stat-chip">live</span>
                                    </div>
                                    <div class="stat-main">@FormatBytes(metrics.NetworkRxBytes) ↓</div>
                                    <div class="stat-sub">@FormatBytes(metrics.NetworkTxBytes) ↑</div>
                                    <div class="stat-micro">Totals since last sample</div>
                                </div>

                                <div class="monitoring-stat-card accent-io">
                                    <div class="stat-top">
                                        <span class="stat-icon">💽</span>
                                        <span class="stat-chip">storage</span>
                                    </div>
                                    <div class="stat-main">@FormatBytes(metrics.BlockReadBytes) ⬇</div>
                                    <div class="stat-sub">@FormatBytes(metrics.BlockWriteBytes) ⬆</div>
                                    <div class="stat-micro">Block I/O across nodes</div>
                                </div>
                            </div>

                            <div class="monitoring-containers-grid">
                                @foreach (var container in containers.OrderByDescending(c => c.CpuPercent))
                                {
                                    var nodeLabel = string.IsNullOrWhiteSpace(container.NodeName) ? "Unknown node" : container.NodeName;
                                    var containerCpuWidth = Math.Clamp(container.CpuPercent, 0, 100);
                                    var containerMemWidth = Math.Clamp(container.MemoryPercent, 0, 100);
                                    var displayName = string.IsNullOrWhiteSpace(container.Name) ? container.ContainerId : container.Name;
                                    var shortName = displayName.Split('-').Last();
                                    <div class="container-card">
                                        <div class="container-card-header">
                                            <div>
                                                <div class="container-name">@displayName</div>
                                                <div class="container-meta">Node: @nodeLabel</div>
                                            </div>
                                            <span class="container-chip">@shortName</span>
                                        </div>
                                        <div class="container-metrics-grid">
                                            <div class="mini-stat">
                                                <div class="mini-label">CPU</div>
                                                <div class="mini-value">@container.CpuPercent.ToString("0.0")%</div>
                                                <div class="mini-meter"><div style=$"width: {containerCpuWidth:0.#}%"></div></div>
                                            </div>
                                            <div class="mini-stat">
                                                <div class="mini-label">Memory</div>
                                                <div class="mini-value">@container.MemoryPercent.ToString("0.0")%</div>
                                                <div class="mini-sub">@FormatBytes(container.MemoryUsageBytes) / @FormatBytes(container.MemoryLimitBytes)</div>
                                                <div class="mini-meter"><div style=$"width: {containerMemWidth:0.#}%"></div></div>
                                            </div>
                                            <div class="mini-stat">
                                                <div class="mini-label">Network</div>
                                                <div class="mini-sub">@FormatBytes(container.NetworkRxBytes) ↓</div>
                                                <div class="mini-sub">@FormatBytes(container.NetworkTxBytes) ↑</div>
                                            </div>
                                            <div class="mini-stat">
                                                <div class="mini-label">Block I/O</div>
                                                <div class="mini-sub">@FormatBytes(container.BlockReadBytes) ⬇</div>
                                                <div class="mini-sub">@FormatBytes(container.BlockWriteBytes) ⬆</div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                <div class="card compact-card" id="traefik-advanced">
                    <div class="card-header">
                        <h3>Configuration</h3>
                    </div>
                    <div class="info-grid compact">
                        <div class="info-item">
                            <span class="label">Docker Image</span>
                            <span class="value">@app.DockerImage</span>
                        </div>
                        <div class="info-item">
                            <span class="label">Server</span>
                            <span class="value">@app.ServerName</span>
                        </div>
                        <div class="info-item">
                            <span class="label">Project</span>
                            <span class="value">@app.ProjectName</span>
                        </div>
                        @if (app.Port.HasValue)
                        {
                            <div class="info-item">
                                <span class="label">Port</span>
                                <span class="value">@app.Port</span>
                            </div>
                        }
                        <div class="info-item">
                            <span class="label">Replicas</span>
                            <span class="value">@app.Replicas</span>
                        </div>
                        <div class="info-item">
                            <span class="label">Created</span>
                            <span class="value">@app.CreatedAt.ToString("g")</span>
                        </div>
                        @if (app.LastDeployedAt.HasValue)
                        {
                            <div class="info-item">
                                <span class="label">Last Deployed</span>
                                <span class="value">@app.LastDeployedAt.Value.ToString("g")</span>
                            </div>
                        }
                    </div>
                </div>
                
                @if (TryBuildDatabaseCredentials(out var dbCredentials))
                {
                    <div class="card compact-card credential-card">
                        <div class="card-header">
                            <h3>Database Access</h3>
                            <p class="card-subtitle">Generated connection details for @app.DatabaseType</p>
                        </div>
                        <div class="credential-sections">
                            <div class="credential-section">
                                <h4>Internal Credentials</h4>
                                <p class="section-hint">Use inside the HostCraft overlay network.</p>
                                @foreach (var entry in dbCredentials.InternalEntries)
                                {
                                    <div class="credential-row">
                                        <div class="credential-label">@entry.Label</div>
                                        <div class="credential-actions">
                                            <span class="credential-value">@FormatDisplayValue(entry.Key, entry.Value)</span>
                                            @if (AllowReveal(entry.Key) && !string.IsNullOrEmpty(entry.Value))
                                            {
                                                <button class="btn btn-icon" title="Toggle visibility" @onclick="() => ToggleSecret(entry.Key)">
                                                    @(IsValueMasked(entry.Key, entry.Value) ? "👁️" : "🙈")
                                                </button>
                                            }
                                            @if (!string.IsNullOrEmpty(entry.Value))
                                            {
                                                <button class="btn btn-icon" title="Copy value" @onclick="async () => await CopyValueAsync(entry.Value, entry.Label)">
                                                    📋
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>

                            @if (dbCredentials.ExternalEntries.Any())
                            {
                                <div class="credential-section">
                                    <h4>External Credentials</h4>
                                    <p class="section-hint">Reach the database from outside the cluster.</p>
                                    @foreach (var entry in dbCredentials.ExternalEntries)
                                    {
                                        <div class="credential-row">
                                            <div class="credential-label">@entry.Label</div>
                                            <div class="credential-actions">
                                                <span class="credential-value">@FormatDisplayValue(entry.Key, entry.Value)</span>
                                                @if (AllowReveal(entry.Key) && !string.IsNullOrEmpty(entry.Value))
                                                {
                                                    <button class="btn btn-icon" title="Toggle visibility" @onclick="() => ToggleSecret(entry.Key)">
                                                        @(IsValueMasked(entry.Key, entry.Value) ? "👁️" : "🙈")
                                                    </button>
                                                }
                                                @if (!string.IsNullOrEmpty(entry.Value))
                                                {
                                                    <button class="btn btn-icon" title="Copy value" @onclick="async () => await CopyValueAsync(entry.Value, entry.Label)">
                                                        📋
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(app.Domain))
                {
                    <div class="card compact-card">
                        <div class="card-header">
                            <h3>🌐 Domain & SSL</h3>
                        </div>
                        <div class="info-grid compact">
                            <div class="info-item">
                                <span class="label">Primary Domain</span>
                                <span class="value">
                                    <a href="@(app.EnableHttps ? "https" : "http")://@app.Domain" target="_blank" style="color: #6366f1; text-decoration: none;">
                                        @app.Domain
                                    </a>
                                </span>
                            </div>
                            @if (!string.IsNullOrEmpty(app.AdditionalDomains))
                            {
                                <div class="info-item">
                                    <span class="label">Additional Domains</span>
                                    <span class="value">@app.AdditionalDomains</span>
                                </div>
                            }
                            <div class="info-item">
                                <span class="label">HTTPS Enabled</span>
                                <span class="value">@(app.EnableHttps ? "✅ Yes" : "❌ No")</span>
                            </div>
                            @if (app.EnableHttps)
                            {
                                <div class="info-item">
                                    <span class="label">Force HTTPS</span>
                                    <span class="value">@(app.ForceHttps ? "✅ Yes" : "❌ No")</span>
                                </div>
                                <div class="info-item">
                                    <span class="label">SSL Certificate</span>
                                    <span class="value">🔒 Let's Encrypt</span>
                                </div>
                                @if (!string.IsNullOrEmpty(app.LetsEncryptEmail))
                                {
                                    <div class="info-item">
                                        <span class="label">Certificate Email</span>
                                        <span class="value">@app.LetsEncryptEmail</span>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
                
                <div class="card compact-card traefik-card">
                    <div class="card-header traefik-header">
                        <div class="header-stack">
                            <h3>🌀 Traefik Config</h3>
                            <p class="card-subtitle">Preview the HA-ready labels and layer overrides without breaking routing.</p>
                        </div>
                        <span class="pill pill-ghost">HA-first</span>
                    </div>
                    <div class="traefik-grid upgraded">
                        <div class="traefik-preview">
                            <div class="preview-header">
                                <div class="preview-title">Generated labels</div>
                                <span class="pill">Base</span>
                            </div>
                            <pre class="code-block code-block-lined">@RenderLabels(traefikPreview?.BaseLabels)</pre>
                            <div class="preview-header">
                                <div class="preview-title">Merged with overrides</div>
                                <span class="pill pill-accent">Final</span>
                            </div>
                            <div class="merge-note">Base + overrides → what Traefik actually receives on Swarm.</div>
                            <pre class="code-block code-block-lined code-accent">@RenderLabels(traefikPreview?.MergedLabels)</pre>
                        </div>
                        <div class="traefik-editor">
                            <div class="editor-heading">
                                <div>
                                    <label class="editor-label">Overrides (JSON object)</label>
                                    <p class="editor-hint">One flat JSON with Traefik label keys. Use for edge cases like headers, priorities, middlewares.</p>
                                </div>
                                <span class="pill pill-accent">Advanced</span>
                            </div>
                            <textarea class="code-textarea" rows="13" @bind="overridesInput" @bind:after="OnOverridesChanged" placeholder='{
  "traefik.http.routers.app.priority": "10",
  "traefik.http.middlewares.app.headers.customrequestheaders.X-Frame-Options": "SAMEORIGIN"
}'></textarea>
                            <div class="traefik-actions">
                                <button class="btn btn-secondary btn-sm" @onclick="PreviewOverridesAsync" disabled="@isPreviewLoading">🔎 Preview</button>
                                <button class="btn btn-primary btn-sm" @onclick="SaveOverridesAsync" disabled="@isSavingOverrides">💾 Save Overrides</button>
                                <button class="btn btn-secondary btn-sm" @onclick="ResetOverridesToSaved" disabled="@isPreviewLoading || isSavingOverrides">↩️ Reset</button>
                            </div>
                            <p class="editor-footnote">Preview checks JSON validity and highlights warnings before saving.</p>
                            @if (!string.IsNullOrEmpty(previewError))
                            {
                                <div class="error-chip">@previewError</div>
                            }
                            @if (previewWarnings.Any())
                            {
                                <ul class="warning-list">
                                    @foreach (var warning in previewWarnings)
                                    {
                                        <li>⚠️ @warning</li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </div>
                
                @if (app.EnvironmentVariables != null && app.EnvironmentVariables.Any())
                {
                    <div class="card compact-card">
                        <div class="card-header">
                            <h3>Environment Variables</h3>
                        </div>
                        <div class="env-vars enhanced">
                            @foreach (var env in app.EnvironmentVariables.OrderBy(kvp => kvp.Key))
                            {
                                var key = env.Key;
                                var value = env.Value ?? string.Empty;
                                <div class="env-var enhanced">
                                    <div class="env-var-info">
                                        <span class="env-key">@key</span>
                                    </div>
                                    <div class="env-var-actions">
                                        <span class="env-value">@FormatDisplayValue(key, value)</span>
                                        @if (AllowReveal(key) && !string.IsNullOrEmpty(value))
                                        {
                                            <button class="btn btn-icon" title="Toggle visibility" @onclick="() => ToggleSecret(key)">
                                                @(IsValueMasked(key, value) ? "👁️" : "🙈")
                                            </button>
                                        }
                                        @if (!string.IsNullOrEmpty(value))
                                        {
                                            <button class="btn btn-icon" title="Copy value" @onclick="async () => await CopyValueAsync(value, key)">
                                                📋
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="card compact-card">
                    <div class="card-header">
                        <h3>Project Network</h3>
                        <span class="card-subtitle">HA-ready overlay for app-to-app calls</span>
                    </div>
                    <div class="card-body">
                        @{
                            var networkName = $"{app.ProjectName}-network";
                            var internalHost = ResolveInternalHost(app);
                            var internalPort = ResolveInternalPort(app);
                            var internalAddress = internalPort.HasValue
                                ? $"http://{internalHost}:{internalPort}"
                                : $"http://{internalHost}";
                            var peerPattern = "http://<other-app>:<their-port>";
                        }
                        <p class="text-muted" style="margin-bottom: 0.75rem;">
                            Every app in this project is auto-attached to <code>@networkName</code>. Drop these into env vars for instant service discovery.
                        </p>

                        <div class="env-vars enhanced">
                            <div class="env-var enhanced">
                                <div class="env-var-info">
                                    <span class="env-key">Project network</span>
                                    <span class="env-value">@networkName</span>
                                </div>
                                <div class="env-var-actions">
                                    <button class="btn btn-icon copy-pill" title="Copy network" @onclick='() => CopyValueAsync(networkName, "Project network")'>📋</button>
                                </div>
                            </div>

                            <div class="env-var enhanced">
                                <div class="env-var-info">
                                    <span class="env-key">Reach this app</span>
                                    <span class="env-value">@internalAddress</span>
                                </div>
                                <div class="env-var-actions">
                                    <button class="btn btn-icon copy-pill" title="Copy internal URL" @onclick='() => CopyValueAsync(internalAddress, "Internal URL")'>📋</button>
                                </div>
                            </div>

                            <div class="env-var enhanced">
                                <div class="env-var-info">
                                    <span class="env-key">Peer pattern</span>
                                    <span class="env-value">@peerPattern</span>
                                </div>
                                <div class="env-var-actions">
                                    <button class="btn btn-icon copy-pill" title="Copy pattern" @onclick='() => CopyValueAsync(peerPattern, "Peer pattern")'>📋</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="card compact-card">
                    <div class="card-header">
                        <h3>Deployment History</h3>
                    </div>
                    @if (app.Deployments != null && app.Deployments.Any())
                    {
                        <div class="deployments-list compact">
                            @foreach (var deployment in app.Deployments)
                            {
                                <div class="deployment-item @GetStatusClass(deployment.Status)" @onclick="() => SelectDeployment(deployment)">
                                    <div class="deployment-row">
                                        <div class="deployment-status">
                                            <span class="status-icon @GetStatusClass(deployment.Status)">@GetStatusIcon(deployment.Status)</span>
                                            <span class="deployment-time">@deployment.StartedAt.ToString("MM/dd HH:mm")</span>
                                        </div>
                                        <div class="deployment-info">
                                            @if (!string.IsNullOrEmpty(deployment.ContainerId))
                                            {
                                                <span class="deployment-id">@deployment.ContainerId.Substring(0, 12)</span>
                                            }
                                            @if (!string.IsNullOrEmpty(deployment.ServiceId))
                                            {
                                                <span class="deployment-id">@deployment.ServiceId</span>
                                            }
                                            @if (deployment.FinishedAt.HasValue)
                                            {
                                                var duration = deployment.FinishedAt.Value - deployment.StartedAt;
                                                <span class="deployment-duration">@FormatDuration(duration)</span>
                                            }
                                            else if (deployment.Status == DeploymentStatus.Running || deployment.Status == DeploymentStatus.Queued)
                                            {
                                                <span class="deployment-duration building">Building...</span>
                                            }
                                        </div>
                                    </div>
                                    @if (deployment.Status == DeploymentStatus.Failed && !string.IsNullOrEmpty(deployment.ErrorMessage))
                                    {
                                        <div class="deployment-error">@deployment.ErrorMessage</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No deployments yet</p>
                    }
                </div>

                @* Build Logs Panel - Shows when deployment is in progress or selected *@
                @if (selectedDeployment != null || activeDeployment != null)
                {
                    var displayDeployment = selectedDeployment ?? activeDeployment;
                    <div class="card compact-card build-logs-card">
                        <div class="card-header">
                            <h3>
                                @if (displayDeployment!.Status == DeploymentStatus.Running || displayDeployment.Status == DeploymentStatus.Queued)
                                {
                                    <span class="building-indicator"></span>
                                }
                                Build Logs
                                @if (displayDeployment.Status == DeploymentStatus.Running)
                                {
                                    <span class="status-badge status-running" style="margin-left: 0.5rem; font-size: 0.75rem;">Live</span>
                                }
                            </h3>
                            <div class="logs-actions">
                                @if (selectedDeployment != null)
                                {
                                    <button class="btn btn-sm btn-secondary" @onclick="ClearSelectedDeployment">Close</button>
                                }
                            </div>
                        </div>
                        <div class="build-logs-container">
                            @if (buildLogs.Count == 0)
                            {
                                <div class="logs-empty">
                                    @if (displayDeployment.Status == DeploymentStatus.Queued)
                                    {
                                        <span>Waiting for build to start...</span>
                                    }
                                    else
                                    {
                                        <span>No logs available</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <pre class="build-logs-content">@foreach (var log in buildLogs)
{<span class="log-line @GetLogLevelClass(log.LogLevel)">[@log.Timestamp.ToString("HH:mm:ss")] @log.Message</span>
}</pre>
                            }
                        </div>
                    </div>
                }
            </div>
            
            <div class="details-sidebar">
                <div class="card compact-card">
                    <div class="card-header">
                        <h3>Actions</h3>
                    </div>
                    <div class="actions-grid">
                        <button class="btn btn-primary btn-sm" @onclick="Redeploy" disabled="@isRedeploying">
                            @if (isRedeploying)
                            {
                                <span>🔄</span>
                            }
                            else
                            {
                                <span>🚀 Redeploy</span>
                            }
                        </button>
                        <button class="btn btn-secondary btn-sm" @onclick="ViewLogs" disabled="@(!CanViewLogs())">
                            📄 Logs
                        </button>
                        <button class="btn btn-secondary btn-sm" @onclick="EditApplication">
                            ✏️ Edit
                        </button>
                        <button class="btn btn-danger btn-sm" @onclick="DeleteApplication" disabled="@isDeleting">
                            @if (isDeleting)
                            {
                                <span>🗑️</span>
                            }
                            else
                            {
                                <span>🗑️ Delete</span>
                            }
                        </button>
                    </div>
                </div>
                
                @if (!string.IsNullOrEmpty(app.ContainerId) || !string.IsNullOrEmpty(app.ServiceId))
                {
                    <div class="card compact-card">
                        <div class="card-header">
                            <h3>Runtime</h3>
                        </div>
                        <div class="info-grid compact">
                            @if (!string.IsNullOrEmpty(app.ServiceId))
