    private string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalSeconds < 60)
            return $"{(int)duration.TotalSeconds}s";
        if (duration.TotalMinutes < 60)
            return $"{(int)duration.TotalMinutes}m {duration.Seconds}s";
        return $"{(int)duration.TotalHours}h {duration.Minutes}m";
    }

    private string GetRuntimeModeLabel() => string.IsNullOrWhiteSpace(app?.ServiceId) ? "Container" : "Service";

    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0)
        {
            return "0 B";
        }

        string[] units = { "B", "KB", "MB", "GB", "TB" };
        double value = bytes;
        var unitIndex = 0;

        while (value >= 1024 && unitIndex < units.Length - 1)
        {
            value /= 1024;
            unitIndex++;
        }

        return $"{value:0.0} {units[unitIndex]}";
    }

    private static string RenderLabels(Dictionary<string, string>? labels)
    {
        if (labels == null || labels.Count == 0)
        {
            return "No labels generated.";
        }

        var builder = new StringBuilder();
        foreach (var kvp in labels.OrderBy(static kvp => kvp.Key))
        {
            builder.AppendLine($"{kvp.Key} = {kvp.Value}");
        }

        return builder.ToString().TrimEnd();
    }

