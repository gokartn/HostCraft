@page "/profile/change-password"
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ILogger<ChangePassword> Logger

<PageTitle>Change Password - HostCraft</PageTitle>

<div class="page-container">
    <div class="page-header">
        <h1>Change Password</h1>
        <p class="page-description">Update your account password</p>
    </div>

    <div class="card" style="max-width: 600px; margin: 0 auto;">
        <div class="card-body">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">
                    <span class="alert-icon">⚠️</span>
                    <span>@errorMessage</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success">
                    <span class="alert-icon">✓</span>
                    <span>@successMessage</span>
                </div>
            }

            <EditForm Model="changePasswordModel" OnValidSubmit="HandleChangePassword" FormName="changePasswordForm">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label for="currentPassword">Current Password</label>
                    <InputText id="currentPassword" @bind-Value="changePasswordModel.CurrentPassword"
                               type="password" class="form-control" placeholder="Enter current password" />
                    <ValidationMessage For="() => changePasswordModel.CurrentPassword" class="validation-error" />
                </div>

                <div class="form-group">
                    <label for="newPassword">New Password</label>
                    <InputText id="newPassword" @bind-Value="changePasswordModel.NewPassword"
                               type="password" class="form-control" placeholder="Enter new password" />
                    <ValidationMessage For="() => changePasswordModel.NewPassword" class="validation-error" />
                    <div class="form-hint">
                        Password must be at least 8 characters long
                    </div>
                </div>

                <div class="form-group">
                    <label for="confirmPassword">Confirm New Password</label>
                    <InputText id="confirmPassword" @bind-Value="changePasswordModel.ConfirmPassword"
                               type="password" class="form-control" placeholder="Confirm new password" />
                    <ValidationMessage For="() => changePasswordModel.ConfirmPassword" class="validation-error" />
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-sm"></span>
                            <span>Updating...</span>
                        }
                        else
                        {
                            <span>Update Password</span>
                        }
                    </button>
                    <a href="/profile" class="btn btn-secondary">Cancel</a>
                </div>
            </EditForm>
        </div>
    </div>
</div>

<style>
.form-hint {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: var(--space-xs);
}

.spinner-sm {
    display: inline-block;
    width: 16px;
    height: 16px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top-color: white;
    border-radius: 50%;
    animation: spin 1s linear infinite;
}

@@keyframes spin {
    to { transform: rotate(360deg); }
}

.alert {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-lg);
}

.alert-icon {
    font-size: 1.2rem;
    flex-shrink: 0;
}

.alert-danger {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: var(--accent-danger);
}

.alert-success {
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: var(--accent-success);
}

.validation-error {
    color: var(--accent-danger);
    font-size: 0.85rem;
    margin-top: var(--space-xs);
    display: block;
}
</style>

@code {
    private ChangePasswordModel changePasswordModel = new();
    private string? errorMessage;
    private string? successMessage;
    private bool isLoading;

    private async Task HandleChangePassword()
    {
        if (isLoading) return;

        // Validate passwords match
        if (changePasswordModel.NewPassword != changePasswordModel.ConfirmPassword)
        {
            errorMessage = "New password and confirmation do not match";
            return;
        }

        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            Logger.LogInformation("Attempting to change password");

            var request = new
            {
                currentPassword = changePasswordModel.CurrentPassword,
                newPassword = changePasswordModel.NewPassword
            };

            var response = await Http.PostAsJsonAsync("api/auth/change-password", request);

            if (response.IsSuccessStatusCode)
            {
                Logger.LogInformation("Password changed successfully");
                successMessage = "Password updated successfully!";

                // Clear form
                changePasswordModel = new();

                // Redirect to profile after 2 seconds
                await Task.Delay(2000);
                Navigation.NavigateTo("/profile");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Logger.LogWarning("Password change failed: {StatusCode} - {Error}", response.StatusCode, errorContent);

                // Try to extract error message from API response
                try
                {
                    var errorResponse = System.Text.Json.JsonDocument.Parse(errorContent);
                    if (errorResponse.RootElement.TryGetProperty("error", out var errorProp))
                    {
                        errorMessage = errorProp.GetString() ?? "Failed to change password";
                    }
                    else
                    {
                        errorMessage = "Failed to change password. Please check your current password.";
                    }
                }
                catch
                {
                    errorMessage = "Failed to change password. Please check your current password.";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Unable to connect to the server. Please try again.";
            Logger.LogError(ex, "Exception during password change");
        }
        finally
        {
            isLoading = false;
        }
    }

    public class ChangePasswordModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Current password is required")]
        public string CurrentPassword { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "New password is required")]
        [System.ComponentModel.DataAnnotations.MinLength(8, ErrorMessage = "Password must be at least 8 characters")]
        public string NewPassword { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please confirm your new password")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
