    protected override async Task OnInitializedAsync()
    {
        // Redirect to projects page if accessing /applications/new without project context
        if (!IsEditMode && !ProjectId.HasValue)
        {
            Navigation.NavigateTo("/projects");
            return;
        }

        await LoadData();
        isLoading = false;
    }
    
    private async Task LoadData()
    {
        try
        {
            // Load servers, projects, and git providers in parallel
            var serversTask = Http.GetFromJsonAsync<List<ServerDto>>("api/applications/servers/0");
            var projectsTask = Http.GetFromJsonAsync<List<ProjectDto>>("api/applications/projects");
            var gitProvidersTask = Http.GetFromJsonAsync<List<GitProviderDto>>("api/gitproviders");

            await Task.WhenAll(serversTask, projectsTask, gitProvidersTask);

            servers = serversTask.Result;
            projects = projectsTask.Result;
            gitProviders = gitProvidersTask.Result?.Where(p => p.IsActive).ToList();

            // Pre-select project if coming from project context
            if (ProjectId.HasValue && !IsEditMode)
            {
                model.ProjectId = ProjectId.Value;
            }

            if (IsEditMode && Id.HasValue)
            {
                // Load existing application
                var app = await Http.GetFromJsonAsync<ApplicationWithDeploymentsDto>($"api/applications/{Id.Value}");
                if (app != null)
                {
                    model = new ApplicationFormModel
                    {
                        Name = app.Name,
                        Description = app.Description,
                        ServerId = app.ServerId,
                        ProjectId = app.ProjectId,
                        SourceType = app.SourceType.ToString(),
                        Image = app.DockerImage ?? "",
                        GitProviderId = app.GitProviderId,
                        GitRepository = app.GitRepository,
                        GitBranch = app.GitBranch ?? "main",
                        DockerfilePath = app.Dockerfile,
                        BuildContext = app.BuildContext ?? ".",
                        DockerBuildTarget = app.DockerBuildTarget,
                        BuildArgs = app.BuildArgs,
                        CloneSubmodules = app.CloneSubmodules,
                        EnableGitLfs = app.EnableGitLfs,
                        AutoDeployOnPush = app.AutoDeployOnPush,
                        EnablePreviewDeployments = app.EnablePreviewDeployments,
                        PreviewUrlTemplate = app.PreviewUrlTemplate,
                        Port = app.Port,
                        Replicas = app.Replicas,
                        Domain = app.Domain,
                        AdditionalDomains = app.AdditionalDomains,
                        EnableHttps = app.EnableHttps,
                        ForceHttps = app.ForceHttps,
                        LetsEncryptEmail = app.LetsEncryptEmail,
                        UsePrivateRegistry = app.UsePrivateRegistry,
                        RegistryServer = app.RegistryServer,
                        RegistryUsername = app.RegistryUsername,
                        RegistryPassword = string.Empty
                    };

                    hasExistingRegistryPassword = app.HasRegistryPassword;

                    if (app.EnvironmentVariables != null)
                    {
                        envVars = app.EnvironmentVariables.Select(kv => new EnvVar { Key = kv.Key, Value = kv.Value }).ToList();
                    }

                    // Load Git provider and repos if Git source
                    if (app.SourceType == ApplicationSourceType.Git && app.GitProviderId.HasValue)
                    {
                        selectedGitProviderId = app.GitProviderId.Value;

                        // Load repositories
                        try
                        {
                            gitRepositories = await Http.GetFromJsonAsync<List<GitRepositoryDto>>($"api/gitproviders/{selectedGitProviderId}/repositories");

                            // Load branches if repository is set
                            if (!string.IsNullOrEmpty(app.GitRepository))
                            {
                                var repoParts = app.GitRepository.Split('/');
                                var owner = repoParts.Length > 1 ? repoParts[0] : app.GitOwner ?? "";
                                var repo = repoParts.Length > 1 ? repoParts[1] : app.GitRepoName ?? "";
                                gitBranches = await Http.GetFromJsonAsync<List<string>>($"api/gitproviders/{selectedGitProviderId}/repositories/{owner}/{repo}/branches");
                            }
                        }
                        catch (Exception ex)
                        {
                            Logger.LogError(ex, "Error loading Git data");
                        }
                    }

                    UpdateServerSwarmStatus();
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading data");
            errorMessage = "Failed to load data";
        }
    }
    
