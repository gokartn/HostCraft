@page "/applications/new"
@page "/applications/{Id:int}/edit"
@page "/projects/{ProjectId:int}/applications/new"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using System.Text
@using HostCraft.Core.Enums
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ILogger<ApplicationForm> Logger
@inject IJSRuntime Js

<div class="page-container">
    <div class="page-header">
        <div class="header-left">
            @if (ProjectId.HasValue && !IsEditMode)
            {
                <div class="breadcrumb">
                    <a href="/projects">Projects</a>
                    <span>/</span>
                    <a href="/projects/@ProjectId">@GetProjectName()</a>
                    <span>/</span>
                    <span>New Application</span>
                </div>
            }
            <h1>@(IsEditMode ? "✏️ Edit Application" : "➕ Deploy New Application")</h1>
            <p class="subtitle">@(IsEditMode ? "Update application configuration" : "Configure and deploy your application")</p>
        </div>
    </div>

    @if (IsEditMode)
    {
        @* Tab Navigation - Only show in edit mode *@
        <div class="tabs-container">
            <button class="tab" @onclick="NavigateToDetails">General</button>
            <button class="tab active">Edit</button>
            <button class="tab" @onclick="NavigateToDomains">Domains</button>
            <button class="tab" @onclick="NavigateToAdvanced">Advanced</button>
            <button class="tab" @onclick="NavigateToLogs">Logs</button>
        </div>
    }

    <div class="form-container">
        @if (isLoading)
        {
            <div class="loading-spinner">
                <div class="spinner"></div>
                <p>Loading...</p>
            </div>
        }
        else
        {
            <div class="form-card">
                <div class="form-section">
                    <h2>Basic Information</h2>
                    
                    <div class="form-group">
                        <label for="name">Application Name *</label>
                        <input type="text" id="name" @bind="model.Name" class="form-control" placeholder="my-awesome-app" />
                    </div>
                    
                    <div class="form-group">
                        <label for="description">Description</label>
                        <textarea id="description" @bind="model.Description" class="form-control" rows="3" placeholder="What does this application do?"></textarea>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label for="server">Server *</label>
                            <select id="server" @bind="model.ServerId" @bind:after="OnServerChanged" class="form-control">
                                <option value="0">-- Select Server --</option>
                                @if (servers != null)
                                {
                                    foreach (var server in servers)
                                    {
                                        <option value="@server.Id">@server.Name @(server.IsSwarm ? "🐝 Swarm" : "🐳 Standalone")</option>
                                    }
                                }
                            </select>
                        </div>

                        @if (ProjectId.HasValue)
                        {
                            <div class="form-group">
                                <label>Project</label>
                                <div class="form-control-static">
                                    @GetProjectName()
                                </div>
                            </div>
                        }
                    </div>
                </div>
                
                <div class="form-section">
                    <h2>Source Configuration</h2>

                    <div class="form-group">
                        <label>Deployment Source</label>
                        <div class="source-type-selector">
                            <button type="button" class="source-option @(model.SourceType == "DockerImage" ? "active" : "")"
                                    @onclick="@(() => SetSourceType("DockerImage"))">
                                <span class="source-icon">🐳</span>
                                <span class="source-label">Docker Image</span>
                                <span class="source-desc">Deploy from Docker Hub or registry</span>
                            </button>
                            <button type="button" class="source-option @(model.SourceType == "Git" ? "active" : "")"
                                    @onclick="@(() => SetSourceType("Git"))">
                                <span class="source-icon">🐙</span>
                                <span class="source-label">Git Repository</span>
                                <span class="source-desc">Build and deploy from source code</span>
                            </button>
                            <button type="button" class="source-option @(model.SourceType == "DockerCompose" ? "active" : "")"
                                    @onclick="@(() => SetSourceType("DockerCompose"))">
                                <span class="source-icon">📚</span>
                                <span class="source-label">Docker Compose</span>
                                <span class="source-desc">Deploy multi-container stack</span>
                            </button>
                        </div>
                    </div>

                    @if (model.SourceType == "DockerImage")
                    {
                        <div class="form-group">
                            <label for="image">Docker Image *</label>
                            <input type="text" id="image" @bind="model.Image" class="form-control" placeholder="nginx:latest" />
                            <small class="form-hint">Format: image:tag or registry/image:tag</small>
                        </div>

                        <div class="form-group inline-row">
                            <div>
                                <label class="checkbox">
                                    <input type="checkbox" @bind="model.UsePrivateRegistry" />
                                    <span>Pull from private registry</span>
                                </label>
                                <small class="form-hint">Send registry credentials to Swarm so every node can pull the image.</small>
                            </div>
                        </div>

                        @if (model.UsePrivateRegistry)
                        {
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="registryServer">Registry Server *</label>
                                    <input id="registryServer" type="text" class="form-control" @bind="model.RegistryServer" placeholder="registry.example.com" />
                                    <small class="form-hint">Host only (no protocol). Example: ghcr.io, registry.example.com</small>
                                </div>
                                <div class="form-group">
                                    <label for="registryUsername">Username</label>
                                    <input id="registryUsername" type="text" class="form-control" @bind="model.RegistryUsername" placeholder="username or token id" />
                                </div>
                                <div class="form-group">
                                    <label for="registryPassword">Password / Token</label>
                                    <input id="registryPassword" type="password" class="form-control" @bind="model.RegistryPassword" placeholder="••••••" />
                                    @if (hasExistingRegistryPassword && string.IsNullOrWhiteSpace(model.RegistryPassword))
                                    {
                                        <small class="form-hint">A credential is stored. Leave blank to keep it, or enter a new secret to replace.</small>
                                    }
                                    else
                                    {
                                        <small class="form-hint">Will be stored encrypted and sent only to the Swarm manager.</small>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else if (model.SourceType == "Git")
                    {
                        <div class="form-group">
                            <label for="gitProvider">Git Provider *</label>
                            <select id="gitProvider" @bind="selectedGitProviderId" @bind:after="OnGitProviderChanged" class="form-control">
                                <option value="0">-- Select Git Provider --</option>
                                @if (gitProviders != null)
                                {
                                    foreach (var provider in gitProviders)
                                    {
                                        <option value="@provider.Id">@GetProviderIcon(provider.Type) @provider.Name (@@provider.Username)</option>
                                    }
                                }
                            </select>
                            @if (gitProviders == null || !gitProviders.Any())
                            {
                                <small class="form-hint">
                                    <a href="/settings/git-providers">Connect a Git provider</a> to deploy from repositories
                                </small>
                            }
                        </div>

                        @if (selectedGitProviderId > 0)
                        {
                            <div class="form-group">
                                <label for="repository">Repository *</label>
                                @if (loadingRepos)
                                {
                                    <div class="loading-inline"><span class="spinner-sm"></span> Loading repositories...</div>
                                }
                                else
                                {
                                    <select id="repository" @bind="model.GitRepository" @bind:after="OnRepositoryChanged" class="form-control">
                                        <option value="">-- Select Repository --</option>
                                        @if (gitRepositories != null)
                                        {
                                            foreach (var repo in gitRepositories)
                                            {
                                                <option value="@repo.FullName">@repo.FullName @(repo.IsPrivate ? "🔒" : "")</option>
                                            }
                                        }
                                    </select>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(model.GitRepository))
                            {
                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="branch">Branch *</label>
                                        @if (loadingBranches)
                                        {
                                            <div class="loading-inline"><span class="spinner-sm"></span> Loading branches...</div>
                                        }
                                        else
                                        {
                                            <select id="branch" @bind="model.GitBranch" class="form-control">
                                                @if (gitBranches != null)
                                                {
                                                    foreach (var branch in gitBranches)
                                                    {
                                                        <option value="@branch">@branch</option>
                                                    }
                                                }
                                            </select>
                                        }
                                    </div>

                                    <div class="form-group">
                                        <label for="buildPath">Dockerfile Path</label>
                                        <input type="text" id="buildPath" @bind="model.DockerfilePath" class="form-control" placeholder="Dockerfile" />
                                        <small class="form-hint">Path to Dockerfile (default: Dockerfile)</small>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="buildContext">Build Context</label>
                                    <input type="text" id="buildContext" @bind="model.BuildContext" class="form-control" placeholder="." />
                                    <small class="form-hint">Docker build context directory relative to repo root (default: .)</small>
                                </div>

                                <div class="form-group">
                                    <label for="buildTarget">Build Target (Multi-Stage)</label>
                                    <input type="text" id="buildTarget" @bind="model.DockerBuildTarget" class="form-control" placeholder="production" />
                                    <small class="form-hint">Target stage for multi-stage Dockerfiles (leave empty to build all stages)</small>
                                </div>

                                <div class="form-group">
                                    <label for="buildArgs">Build Arguments</label>
                                    <input type="text" id="buildArgs" @bind="model.BuildArgs" class="form-control" placeholder="NODE_ENV=production,VERSION=1.0" />
                                    <small class="form-hint">Build-time variables (format: KEY1=VALUE1,KEY2=VALUE2)</small>
                                </div>

                                <div class="form-row">
                                    <div class="form-group">
                                        <label class="checkbox-label">
                                            <input type="checkbox" @bind="model.CloneSubmodules" class="form-checkbox" />
                                            <span>📦 Clone Submodules</span>
                                        </label>
                                        <small class="form-hint">Recursively clone Git submodules</small>
                                    </div>

                                    <div class="form-group">
                                        <label class="checkbox-label">
                                            <input type="checkbox" @bind="model.EnableGitLfs" class="form-checkbox" />
                                            <span>📁 Enable Git LFS</span>
                                        </label>
                                        <small class="form-hint">Pull large files via Git LFS</small>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="checkbox-label">
                                        <input type="checkbox" @bind="model.AutoDeployOnPush" class="form-checkbox" />
                                        <span>🔄 Auto-deploy on push</span>
                                    </label>
                                    <small class="form-hint">Automatically deploy when new commits are pushed to the selected branch</small>
                                </div>

                                <div class="form-group">
                                    <label class="checkbox-label">
                                        <input type="checkbox" @bind="model.EnablePreviewDeployments" class="form-checkbox" />
                                        <span>🔍 Enable Preview Deployments</span>
                                    </label>
                                    <small class="form-hint">Automatically deploy pull requests for testing</small>
                                </div>

                                @if (model.EnablePreviewDeployments)
                                {
                                    <div class="form-group" style="margin-left: 1.5rem; border-left: 2px solid #6366f1; padding-left: 1rem;">
                                        <label for="previewUrlTemplate">Preview URL Template</label>
                                        <input type="text" id="previewUrlTemplate" @bind="model.PreviewUrlTemplate" class="form-control" placeholder="{{pr_id}}.preview.example.com" />
                                        <small class="form-hint">Supports: @("{{pr_id}}, {{branch}}, {{commit}}, {{app_name}}")</small>
                                    </div>
                                }
                            }
                        }
                    }
                    else if (model.SourceType == "DockerCompose")
                    {
                        @if (!selectedServerIsSwarm)
                        {
                            <div class="alert alert-warning">
                                ⚠️ Docker Compose deployments require a Swarm manager server. Please select a Swarm-enabled server above.
                            </div>
                        }

                        <div class="form-group">
                            <label for="composeFile">Docker Compose YAML *</label>
                            <textarea id="composeFile" @bind="model.ComposeFile" class="form-control code-editor" rows="15" placeholder="version: '3.8'&#10;services:&#10;  web:&#10;    image: nginx:latest&#10;    ports:&#10;      - 80:80"></textarea>
                            <small class="form-hint">Paste your docker-compose.yml content here</small>
                        </div>

                        @if (!string.IsNullOrEmpty(model.ComposeFile))
                        {
                            <div class="form-actions" style="margin-bottom: 1rem;">
                                <button type="button" class="btn btn-secondary" @onclick="ValidateCompose" disabled="@isValidatingCompose">
                                    @(isValidatingCompose ? "⏳ Validating..." : "✅ Validate YAML")
                                </button>
                            </div>

                            @if (composeValidationResult != null)
                            {
                                @if (composeValidationResult.IsValid)
                                {
                                    <div class="alert alert-success">
                                        <strong>✅ Valid Docker Compose file</strong>
                                        <ul style="margin: 0.5rem 0 0 1.5rem;">
                                            <li>@composeValidationResult.ServiceCount service(s) detected</li>
                                            @if (composeValidationResult.RequiredVariables.Any())
                                            {
                                                <li>@composeValidationResult.RequiredVariables.Count environment variable(s) required</li>
                                            }
                                        </ul>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-danger">
                                        <strong>❌ Validation failed</strong>
                                        <ul style="margin: 0.5rem 0 0 1.5rem;">
                                            @foreach (var error in composeValidationResult.Errors)
                                            {
                                                <li>@error</li>
                                            }
                                        </ul>
                                    </div>
                                }
                            }

                            @if (composeValidationResult?.RequiredVariables.Any() == true)
                            {
                                <div class="form-group">
                                    <label>Environment Variables (@composeValidationResult.RequiredVariables.Count detected)</label>
                                    <small class="form-hint">These variables will be substituted when deploying the stack</small>

                                    @foreach (var varName in composeValidationResult.RequiredVariables)
                                    {
                                        var existingVar = model.ComposeEnvironmentVariables.FirstOrDefault(v => v.Key == varName);
                                        if (existingVar == null)
                                        {
                                            existingVar = new ComposeEnvVarModel { Key = varName };
                                            model.ComposeEnvironmentVariables.Add(existingVar);
                                        }

                                        <div class="env-var-row" style="display: flex; gap: 0.5rem; margin-bottom: 0.5rem; align-items: start;">
                                            <input type="text" value="@varName" class="form-control" readonly style="flex: 0 0 200px; background: #2a2a2a;" />
                                            <input type="text" @bind="existingVar.Value" class="form-control" placeholder="value" style="flex: 1;" />
                                            <label class="checkbox-label" style="margin: 0.5rem 0;">
                                                <input type="checkbox" @bind="existingVar.IsSecret" class="form-checkbox" />
                                                <span>🔒 Secret</span>
                                            </label>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    }
                </div>

                <div class="form-section">
                    <h2>Container Configuration</h2>

                    <div class="form-group">
                        <label>Port Mapping</label>
                        
                        @if (selectedServerIsSwarm && !string.IsNullOrEmpty(model.Domain))
                        {
                            <div class="alert alert-info" style="background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.3); padding: 1rem; border-radius: 6px; margin-bottom: 1rem;">
                                <strong>🐝 Swarm + Traefik Routing Active</strong>
                                <p style="margin: 0.5rem 0 0 0; font-size: 0.9rem;">
                                    ✅ Traefik routes domain traffic to your container<br/>
                                    ✅ Just specify what port your app listens on internally
                                </p>
                            </div>
                            
                            @* Simple container port input for Traefik routing *@
                            @if (portMappings.Count > 0)
                            {
                                <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
                                    <div style="flex: 0 0 200px;">
                                        <label style="display: block; font-size: 0.875rem; color: #a3a3a3; margin-bottom: 0.25rem;">Container Port</label>
                                        <input type="number" 
                                               @bind="portMappings[0].ContainerPort" 
                                               placeholder="e.g., 8080, 3000, 80" 
                                               class="form-control" 
                                               style="text-align: center; font-size: 1.1rem; font-weight: 600;"
                                               min="1" 
                                               max="65535"
                                               required />
                                    </div>
                                    <div style="flex: 0 0 100px;">
                                        <label style="display: block; font-size: 0.875rem; color: #a3a3a3; margin-bottom: 0.25rem;">Protocol</label>
                                        <select @bind="portMappings[0].Protocol" class="form-control">
                                            <option value="tcp">TCP</option>
                                            <option value="udp">UDP</option>
                                        </select>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button type="button" class="btn btn-secondary" @onclick="AddPortMapping">
                                    + Set Container Port
                                </button>
                            }
                        }
                        else if (selectedServerIsSwarm)
                        {
                            <small class="form-hint" style="margin-bottom: 0.75rem; display: block;">
                                🐝 <strong>Swarm Mode:</strong> Leave empty if using domain routing. Add ports only for direct host access.
                            </small>
                        }
                        else
                        {
                            <small class="form-hint" style="margin-bottom: 0.75rem; display: block;">
                                🐳 <strong>Standalone Mode:</strong> Map container ports to host ports (like docker -p host:container)
                            </small>
                        }

                        @if (!(selectedServerIsSwarm && !string.IsNullOrEmpty(model.Domain)))
                        {
                            @foreach (var (portMapping, index) in portMappings.Select((p, i) => (p, i)))
                            {
                                <div class="port-mapping-row">
                                    <div class="port-input-group">
                                        <input type="number" @bind="portMapping.HostPort" placeholder="8080" class="form-control port-input" />
                                        <span class="port-label">Host</span>
                                    </div>
                                    <span class="port-separator">:</span>
                                    <div class="port-input-group">
                                        <input type="number" @bind="portMapping.ContainerPort" placeholder="80" class="form-control port-input" />
                                        <span class="port-label">Container</span>
                                    </div>
                                    <select @bind="portMapping.Protocol" class="form-control protocol-select">
                                        <option value="tcp">TCP</option>
                                        <option value="udp">UDP</option>
                                    </select>
                                    <button type="button" class="btn-icon btn-danger" @onclick="() => RemovePortMapping(index)" title="Remove">X</button>
                                </div>
                            }

                            <button type="button" class="btn btn-secondary" @onclick="AddPortMapping">
                                + Add Port
                            </button>
                        }
                    </div>

                    @if (selectedServerIsSwarm)
                    {
                        <div class="form-group">
                            <label for="replicas">Replicas</label>
                            <input type="number" id="replicas" @bind="model.Replicas" class="form-control" min="1" max="10" style="max-width: 150px;" />
                            <small class="form-hint">Number of container instances</small>
                        </div>
                    }
                </div>
                
                <div class="form-section">
                    <h2>Environment Variables</h2>
                    <p class="form-hint">Add environment variables for your application</p>

                    <div class="info-box" style="background: linear-gradient(135deg, rgba(79, 70, 229, 0.14), rgba(14, 165, 233, 0.08)); border: 1px solid rgba(99, 102, 241, 0.45); padding: 0.95rem 1.1rem; border-radius: 10px; margin-bottom: 0.85rem; color: #e2e8f0; box-shadow: 0 14px 30px rgba(0, 0, 0, 0.22);">
                        @{
                            var projectNetwork = $"{GetProjectName()}-network";
                            var normalizedName = NormalizeResourceName(model.Name);
                            var portText = model.Port.HasValue && model.Port > 0 ? model.Port.Value.ToString() : "&lt;container-port&gt;";
                            var internalUrl = $"http://{normalizedName}:{portText}";
                        }
                        <strong>Project network:</strong> Apps in this project share <code>@projectNetwork</code> for HA traffic. Your app will be reachable by peers at <code>@internalUrl</code> once you set the container port. Copy after you set the port: <button type="button" class="btn btn-icon copy-pill" style="vertical-align: text-bottom;" @onclick="async () => await CopyPreviewAsync(internalUrl)">📋</button>
                    </div>
                    
                    @foreach (var (key, index) in envVars.Select((kv, i) => (kv, i)))
                    {
                        <div class="env-var-row">
                            <input type="text" @bind="key.Key" placeholder="KEY" class="form-control env-key" />
                            <span class="env-separator">=</span>
                            <input type="text" @bind="key.Value" placeholder="value" class="form-control env-value" />
                            <button type="button" class="btn-icon btn-danger" @onclick="() => RemoveEnvVar(index)">🗑️</button>
                        </div>
                    }
                    
                    <button type="button" class="btn btn-secondary" @onclick="AddEnvVar">
                        ➕ Add Variable
                    </button>
                </div>
                
                <div class="form-section">
                    <h2>Network Configuration</h2>
                    <p class="form-hint">Docker networks to connect (optional)</p>
                    
                    @foreach (var (network, index) in networks.Select((n, i) => (n, i)))
                    {
                        <div class="network-row">
                            <input type="text" @bind="networks[index]" placeholder="network-name" class="form-control" />
                            <button type="button" class="btn-icon btn-danger" @onclick="() => RemoveNetwork(index)">🗑️</button>
                        </div>
                    }
                    
                    <button type="button" class="btn btn-secondary" @onclick="AddNetwork">
                        ➕ Add Network
                    </button>
                </div>
                
                <div class="form-actions">
                    <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="Deploy" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span>@(IsEditMode ? "🔄 Saving..." : "🔄 Deploying...")</span>
                        }
                        else
                        {
                            <span>@(IsEditMode ? "💾 Save Changes" : "🚀 Deploy Application")</span>
                        }
                    </button>
                </div>
                
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">
                        ⚠️ @errorMessage
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (showCreateProjectModal)
{
    <div class="modal-backdrop" @onclick="HideCreateProject">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Create New Project</h3>
                <button type="button" class="btn-close" @onclick="HideCreateProject">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="newProjectName">Project Name *</label>
                    <input type="text" id="newProjectName" @bind="newProjectName" class="form-control" placeholder="my-project" autofocus />
                </div>
                <div class="form-group">
                    <label for="newProjectDescription">Description</label>
                    <textarea id="newProjectDescription" @bind="newProjectDescription" class="form-control" rows="3" placeholder="What is this project for?"></textarea>
                </div>
                @if (!string.IsNullOrEmpty(projectErrorMessage))
                {
                    <div class="alert alert-danger">
                        ⚠️ @projectErrorMessage
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="HideCreateProject">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="CreateProject" disabled="@isCreatingProject">
                    @if (isCreatingProject)
                    {
                        <span>Creating...</span>
                    }
                    else
                    {
                        <span>Create Project</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    [Parameter]
    public int? ProjectId { get; set; }

    private bool IsEditMode => Id.HasValue;
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? errorMessage;
    private bool selectedServerIsSwarm = false;
    
    private List<ServerDto>? servers;
    private List<ProjectDto>? projects;
    private List<GitProviderDto>? gitProviders;
    private List<GitRepositoryDto>? gitRepositories;
    private List<string>? gitBranches;
    private int selectedGitProviderId;
    private bool loadingRepos;
    private bool loadingBranches;
    private bool isValidatingCompose;
    private ComposeValidationResultDto? composeValidationResult;

    private void NavigateToDetails()
    {
        if (Id.HasValue)
            Navigation.NavigateTo($"/applications/{Id.Value}");
    }

    private void NavigateToDomains()
    {
        if (Id.HasValue)
