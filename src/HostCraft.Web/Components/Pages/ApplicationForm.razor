    private async Task ValidateCompose()
    {
        if (string.IsNullOrEmpty(model.ComposeFile))
            return;

        try
        {
            isValidatingCompose = true;
            var request = new { composeFile = model.ComposeFile };
            var response = await Http.PostAsJsonAsync("/api/applications/compose/validate", request);
            
            if (response.IsSuccessStatusCode)
            {
                composeValidationResult = await response.Content.ReadFromJsonAsync<ComposeValidationResultDto>();
            }
            else
            {
                composeValidationResult = new ComposeValidationResultDto(
                    false,
                    new List<string> { "Validation request failed" },
                    new List<string>(),
                    new List<string>(),
                    new List<string>(),
                    null
                );
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to validate compose file");
            composeValidationResult = new ComposeValidationResultDto(
                false,
                new List<string> { $"Error: {ex.Message}" },
                new List<string>(),
                new List<string>(),
                new List<string>(),
                null
            );
        }
        finally
        {
            isValidatingCompose = false;
        }
    }}