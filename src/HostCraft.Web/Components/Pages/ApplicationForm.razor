    private async Task Deploy()
    {
        errorMessage = null;
        
        // Validation
        if (string.IsNullOrWhiteSpace(model.Name))
        {
            errorMessage = "Application name is required";
            return;
        }
        
        if (model.ServerId == 0)
        {
            errorMessage = "Please select a server";
            return;
        }
        
        if (model.ProjectId == 0)
        {
            errorMessage = "Please select a project";
            return;
        }

        // Source-specific validation
        if (model.SourceType == "DockerImage")
        {
            if (string.IsNullOrWhiteSpace(model.Image))
            {
                errorMessage = "Docker image is required";
                return;
            }
        }
        else if (model.SourceType == "Git")
        {
            if (selectedGitProviderId == 0)
            {
                errorMessage = "Please select a Git provider";
                return;
            }
            if (string.IsNullOrWhiteSpace(model.GitRepository))
            {
                errorMessage = "Please select a repository";
                return;
            }
            if (string.IsNullOrWhiteSpace(model.GitBranch))
            {
                errorMessage = "Please select a branch";
                return;
            }
        }
        else if (model.SourceType == "DockerCompose")
        {
            if (string.IsNullOrWhiteSpace(model.ComposeFile))
            {
                errorMessage = "Docker Compose file is required";
                return;
            }
            
            if (!selectedServerIsSwarm)
            {
                errorMessage = "Docker Compose deployments require a Swarm manager server";
                return;
            }
        }

        isSubmitting = true;
        StateHasChanged();
        
        try
        {
            // Validate HTTPS email if HTTPS is enabled
            if (model.EnableHttps && !string.IsNullOrWhiteSpace(model.Domain) && string.IsNullOrWhiteSpace(model.LetsEncryptEmail))
            {
                errorMessage = "Let's Encrypt email is required when HTTPS is enabled";
                isSubmitting = false;
                return;
            }
            
            HttpResponseMessage response;

            if (IsEditMode && Id.HasValue)
            {
                // Update existing application
                var registryPassword = string.IsNullOrWhiteSpace(model.RegistryPassword)
                    ? null
                    : model.RegistryPassword;

                var updateRequest = new UpdateApplicationRequest
                {
                    Name = model.Name,
                    Description = model.Description,
                    Port = model.Port,
                    Replicas = model.Replicas,
                    Domain = model.Domain,
                    AdditionalDomains = model.AdditionalDomains,
                    EnableHttps = model.EnableHttps,
                    ForceHttps = model.ForceHttps,
                    LetsEncryptEmail = model.LetsEncryptEmail,
                    DockerImage = model.SourceType == "DockerImage" ? model.Image : null,
                    Dockerfile = model.DockerfilePath,
                    BuildContext = model.BuildContext,
                    DockerBuildTarget = model.DockerBuildTarget,
                    BuildArgs = model.BuildArgs,
                    UsePrivateRegistry = model.UsePrivateRegistry,
                    RegistryServer = string.IsNullOrWhiteSpace(model.RegistryServer) ? null : model.RegistryServer,
                    RegistryUsername = string.IsNullOrWhiteSpace(model.RegistryUsername) ? null : model.RegistryUsername,
                    RegistryPassword = registryPassword,
                    GitRepository = model.GitRepository,
                    GitBranch = model.GitBranch,
                    GitProviderId = model.GitProviderId,
                    AutoDeployOnPush = model.AutoDeployOnPush,
                    EnvironmentVariables = envVars.Where(e => !string.IsNullOrWhiteSpace(e.Key)).ToDictionary(e => e.Key, e => e.Value)
                };

                response = await Http.PutAsJsonAsync($"api/applications/{Id.Value}", updateRequest);
            }
            else
            {
                // Create new application
                if (model.SourceType == "DockerCompose")
                {
                    // Deploy via compose endpoint
                    var composeRequest = new
                    {
                        name = model.Name,
                        description = model.Description,
                        projectId = model.ProjectId,
                        serverId = model.ServerId,
                        composeFile = model.ComposeFile,
                        environmentVariables = model.ComposeEnvironmentVariables
                            .Where(v => !string.IsNullOrWhiteSpace(v.Key))
                            .Select(v => new
                            {
                                key = v.Key,
                                value = v.Value,
                                isSecret = v.IsSecret,
                                description = v.Description
                            })
                            .ToList()
                    };

                    response = await Http.PostAsJsonAsync("api/applications/compose", composeRequest);
                }
                else
                {
                    // Build port mappings from UI
                    var validPortMappings = portMappings
                        .Where(p => p.HostPort.HasValue && p.ContainerPort.HasValue)
                        .Select(p => new PortMappingDto(p.HostPort!.Value, p.ContainerPort!.Value, p.Protocol))
                        .ToList();

                    var request = new CreateApplicationRequest(
                        model.Name,
                        model.ServerId,
                        model.ProjectId,
                        model.SourceType == "DockerImage" ? model.Image : null,
                        model.Replicas,
                        envVars.Where(e => !string.IsNullOrWhiteSpace(e.Key)).ToDictionary(e => e.Key, e => e.Value),
                        networks.Where(n => !string.IsNullOrWhiteSpace(n)).ToList(),
                        validPortMappings.FirstOrDefault()?.ContainerPort, // Legacy port for backwards compatibility
                        validPortMappings.Count > 0 ? validPortMappings : null,
                        model.Domain,
                        model.AdditionalDomains,
                        model.EnableHttps,
                        model.ForceHttps,
                        model.LetsEncryptEmail,
                        model.SourceType,
                        model.GitProviderId,
                        model.GitRepository,
                        model.GitBranch,
                        model.DockerfilePath ?? "Dockerfile",
                        model.BuildContext ?? ".",
                        model.DockerBuildTarget,
                        model.BuildArgs,
                        model.UsePrivateRegistry,
                        string.IsNullOrWhiteSpace(model.RegistryServer) ? null : model.RegistryServer,
                        string.IsNullOrWhiteSpace(model.RegistryUsername) ? null : model.RegistryUsername,
                        string.IsNullOrWhiteSpace(model.RegistryPassword) ? null : model.RegistryPassword,
                        model.CloneSubmodules,
                        model.EnableGitLfs,
                        model.AutoDeployOnPush,
                        model.EnablePreviewDeployments,
                        model.PreviewUrlTemplate
                    );

                    response = await Http.PostAsJsonAsync("api/applications", request);
                }
            }

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo(GetPostActionDestination());
            }
            else
            {
                // Try to get error details from response
                try
                {
                    var errorContent = await response.Content.ReadAsStringAsync();
                    var errorObj = System.Text.Json.JsonSerializer.Deserialize<ErrorResponse>(errorContent,
                        new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    errorMessage = errorObj?.Error ?? $"Failed to deploy application (Status: {response.StatusCode})";
                }
                catch
                {
                    errorMessage = $"Failed to deploy application (Status: {response.StatusCode})";
                }
                Logger.LogWarning("Deployment failed with status {StatusCode}", response.StatusCode);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deploying application");
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }
    
