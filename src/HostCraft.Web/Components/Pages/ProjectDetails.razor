    }

    .replica-input {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        flex-wrap: wrap;
    }

    .replica-input input[type="number"] {
        width: 80px;
        padding: 0.35rem 0.5rem;
        border-radius: 0.4rem;
        border: 1px solid #334155;
        background: #0f172a;
        color: #e2e8f0;
    }

    .btn-apply {
        padding: 0.5rem 1rem;
        font-size: 0.9rem;
    }

    .placement-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 0.75rem;
    }

    .placement-card {
        border: 1px solid #334155;
        border-radius: 0.6rem;
        padding: 0.6rem 0.7rem;
        background: #0b1220;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .placement-row {
        display: flex;
