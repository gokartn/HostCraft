@page "/projects/{ProjectId:int}"
@rendermode InteractiveServer
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ILogger<ProjectDetails> Logger
@using System.Linq
@using System.Threading.Tasks

<div class="page-container">
    @if (isLoading)
    {
        <div class="loading-spinner">
            <div class="spinner"></div>
            <p>Loading project...</p>
        </div>
    }
    else if (project == null)
    {
        <div class="error-state">
            <h2>Project Not Found</h2>
            <p>The requested project could not be found.</p>
            <button class="btn btn-primary" @onclick="NavigateToProjects">
                Back to Projects
            </button>
        </div>
    }
    else
    {
        <div class="page-header">
            <div class="header-left">
                <div class="breadcrumb">
                    <a href="/projects">Projects</a>
                    <span>/</span>
                    <span>@project.Name</span>
                </div>
                <h1>@project.Name</h1>
                @if (!string.IsNullOrEmpty(project.Description))
                {
                    <p class="subtitle">@project.Description</p>
                }
            </div>
            <div class="header-actions">
                <button class="btn btn-secondary" @onclick="RefreshProject">
                    🔄 Refresh
                </button>
                <button class="btn btn-secondary" @onclick="NavigateToDatabaseTemplates">
                    ⚡ Deploy Template
                </button>
                <button class="btn btn-primary" @onclick="NavigateToCreateApp">
                    ➕ New Application
                </button>
            </div>
        </div>

        @if (applications == null || !applications.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">📦</div>
                <h2>No Applications</h2>
                <p>Deploy your first application in this project</p>
                <button class="btn btn-primary" @onclick="NavigateToCreateApp">
                    ➕ Deploy Application
                </button>
                <button class="btn btn-secondary" @onclick="NavigateToDatabaseTemplates">
                    ⚡ Deploy Template
                </button>
            </div>
        }
        else
        {
            <div class="apps-grid">
                @foreach (var app in applications)
                {
                    <div class="app-card @GetStatusClass(app.Status)">
                        <div class="app-header">
                            <div class="app-name">
                                <h3>@app.Name</h3>
                                @if (!string.IsNullOrEmpty(app.Description))
                                {
                                    <span class="app-description">@app.Description</span>
                                }
                            </div>
                            <span class="status-badge @GetStatusClass(app.Status)">
                                @GetStatusIcon(app.Status)
                            </span>
                        </div>

                        <div class="app-info">
                            <div class="info-item">
                                <span class="label">Image</span>
                                <span class="value">@app.DockerImage</span>
                            </div>
                            <div class="info-item">
                                <span class="label">Server</span>
                                <span class="value">@app.ServerName</span>
                            </div>
                            @if (!string.IsNullOrEmpty(app.ServiceId))
                            {
                                <div class="info-item">
                                    <span class="label">Mode</span>
                                    <span class="value">🐝 Swarm Service</span>
                                </div>
                                @if (app.SwarmReplicas.HasValue)
                                {
                                    <div class="info-item">
                                        <span class="label">Replicas</span>
                                        <span class="value">@app.RunningReplicas/@app.SwarmReplicas</span>
                                    </div>
                                }
                            }
                            else if (!string.IsNullOrEmpty(app.ContainerId))
                            {
                                <div class="info-item">
                                    <span class="label">Mode</span>
                                    <span class="value">📦 Container</span>
                                </div>
                            }
                            @if (app.LastDeployedAt.HasValue)
                            {
                                <div class="info-item">
                                    <span class="label">Deployed</span>
                                    <span class="value">@app.LastDeployedAt.Value.ToString("MM/dd HH:mm")</span>
                                </div>
                            }
                        </div>

                        <div class="app-actions">
                            <button class="btn-icon" @onclick="() => ViewDetails(app.Id)" title="View Details">
                                👁️
                            </button>
                            @if (!string.IsNullOrEmpty(app.ContainerId) || !string.IsNullOrEmpty(app.ServiceId))
                            {
                                <button class="btn-icon" @onclick="() => ViewLogs(app.Id)" title="Logs">
                                    📄
                        @if (!string.IsNullOrEmpty(app.ServiceId))
                        {
                            var badges = GetNodeBadges(app.Id).ToList();
                            if (badges.Any())
                            {
                                <div class="node-badges">
                                    @foreach (var node in badges)
                                    {
                                        <span class="chip chip-node">
                                            <span class="chip-label">@node.NodeName</span>
                                            <span class="chip-meta">@node.Role</span>
                                            <span class="chip-meta">@node.Availability</span>
                                        </span>
                                    }
                                </div>
                            }
                        }
                                </button>
                            }
                            <button class="btn-icon btn-primary" @onclick="() => Redeploy(app.Id)" title="Redeploy">
                                🔄
                            </button>
                            <button class="btn-icon btn-danger" @onclick="() => DeleteApplication(app.Id)" title="Delete">
                                🗑️
                            </button>
                        </div>

                        @if (!string.IsNullOrEmpty(app.ServiceId))
                        {
                            <div class="replica-control">
                                <div class="replica-header">
                                    <span class="label">Replicas</span>
                                    <span class="value">Desired: @GetDesired(app.Id) · Running: @app.RunningReplicas</span>
                                </div>
                                <div class="replica-input">
                                    <button class="chip" @onclick="() => AdjustDesired(app.Id, -1)" disabled="GetDesired(app.Id) <= 1">➖</button>
                                    <input type="number" min="1" value="@GetDesired(app.Id)" @onchange="e => OnDesiredChange(app.Id, e)" />
                                    <button class="chip" @onclick="() => AdjustDesired(app.Id, 1)">➕</button>
                                    <button class="btn btn-primary btn-apply" @onclick="() => ApplyScale(app.Id)" disabled="scalingApps.Contains(app.Id)">
                                        @(scalingApps.Contains(app.Id) ? "Scaling..." : "Apply")
                                    </button>
                                </div>

                                <div class="placement-grid">
                                    @if (appStatuses.TryGetValue(app.Id, out var status) && status.Placements.Any())
                                    {
                                        @foreach (var placement in status.Placements.OrderBy(p => p.Slot))
                                        {
                                            <div class="placement-card">
                                                <div class="placement-row">
                                                    <span class="node">@placement.NodeName</span>
                                                    <span class="badge">@placement.Role</span>
                                                </div>
                                                <div class="placement-row">
                                                    <span class="state">@placement.CurrentState</span>
                                                    <span class="availability">@placement.Availability</span>
                                                </div>
                                                <div class="placement-row meta">
                                                    <span>Slot @placement.Slot</span>
                                                    @if (!string.IsNullOrWhiteSpace(placement.Error))
                                                    {
                                                        <span class="error">@placement.Error</span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="muted">Placement data not available yet.</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public int ProjectId { get; set; }

    private ProjectDto? project;
    private List<ApplicationDto>? applications;
    private bool isLoading = true;
    private Dictionary<int, ApplicationStatusView> appStatuses = new();
    private Dictionary<int, int> desiredReplicas = new();
    private HashSet<int> scalingApps = new();
    private HashSet<int> pendingStatusPolls = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadProject();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadProject();
    }

    private async Task LoadProject()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            project = await Http.GetFromJsonAsync<ProjectDto>($"api/projects/{ProjectId}");
            applications = await Http.GetFromJsonAsync<List<ApplicationDto>>($"api/applications?projectId={ProjectId}");

            if (project != null && IsGlobalSystemProject(project))
            {
                Navigation.NavigateTo("/deployments/global", forceLoad: true);
                return;
            }

            InitializeReplicaState();
            await LoadStatusesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading project");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshProject()
    {
        await LoadProject();
    }

    private void NavigateToCreateApp()
    {
        Navigation.NavigateTo($"/projects/{ProjectId}/applications/new");
    }

    private void NavigateToProjects()
    {
        Navigation.NavigateTo("/projects");
    }

    private void NavigateToDatabaseTemplates()
    {
        Navigation.NavigateTo($"/templates?projectId={ProjectId}");
    }

    private void ViewDetails(int appId)
    {
        Navigation.NavigateTo($"/applications/{appId}");
    }

    private void ViewLogs(int appId)
    {
        Navigation.NavigateTo($"/applications/{appId}/logs");
    }

    private async Task Redeploy(int appId)
    {
        try
        {
            var response = await Http.PostAsync($"api/applications/{appId}/deploy", null);
            if (response.IsSuccessStatusCode)
            {
                await LoadProject();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error redeploying application");
        }
    }

    private async Task DeleteApplication(int appId)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/applications/{appId}");
            if (response.IsSuccessStatusCode)
            {
                await LoadProject();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting application");
        }
    }

    private async Task ScaleUp(int appId)
    {
        try
        {
            var app = applications?.FirstOrDefault(a => a.Id == appId);
            if (app != null)
            {
                AdjustDesired(appId, 1);
                await ApplyScale(appId);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error scaling up application");
        }
    }

    private async Task ScaleDown(int appId)
    {
        try
        {
            var app = applications?.FirstOrDefault(a => a.Id == appId);
            if (app != null)
            {
                AdjustDesired(appId, -1);
                await ApplyScale(appId);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error scaling down application");
        }
    }

    private void InitializeReplicaState()
    {
        desiredReplicas.Clear();
        if (applications == null)
            return;

        foreach (var app in applications.Where(a => !string.IsNullOrEmpty(a.ServiceId)))
        {
            desiredReplicas[app.Id] = app.SwarmReplicas ?? 1;
        }
    }

    private async Task LoadStatusesAsync()
    {
        appStatuses.Clear();

        if (applications == null)
            return;

        var tasks = applications
            .Where(a => !string.IsNullOrEmpty(a.ServiceId))
            .Select(async app =>
            {
                try
                {
                    var status = await Http.GetFromJsonAsync<ApplicationStatusView>($"api/applications/{app.Id}/status");
                    if (status != null)
                    {
                        appStatuses[app.Id] = status;
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to load status for app {AppId}", app.Id);
                }
            });

        await Task.WhenAll(tasks);
        StateHasChanged();
    }

    private int GetDesired(int appId)
    {
        return desiredReplicas.TryGetValue(appId, out var replicas) ? replicas : 1;
    }

    private void OnDesiredChange(int appId, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value))
        {
            desiredReplicas[appId] = Math.Max(1, value);
        }
    }

    private void AdjustDesired(int appId, int delta)
    {
        desiredReplicas.TryGetValue(appId, out var current);
        var next = Math.Max(1, current + delta);
        desiredReplicas[appId] = next;
    }

    private async Task ApplyScale(int appId)
    {
        if (scalingApps.Contains(appId))
            return;

        scalingApps.Add(appId);
        StateHasChanged();

        try
        {
            var replicas = GetDesired(appId);
            var response = await Http.PostAsync($"api/applications/{appId}/scale?replicas={replicas}", null);
            if (response.IsSuccessStatusCode)
            {
                await LoadProject();
                await LoadStatusesAsync();
                _ = PollStatusLater(appId, TimeSpan.FromSeconds(5));
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error applying scale for app {AppId}", appId);
        }
        finally
        {
            scalingApps.Remove(appId);
            StateHasChanged();
        }
    }

    private IEnumerable<(string NodeName, string Role, string Availability)> GetNodeBadges(int appId)
    {
        if (appStatuses.TryGetValue(appId, out var status) && status.Placements != null)
        {
            return status.Placements
                .GroupBy(p => p.NodeId)
                .Select(g =>
                {
                    var first = g.First();
                    return (first.NodeName, first.Role, first.Availability);
                });
        }

        return Enumerable.Empty<(string, string, string)>();
    }

    private async Task PollStatusLater(int appId, TimeSpan delay)
    {
        if (pendingStatusPolls.Contains(appId))
            return;

        pendingStatusPolls.Add(appId);
        try
        {
            await Task.Delay(delay);
            await LoadSingleStatusAsync(appId);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Deferred status poll failed for app {AppId}", appId);
        }
        finally
        {
            pendingStatusPolls.Remove(appId);
        }
    }

    private async Task LoadSingleStatusAsync(int appId)
    {
        try
        {
            var status = await Http.GetFromJsonAsync<ApplicationStatusView>($"api/applications/{appId}/status");
            if (status != null)
            {
                appStatuses[appId] = status;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed single status refresh for app {AppId}", appId);
        }
    }

    private string GetStatusClass(DeploymentStatus status) => status switch
    {
        DeploymentStatus.Running => "status-running",
        DeploymentStatus.Success => "status-success",
        DeploymentStatus.Failed => "status-failed",
        DeploymentStatus.Queued => "status-queued",
        DeploymentStatus.Cancelled => "status-cancelled",
        _ => "status-unknown"
    };

    private string GetStatusIcon(DeploymentStatus status) => status switch
    {
        DeploymentStatus.Running => "🔄",
        DeploymentStatus.Success => "✅",
        DeploymentStatus.Failed => "❌",
        DeploymentStatus.Queued => "⏳",
        DeploymentStatus.Cancelled => "🚫",
        _ => "⚪"
    };

    private static bool IsGlobalSystemProject(ProjectDto project) =>
        string.Equals(project.Name, SystemProjects.GlobalDeployments, StringComparison.OrdinalIgnoreCase);

    private record ProjectDto(int Id, string Name, string? Description, DateTime CreatedAt);

    private record ApplicationDto(
        int Id,
        string Name,
        string? Description,
        int ServerId,
        string ServerName,
        int ProjectId,
        string ProjectName,
        string? DockerImage,
        bool UsePrivateRegistry,
        string? RegistryServer,
        string? RegistryUsername,
        bool HasRegistryPassword,
        DeploymentStatus Status,
        string? ContainerId,
        string? ServiceId,
        DateTime? LastDeployedAt,
        DateTime CreatedAt,
        int? SwarmReplicas,
        int? RunningReplicas
    );

    private record ApplicationStatusView(
        int ApplicationId,
        string Status,
        bool IsRunning,
        string? ActualState,
        string? ContainerId,
        string? ServiceId,
        List<ReplicaPlacementView> Placements
    );

    private record ReplicaPlacementView(
        string TaskId,
        string NodeId,
        string NodeName,
        string Role,
        string Availability,
        string DesiredState,
        string CurrentState,
        string? Error,
        int Slot,
        DateTime? UpdatedAt
    );
}

<style>
