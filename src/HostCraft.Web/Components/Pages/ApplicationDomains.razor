</style>

@code {
    [Parameter]
    public int Id { get; set; }

    private ApplicationInfo? app;
    private List<DomainInfo> domains = new();
    private Dictionary<string, DomainCertificateStatus> certificateStatuses = new();
    private bool isLoading = true;
    private bool isValidating = false;
    private bool isSaving = false;
    private bool isCheckingCerts = false;
    private string activeTab = "Domains";

    // Modal state
    private bool showDomainModal = false;
    private DomainInfo? editingDomain;
    private DomainFormModel domainForm = new();
    private string? errorMessage;
    private bool IsTcpProtocol => domainForm.Protocol == ProxyProtocol.Tcp;

    private record PagedResult<T>(IEnumerable<T> Items, int TotalCount, int Page, int PageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            app = await Http.GetFromJsonAsync<ApplicationInfo>($"api/applications/{Id}");

            // Domains API returns a paged envelope; unwrap Items to avoid JSON shape mismatches
            var domainsResponse = await Http.GetFromJsonAsync<PagedResult<DomainInfo>>($"api/applications/{Id}/domains?paged=false");
            domains = domainsResponse?.Items?.ToList() ?? new();
            
            // Load certificate statuses for HTTPS domains
            await LoadCertificateStatuses();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading application domains");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadCertificateStatuses()
    {
        if (domains.Count == 0 || app == null) return;
        
        try
        {
            isCheckingCerts = true;
            var httpsEnabledDomains = domains.Where(d => d.HttpsEnabled).Select(d => d.Host).ToList();
            if (httpsEnabledDomains.Count > 0)
            {
                // For demo purposes, create mock statuses based on domain patterns
                // TODO: Replace with actual server calls when we have server context
                foreach (var domain in httpsEnabledDomains)
                {
                    var status = new DomainCertificateStatus
                    {
                        Domain = domain,
                        Status = domain.Contains("rate") ? "rate_limited" : 
                                domain.Contains("error") ? "acme_error" :
                                domain.Contains("pending") ? "pending" : "valid",
                        LastChecked = DateTime.UtcNow,
                        ErrorMessage = domain.Contains("rate") ? "Let's Encrypt rate limited. Retry after tomorrow." : null
                    };
                    certificateStatuses[domain] = status;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading certificate statuses");
        }
        finally
        {
            isCheckingCerts = false;
        }
    }

    private async Task CheckCertificateStatus(DomainInfo domain)
    {
        try
        {
            isCheckingCerts = true;
            StateHasChanged();
            
            // Mock status check - replace with actual service call when server context is available
            var status = new DomainCertificateStatus
            {
                Domain = domain.Host,
                Status = "pending", // This would come from actual Traefik logs
                LastChecked = DateTime.UtcNow,
                ErrorMessage = "Checking certificate status..."
            };
            certificateStatuses[domain.Host] = status;
            
            // Simulate checking delay
            await Task.Delay(2000);
            
            // Update with "result"
            status.Status = "valid";
            status.ErrorMessage = null;
            certificateStatuses[domain.Host] = status;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error checking certificate status for {Domain}", domain.Host);
        }
        finally
        {
            isCheckingCerts = false;
            StateHasChanged();
        }
    }

    private void ShowAddDomainModal()
    {
        editingDomain = null;
        var defaultPort = GetDefaultPort();
        var defaultProtocol = GetDefaultProtocol(defaultPort);

        domainForm = new DomainFormModel
        {
            Port = defaultPort,
            HttpsEnabled = defaultProtocol == ProxyProtocol.Http,
            ForceHttps = defaultProtocol == ProxyProtocol.Http,
            CertificateType = "letsencrypt",
            IsPrimary = domains.Count == 0,
            WebSocketEnabled = defaultProtocol == ProxyProtocol.Http,
            CompressionEnabled = defaultProtocol == ProxyProtocol.Http,
            Path = "/",
            Protocol = defaultProtocol
        };

        NormalizeDomainFormForProtocol();
        errorMessage = null;
        showDomainModal = true;
    }

    private void EditDomain(DomainInfo domain)
    {
        editingDomain = domain;
        domainForm = new DomainFormModel
        {
            Host = domain.Host,
            Path = domain.Path,
            Port = domain.Port,
            HttpsEnabled = domain.HttpsEnabled,
            ForceHttps = domain.ForceHttps,
            CertificateType = domain.CertificateType,
            IsPrimary = domain.IsPrimary,
            WebSocketEnabled = domain.WebSocketEnabled,
            CompressionEnabled = domain.CompressionEnabled,
            StripPathPrefix = domain.StripPathPrefix,
            RateLimitRps = domain.RateLimitRps,
            MaxBodySizeMb = domain.MaxBodySizeMb,
            IpWhitelist = domain.IpWhitelist,
            BasicAuthEnabled = domain.BasicAuthEnabled,
            BasicAuthUsers = domain.BasicAuthUsers,
            Protocol = domain.Protocol
        };
        errorMessage = null;
        NormalizeDomainFormForProtocol();
        showDomainModal = true;
    }

    private void CloseDomainModal()
    {
        showDomainModal = false;
        editingDomain = null;
        errorMessage = null;
    }

    private async Task SaveDomain()
    {
        if (string.IsNullOrWhiteSpace(domainForm.Host))
        {
            errorMessage = "Domain host is required";
            return;
        }

        NormalizeDomainFormForProtocol();

        isSaving = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            HttpResponseMessage response;

            if (editingDomain == null)
            {
                // Create new domain
                response = await Http.PostAsJsonAsync($"api/applications/{Id}/domains/add", domainForm);
            }
            else
            {
                // Update existing domain
                response = await Http.PutAsJsonAsync($"api/applications/{Id}/domains/{editingDomain.Id}", domainForm);
            }

            if (response.IsSuccessStatusCode)
            {
                CloseDomainModal();
                await LoadData();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                errorMessage = error?.Error ?? "Failed to save domain";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving domain");
            errorMessage = "An error occurred while saving";
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private ProxyProtocol GetDefaultProtocol(int? requestedPort = null)
    {
        if (app?.DatabaseType != null)
        {
            return app.DatabaseType.Value switch
            {
                DatabaseType.Clickhouse => ProxyProtocol.Http,
                _ => ProxyProtocol.Tcp
            };
        }

        var portToInspect = requestedPort ?? app?.Port ?? app?.PublishedPort;

        if (portToInspect.HasValue)
        {
            return portToInspect.Value switch
            {
                80 or 443 or 8080 or 3000 => ProxyProtocol.Http,
                5432 or 5433 or 3306 or 6379 or 6380 or 27017 => ProxyProtocol.Tcp,
                _ => ProxyProtocol.Http
            };
        }

        return ProxyProtocol.Http;
    }

    private int GetDefaultPort()
    {
        if (app?.Port.HasValue == true)
        {
            return app.Port.Value;
        }

        if (app?.PublishedPort.HasValue == true)
        {
            return app.PublishedPort.Value;
        }

        return 80;
    }

    private void NormalizeDomainFormForProtocol()
    {
        if (domainForm.Protocol == ProxyProtocol.Tcp)
        {
            domainForm.Path = "/";
            domainForm.HttpsEnabled = false;
            domainForm.ForceHttps = false;
            domainForm.WebSocketEnabled = false;
            domainForm.CompressionEnabled = false;
            domainForm.StripPathPrefix = false;
            domainForm.BasicAuthEnabled = false;
            domainForm.BasicAuthUsers = null;
            domainForm.CertificateType = "none";
        }

        if (domainForm.Port <= 0)
        {
            domainForm.Port = GetDefaultPort();
        }
    }

    private async Task DeleteDomain(DomainInfo domain)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/applications/{Id}/domains/{domain.Id}");
            if (response.IsSuccessStatusCode)
            {
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting domain");
        }
    }

    private async Task ValidateDns(DomainInfo domain)
    {
        isValidating = true;
        StateHasChanged();

        try
        {
            var response = await Http.PostAsync($"api/applications/{Id}/domains/{domain.Id}/validate-dns", null);
            await LoadData();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error validating DNS");
        }
        finally
        {
            isValidating = false;
            StateHasChanged();
        }
    }

    private void OnProtocolChanged()
    {
        NormalizeDomainFormForProtocol();
        StateHasChanged();
    }

    // DTOs
    private record ApplicationInfo(
        int Id,
        string Name,
        string? Description,
        int? Port,
        int? PublishedPort,
        DatabaseType? DatabaseType
    );

    private record DomainInfo(
        int Id,
        Guid Uuid,
        int ApplicationId,
        string Host,
        string Path,
        int Port,
        bool HttpsEnabled,
        bool ForceHttps,
        string CertificateType,
        string DnsStatus,
        string? DnsError,
        DateTime? LastDnsCheck,
        bool IsPrimary,
        bool WebSocketEnabled,
        bool CompressionEnabled,
        bool BasicAuthEnabled,
        string? BasicAuthUsers,
        int RateLimitRps,
        string? IpWhitelist,
        int MaxBodySizeMb,
        bool StripPathPrefix,
        bool PathBasedRouting,
        bool IsActive,
        ProxyProtocol Protocol,
        string Url,
        DateTime CreatedAt,
        DateTime? UpdatedAt
    );

    private class DomainFormModel
    {
        public string Host { get; set; } = "";
        public string Path { get; set; } = "/";
        public int Port { get; set; } = 80;
        public bool HttpsEnabled { get; set; } = true;
        public bool ForceHttps { get; set; } = true;
        public string CertificateType { get; set; } = "letsencrypt";
        public bool IsPrimary { get; set; }
        public bool WebSocketEnabled { get; set; } = true;
        public bool CompressionEnabled { get; set; } = true;
        public bool StripPathPrefix { get; set; }
        public int RateLimitRps { get; set; }
        public int MaxBodySizeMb { get; set; }
        public string? IpWhitelist { get; set; }
        public bool BasicAuthEnabled { get; set; }
        public string? BasicAuthUsers { get; set; }
        public ProxyProtocol Protocol { get; set; } = ProxyProtocol.Http;
    }

    private record ErrorResponse(string? Error);

