@page "/applications/{Id:int}/domains"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using HostCraft.Core.Interfaces
@using HostCraft.Core.Models
@using HostCraft.Infrastructure.Services
@using HostCraft.Core.Enums
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ILogger<ApplicationDomains> Logger
@inject ICertificateStatusService CertificateStatusService

<div class="page-container">
    @if (isLoading)
    {
        <div class="loading-spinner">
            <div class="spinner"></div>
            <p>Loading domains...</p>
        </div>
    }
    else if (app == null)
    {
        <div class="empty-state">
            <div class="empty-icon">-</div>
            <h2>Application Not Found</h2>
            <button class="btn btn-primary" @onclick="BackToApplications">
                Back to Applications
            </button>
        </div>
    }
    else
    {
        <div class="page-header">
            <div class="header-left">
                <h1>@app.Name</h1>
                <p class="subtitle">Manage domains and SSL certificates</p>
            </div>
            <div class="header-actions">
                <button class="btn btn-secondary" @onclick="NavigateToDetails">
                    Back to Details
                </button>
            </div>
        </div>

        @* Tab Navigation *@
        <div class="tabs-container">
            <button class="tab @(activeTab == "General" ? "active" : "")" @onclick="NavigateToDetails">General</button>
            <button class="tab @(activeTab == "Edit" ? "active" : "")" @onclick="NavigateToEdit">Edit</button>
            <button class="tab active">Domains</button>
            <button class="tab @(activeTab == "Advanced" ? "active" : "")" @onclick="NavigateToAdvanced">Advanced</button>
            <button class="tab @(activeTab == "Logs" ? "active" : "")" @onclick="NavigateToLogs">Logs</button>
        </div>

        <div class="card">
            <div class="card-header domains-header">
                <div>
                    <h3>Domains</h3>
                    <p class="text-muted">Domains are used to access the application</p>
                </div>
                <button class="btn btn-primary" @onclick="ShowAddDomainModal">
                    + Add Domain
                </button>
            </div>

            @if (domains.Count == 0)
            {
                <div class="empty-state">
                    <p>No domains configured. Add a domain to make your application accessible.</p>
                </div>
            }
            else
            {
                <div class="domains-list">
                    @foreach (var domain in domains)
                    {
                        <div class="domain-item">
                            <div class="domain-actions-left">
                                @if (domain.DnsStatus == "valid")
                                {
                                    <span class="dns-status valid" title="DNS Validated">V</span>
                                }
                                else if (domain.DnsStatus == "invalid")
                                {
                                    <span class="dns-status invalid" title="DNS Invalid">X</span>
                                }
                                else
                                {
                                    <span class="dns-status pending" title="DNS Pending">?</span>
                                }
                                <button class="btn-icon" @onclick="() => EditDomain(domain)" title="Edit">E</button>
                                <button class="btn-icon danger" @onclick="() => DeleteDomain(domain)" title="Delete">D</button>
                            </div>

                            <div class="domain-info">
                                <div class="domain-host">
                                    <a href="@domain.Url" target="_blank" class="domain-link">
                                        @domain.Host
                                        <span class="external-link">^</span>
                                    </a>
                                    @if (domain.IsPrimary)
                                    {
                                        <span class="badge primary">Primary</span>
                                    }
                                </div>

                                <div class="domain-tags">
                                    <span class="tag">Path: @domain.Path</span>
                                    <span class="tag">Port: @domain.Port</span>
                                    <span class="tag">Protocol: @domain.Protocol</span>
                                    @if (domain.HttpsEnabled)
                                    {
                                        <span class="tag https">HTTPS</span>
                                        @if (certificateStatuses.TryGetValue(domain.Host, out var certStatus))
                                        {
                                            <span class="certificate-status @certStatus.GetStatusClass()" title="@certStatus.ErrorMessage">
                                                @certStatus.GetDisplayStatus()
                                                @if (certStatus.RetryAfter.HasValue)
                                                {
                                                    <small>(Retry: @certStatus.RetryAfter.Value.ToString("HH:mm UTC"))</small>
                                                }
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="certificate-status checking">🔍 Checking...</span>
                                        }
                                    }
                                    <span class="tag cert">Cert: @domain.CertificateType</span>
                                    <button class="tag-btn validate" @onclick="() => ValidateDns(domain)" disabled="@isValidating">
                                        Validate DNS
                                    </button>
                                    <button class="tag-btn cert-check" @onclick="() => CheckCertificateStatus(domain)" disabled="@isCheckingCerts">
                                        🔍 Check SSL
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Add/Edit Domain Modal *@
        @if (showDomainModal)
        {
            <div class="modal-overlay" @onclick="CloseDomainModal">
                <div class="modal" @onclick:stopPropagation="true">
                    <div class="modal-header">
                        <h3>@(editingDomain == null ? "Add Domain" : "Edit Domain")</h3>
                        <button class="btn-close" @onclick="CloseDomainModal">X</button>
                    </div>
                    <div class="modal-body">
                        <div class="form-group">
                            <label>Domain Host *</label>
                            <input type="text" @bind="domainForm.Host" placeholder="app.example.com" class="form-control" />
                            <small>Enter the domain name without protocol (e.g., app.example.com)</small>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Path</label>
                                <input type="text" @bind="domainForm.Path" placeholder="/" class="form-control" readonly="@IsTcpProtocol" />
                            </div>
                            <div class="form-group">
                                <label>Port</label>
                                <input type="number" @bind="domainForm.Port" class="form-control" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Certificate Type</label>
                            <select @bind="domainForm.CertificateType" class="form-control" disabled="@IsTcpProtocol">
                                <option value="letsencrypt">Let's Encrypt (Automatic)</option>
                                <option value="custom">Custom Certificate</option>
                                <option value="none">None (HTTP only)</option>
                            </select>
                            @if (IsTcpProtocol)
                            {
                                <small>Traefik passthrough requires managing TLS certificates inside the database service.</small>
                            }
                        </div>

                        <div class="form-group">
                            <label>Router Protocol</label>
                            <select @bind="domainForm.Protocol" @bind:after="OnProtocolChanged" class="form-control">
                                <option value="@ProxyProtocol.Http">HTTP</option>
                                <option value="@ProxyProtocol.Tcp">TCP</option>
                            </select>
                            <small>Use TCP for direct database protocols (e.g., PostgreSQL, MySQL, Redis).</small>
                        </div>

                        <div class="form-row checkboxes">
                            <label class="checkbox-label">
                                <input type="checkbox" @bind="domainForm.HttpsEnabled" disabled="@IsTcpProtocol" />
                                Enable HTTPS
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" @bind="domainForm.ForceHttps" disabled="@(!domainForm.HttpsEnabled || IsTcpProtocol)" />
                                Force HTTPS Redirect
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" @bind="domainForm.IsPrimary" />
                                Primary Domain
                            </label>
                        </div>

                        <details class="advanced-options">
                            <summary>Advanced Options</summary>
                            <div class="advanced-content">
                                <div class="form-row checkboxes">
                                    <label class="checkbox-label">
                                        <input type="checkbox" @bind="domainForm.WebSocketEnabled" disabled="@IsTcpProtocol" />
                                        WebSocket Support
                                    </label>
                                    <label class="checkbox-label">
                                        <input type="checkbox" @bind="domainForm.CompressionEnabled" disabled="@IsTcpProtocol" />
                                        Compression
                                    </label>
                                    <label class="checkbox-label">
                                        <input type="checkbox" @bind="domainForm.StripPathPrefix" disabled="@IsTcpProtocol" />
                                        Strip Path Prefix
                                    </label>
                                </div>

                                <div class="form-group">
                                    <label>Rate Limit (requests/second, 0 = unlimited)</label>
                                    <input type="number" @bind="domainForm.RateLimitRps" class="form-control" />
                                </div>

                                <div class="form-group">
                                    <label>Max Body Size (MB, 0 = default)</label>
                                    <input type="number" @bind="domainForm.MaxBodySizeMb" class="form-control" />
                                </div>

                                <div class="form-group">
                                    <label>IP Whitelist (comma-separated CIDRs)</label>
                                    <input type="text" @bind="domainForm.IpWhitelist" placeholder="10.0.0.0/8, 192.168.0.0/16" class="form-control" />
                                </div>

                                <div class="form-group">
                                    <label class="checkbox-label">
                                        <input type="checkbox" @bind="domainForm.BasicAuthEnabled" disabled="@IsTcpProtocol" />
                                        Enable Basic Auth
                                    </label>
                                    @if (domainForm.BasicAuthEnabled)
                                    {
                                        <input type="text" @bind="domainForm.BasicAuthUsers" placeholder="user1:pass1,user2:pass2" class="form-control" style="margin-top: 0.5rem;" disabled="@IsTcpProtocol" />
                                    }
                                </div>
                            </div>
                        </details>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-error">@errorMessage</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CloseDomainModal">Cancel</button>
                        <button class="btn btn-primary" @onclick="SaveDomain" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span>Saving...</span>
                            }
                            else
                            {
                                <span>@(editingDomain == null ? "Add Domain" : "Save Changes")</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        }
    }
</div>

<style>
