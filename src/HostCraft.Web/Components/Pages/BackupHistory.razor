@page "/backups/history"
@rendermode InteractiveServer
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject ILogger<BackupHistory> Logger
@using System.Text.Json

<PageTitle>Backup History - HostCraft</PageTitle>

<div class="backup-history-page">
    <section class="hero-panel">
        <div class="hero-copy">
            <p class="eyebrow">Data recovery & system restoration</p>
            <h1>Backup History</h1>
            <p class="subtitle">View, download, and restore system-wide backups with integrity verification.</p>
            <div class="hero-tags">
                <span class="tag">Verified</span>
                <span class="tag">Downloadable</span>
                <span class="tag">Restorable</span>
            </div>
        </div>
        <div class="hero-metrics">
            <div class="metric-card">
                <span>Total Backups</span>
                <strong>@backups.Count</strong>
                <p>System snapshots</p>
            </div>
            <div class="metric-card">
                <span>Storage Used</span>
                <strong>@FormatBytes(backups.Sum(b => b.SizeBytes))</strong>
                <p>Total size</p>
            </div>
            <div class="metric-card">
                <span>Latest</span>
                <strong>@(backups.Any() ? backups.First().CreatedAt.ToString("MMM d") : "N/A")</strong>
                <p>Most recent</p>
            </div>
        </div>
    </section>

    @if (loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading backups...</p>
        </div>
    }
    else if (error != null)
    {
        <div class="error-banner">
            <span class="icon">❌</span>
            <div>
                <strong>Error loading backups</strong>
                <p>@error</p>
            </div>
            <button class="btn btn-secondary" @onclick="LoadBackups">Retry</button>
        </div>
    }
    else
    {
        <section class="filters-panel">
            <div>
                <h2>System Backups</h2>
                <p>Download backups to your computer for offline storage or restoration on another instance.</p>
            </div>
            <div class="filter-actions">
                <button class="btn btn-primary" @onclick="@(() => NavigationManager.NavigateTo("/backups"))">
                    <span class="icon">➕</span>
                    Create New Backup
                </button>
            </div>
        </section>

        @if (backups.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">📦</div>
                <h3>No backups yet</h3>
                <p>Create your first system backup to protect your HostCraft configuration and data.</p>
                <div class="mt-4">
                    <button class="btn btn-primary btn-lg" @onclick="@(() => NavigationManager.NavigateTo("/backups"))">
                        <span class="icon">➕</span>
                        Create Backup
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="backups-grid">
                @foreach (var backup in backups)
                {
                    <article class="backup-card @(backup.Status == "Success" ? "" : "warning")">
                        <div class="card-accent"></div>
                        <div class="backup-header">
                            <div class="backup-icon">
                                @GetBackupIcon(backup.Status)
                            </div>
                            <div class="backup-info">
                                <h3>System Backup #@backup.Id</h3>
                                <span class="backup-date">@backup.CreatedAt.ToString("MMMM dd, yyyy 'at' HH:mm")</span>
                            </div>
                            <div class="backup-status">
                                <span class="status-pill @backup.Status.ToLower()">@backup.Status</span>
                                @if (backup.IsVerified)
                                {
                                    <span class="verified-badge" title="Integrity verified">✓ Verified</span>
                                }
                            </div>
                        </div>

                        <div class="backup-details">
                            <div class="detail-row">
                                <span class="label">Scope:</span>
                                <span class="value">@backup.Scope</span>
                            </div>
                            <div class="detail-row">
                                <span class="label">Size:</span>
                                <span class="value">@FormatBytes(backup.SizeBytes)</span>
                            </div>
                            <div class="detail-row">
                                <span class="label">Triggered by:</span>
                                <span class="value">@(backup.TriggeredBy ?? "System")</span>
                            </div>
                            @if (backup.IsCompressed)
                            {
                                <div class="detail-row">
                                    <span class="label">Compression:</span>
                                    <span class="value">✓ Enabled</span>
                                </div>
                            }
                            @if (backup.IsEncrypted)
                            {
                                <div class="detail-row">
                                    <span class="label">Encryption:</span>
                                    <span class="value">🔒 Encrypted</span>
                                </div>
                            }
                        </div>

                        <div class="backup-counts">
                            @if (backup.ProjectCount > 0)
                            {
                                <div class="count-chip">
                                    <span class="count">@backup.ProjectCount</span>
                                    <span class="label">Projects</span>
                                </div>
                            }
                            @if (backup.ApplicationCount > 0)
                            {
                                <div class="count-chip">
                                    <span class="count">@backup.ApplicationCount</span>
                                    <span class="label">Applications</span>
                                </div>
                            }
                            @if (backup.ServerCount > 0)
                            {
                                <div class="count-chip">
                                    <span class="count">@backup.ServerCount</span>
                                    <span class="label">Servers</span>
                                </div>
                            }
                        </div>

                        <div class="backup-actions">
                            <button class="btn btn-icon" title="Verify integrity" @onclick="() => VerifyBackup(backup.Id)" disabled="@(verifyingId == backup.Id)">
                                @if (verifyingId == backup.Id)
                                {
                                    <span class="spinner-small"></span>
                                }
                                else
                                {
                                    <span>🔍</span>
                                }
                            </button>
                            <button class="btn btn-icon btn-primary" title="Download to computer" @onclick="() => DownloadBackup(backup.Id)" disabled="@(downloadingId == backup.Id)">
                                @if (downloadingId == backup.Id)
                                {
                                    <span class="spinner-small"></span>
                                }
                                else
                                {
                                    <span>⬇️</span>
                                }
                            </button>
                            <button class="btn btn-icon btn-success" title="Restore backup" @onclick="@(() => NavigationManager.NavigateTo($"/backups/restore/{backup.Id}"))">
                                <span>♻️</span>
                            </button>
                            <button class="btn btn-icon btn-info" title="View manifest" @onclick="() => ShowManifestModal(backup)">
                                <span>📋</span>
                            </button>
                        </div>
                    </article>
                }
            </div>
        }
    }
</div>

<!-- Manifest Modal -->
@if (showManifestModal && selectedBackup != null)
{
    <div class="modal-overlay" @onclick="CloseManifestModal">
        <div class="modal-content large" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Backup Manifest #@selectedBackup.Id</h2>
                <button class="modal-close" @onclick="CloseManifestModal">×</button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(selectedBackup.ManifestJson))
                {
                    <pre class="manifest-content">@selectedBackup.ManifestJson</pre>
                }
                else
                {
                    <p class="text-muted">No manifest available for this backup.</p>
                }
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseManifestModal">
                    Close
                </button>
            </div>
        </div>
    </div>
}

<!-- Verification Toast -->
@if (verificationResult != null)
{
    <div class="toast @(verificationResult.IsValid ? "success" : "error")">
        <span class="icon">@(verificationResult.IsValid ? "✓" : "✗")</span>
        <span>@verificationResult.Message</span>
        <button class="toast-close" @onclick="() => verificationResult = null">×</button>
    </div>
}

@code {
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private List<BackupDto> backups = new();
    private bool loading = true;
    private string? error = null;

    private bool showManifestModal = false;
    private BackupDto? selectedBackup = null;

    private int? verifyingId = null;
    private int? downloadingId = null;
    private VerificationResult? verificationResult = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadBackups();
    }

    private async Task LoadBackups()
    {
        loading = true;
        error = null;

        try
        {
            var response = await Http.GetAsync("api/Backups/system/list");
            if (response.IsSuccessStatusCode)
            {
                backups = await response.Content.ReadFromJsonAsync<List<BackupDto>>() ?? new();
            }
            else
            {
                error = $"Failed to load backups: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading backups");
            error = "An error occurred while loading backups";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task VerifyBackup(int backupId)
    {
        verifyingId = backupId;
        verificationResult = null;

        try
        {
            var response = await Http.PostAsync($"api/Backups/{backupId}/verify", null);
            var result = await response.Content.ReadFromJsonAsync<VerifyBackupResponse>();

            verificationResult = new VerificationResult
            {
                IsValid = result?.IsValid ?? false,
                Message = result?.Message ?? "Unknown error"
            };

            // Update backup verification status in UI
            var backup = backups.FirstOrDefault(b => b.Id == backupId);
            if (backup != null)
            {
                backup.IsVerified = result?.IsValid ?? false;
            }

            // Auto-hide after 5 seconds
            _ = Task.Delay(5000).ContinueWith(_ => verificationResult = null);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error verifying backup");
            verificationResult = new VerificationResult
            {
                IsValid = false,
                Message = $"Verification failed: {ex.Message}"
            };
        }
        finally
        {
            verifyingId = null;
        }
    }

    private async Task DownloadBackup(int backupId)
    {
        downloadingId = backupId;

        try
        {
            // Trigger download by navigating to the download endpoint
            var downloadUrl = $"{Http.BaseAddress}api/Backups/{backupId}/download-file";
            await JSRuntime.InvokeVoidAsync("open", downloadUrl, "_blank");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initiating backup download");
            verificationResult = new VerificationResult
            {
                IsValid = false,
                Message = $"Download failed: {ex.Message}"
            };
        }
        finally
        {
            // Small delay so user sees the loading state
            await Task.Delay(1000);
            downloadingId = null;
        }
    }

    private void ShowManifestModal(BackupDto backup)
    {
        selectedBackup = backup;
        showManifestModal = true;
    }

    private void CloseManifestModal()
    {
        showManifestModal = false;
        selectedBackup = null;
    }

    private string GetBackupIcon(string status)
    {
        return status switch
        {
            "Success" => "✅",
            "Running" => "⏳",
            "Failed" => "❌",
            _ => "📦"
        };
    }

    private string FormatBytes(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    private class BackupDto
    {
        public int Id { get; set; }
        public string Type { get; set; } = "";
        public string Status { get; set; } = "";
        public string Scope { get; set; } = "";
        public long SizeBytes { get; set; }
        public bool IsVerified { get; set; }
        public bool IsEncrypted { get; set; }
        public bool IsCompressed { get; set; }
        public int ProjectCount { get; set; }
        public int ApplicationCount { get; set; }
        public int ServerCount { get; set; }
        public string? TriggeredBy { get; set; }
        public string? ManifestJson { get; set; }
        public DateTime CreatedAt { get; set; }
    }

    private class VerifyBackupResponse
    {
        public int BackupId { get; set; }
        public bool IsValid { get; set; }
        public string Message { get; set; } = "";
    }

    private class VerificationResult
    {
        public bool IsValid { get; set; }
        public string Message { get; set; } = "";
    }
}

<style>
    .backup-history-page {
        padding: clamp(1.5rem, 3vw, 3rem);
        min-height: 100vh;
        background: radial-gradient(circle at top, rgba(99, 102, 241, 0.25), transparent 55%)
