@page "/servers"
@rendermode InteractiveServer
@using HostCraft.Core.Enums
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<Servers> Logger

<PageTitle>Servers - HostCraft</PageTitle>

<div class="page-container servers-page">
    <div class="server-hero">
        <div class="hero-copy">
            <p class="eyebrow">High Availability First</p>
            <div class="hero-title">
                <h1>Servers &amp; Swarm Managers</h1>
                <span class="ha-chip">@GetManagerCount()/3 managers</span>
            </div>
            <p class="lede">Production HA needs three managers for quorum and zero-downtime rollouts. Add servers and run the HA wizard to reach the 3-manager baseline.</p>

            <div class="hero-actions">
                <button class="btn btn-primary" @onclick="NavigateToAdd">➕ Add Server</button>
                @if (!HasLocalhost())
                {
                    <button class="btn btn-secondary" @onclick="ConfigureLocalhost" disabled="@configuringLocalhost">🖥️ @(configuringLocalhost ? "Configuring..." : "Configure Localhost")</button>
                }
                <button class="btn btn-ghost" @onclick="@(() => Navigation.NavigateTo("/setup/ha"))">🎯 HA Wizard</button>
            </div>

            <div class="hero-metrics">
                <div class="metric-card">
                    <span class="label">Managers</span>
                    <div class="value">@GetManagerCount()/3</div>
                    <small>Quorum target</small>
                </div>
                <div class="metric-card">
                    <span class="label">Servers</span>
                    <div class="value">@((servers?.Count ?? 0).ToString("N0"))</div>
                    <small>Connected</small>
                </div>
                <div class="metric-card">
                    <span class="label">Swarm nodes</span>
                    <div class="value">@((servers?.Count(s => s.IsSwarm) ?? 0).ToString("N0"))</div>
                    <small>In cluster</small>
                </div>
            </div>
        </div>

        <div class="hero-panel @(GetManagerCount() >= 3 ? "ha-ok" : "ha-warn")">
            <div class="panel-icon">@(GetManagerCount() >= 3 ? "✅" : "⚡")</div>
            <div>
                <p class="panel-title">@((GetManagerCount() >= 3) ? "Quorum ready" : "HA not ready")</p>
                <p class="panel-text">@((GetManagerCount() >= 3)
                    ? "Three managers detected. You can tolerate one failure without downtime."
                    : $"You have {GetManagerCount()} manager{(GetManagerCount() == 1 ? string.Empty : "s")}. Add managers until you reach three to tolerate failures.")</p>
                <div class="panel-actions">
                    <button class="btn btn-primary" @onclick="@(() => Navigation.NavigateTo("/setup/ha"))">Complete HA Setup</button>
                    <button class="btn btn-secondary" @onclick="NavigateToAdd">Add Manager Node</button>
                </div>
            </div>
        </div>
    </div>

    @if (loading)
    {
        <div class="data-surface loading-panel">
            <div class="spinner"></div>
            <p class="muted">Loading servers...</p>
        </div>
    }
    else if (servers == null || !servers.Any())
    {
        <div class="data-surface empty-panel">
            <div class="empty-icon">🖥️</div>
            <h2>Configure your first manager</h2>
            <p class="muted">HostCraft is running here. Configure localhost as Manager #1, then add two more managers for production HA.</p>

            <div class="empty-actions">
                <button class="btn btn-primary btn-lg" @onclick="ConfigureLocalhost" disabled="@configuringLocalhost">🖥️ @(configuringLocalhost ? "Configuring..." : "Configure Localhost")</button>
                <button class="btn btn-secondary btn-lg" @onclick="NavigateToAdd">➕ Add Remote Server</button>
                <button class="btn btn-ghost" @onclick="@(() => Navigation.NavigateTo("/setup/ha"))">🎯 HA Wizard</button>
            </div>
        </div>
    }
    else
    {
        @if (GetManagerCount() > 0 && GetManagerCount() < 3)
        {
            <div class="ha-inline-banner">
                <div class="banner-icon">⚠️</div>
                <div class="banner-copy">
                    <p class="banner-title">Incomplete HA setup</p>
                    <p class="muted">You have @GetManagerCount() manager@(GetManagerCount() == 1 ? string.Empty : "s"). Add managers until you reach three to tolerate one failure.</p>
                </div>
                <div class="banner-actions">
                    <button class="btn btn-primary" @onclick="@(() => Navigation.NavigateTo("/setup/ha"))">Complete HA Setup</button>
                    <button class="btn btn-secondary" @onclick="NavigateToAdd">Add Manager</button>
                </div>
            </div>
        }

        <div class="server-grid">
            @foreach (var server in servers)
            {
                <div class="server-card @GetStatusClass(server.Status)">
                    <div class="card-head">
                        <div class="chip-row">
                            <span class="pill type-@GetTypeBadgeClass(server.Type)">@GetTypeIcon(server.Type) @server.Type</span>
                            <span class="pill status-@GetStatusClass(server.Status)">@GetStatusIcon(server.Status) @server.Status</span>
                        </div>
                        <h3>@server.Name</h3>
                        <p class="host">@server.Host:@server.Port</p>
                        @if (!string.IsNullOrEmpty(server.ActualHostname) && server.ActualHostname != server.Name)
                        {
                            <p class="hostname">@server.ActualHostname</p>
                        }
                    </div>

                    <div class="info-grid">
                        @if (!string.IsNullOrEmpty(server.SwarmAdvertiseAddress))
                        {
                            <div class="info-chip">
                                <span class="label">Swarm IP</span>
                                <span class="value">@server.SwarmAdvertiseAddress</span>
                            </div>
                        }
                        <div class="info-chip">
                            <span class="label">User</span>
                            <span class="value">@server.User</span>
                        </div>
                        @if (server.Region != null)
                        {
                            <div class="info-chip">
                                <span class="label">Region</span>
                                <span class="value">@server.Region.Name</span>
                            </div>
                        }
                        @if (server.IsSwarm && !string.IsNullOrEmpty(server.SwarmNodeId))
                        {
                            <div class="info-chip">
                                <span class="label">Node ID</span>
                                <span class="value mono">@server.SwarmNodeId.Substring(0, Math.Min(12, server.SwarmNodeId.Length))</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(server.SwarmNodeState))
                        {
                            <div class="info-chip">
                                <span class="label">Node State</span>
                                <span class="value">@GetNodeStateIcon(server.SwarmNodeState) @server.SwarmNodeState</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(server.SwarmNodeAvailability))
                        {
                            <div class="info-chip">
                                <span class="label">Availability</span>
                                <span class="value">@GetAvailabilityIcon(server.SwarmNodeAvailability) @server.SwarmNodeAvailability</span>
                            </div>
                        }
                        @if (server.LastSeenAt.HasValue)
                        {
                            <div class="info-chip">
                                <span class="label">Last seen</span>
                                <span class="value">@GetTimeSince(server.LastSeenAt.Value)</span>
                            </div>
                        }
                    </div>

                    <div class="card-actions">
                        <button class="icon-btn" @onclick="() => NavigateToDetails(server.Id)" title="Details">🔍</button>
                        @if (server.Type == ServerType.Standalone)
                        {
                            <button class="icon-btn accent" @onclick="() => InitializeSwarm(server.Id)" title="Initialize Swarm">🐝</button>
                        }
                        @if (server.IsSwarm)
                        {
                            <button class="icon-btn" @onclick="() => NavigateToSwarmNodes(server.Id)" title="Swarm Nodes">🔗</button>
                        }
                        <button class="icon-btn" @onclick="() => NavigateToEdit(server.Id)" title="Edit">✏️</button>
                        <button class="icon-btn danger" @onclick="() => DeleteServer(server.Id)" title="Delete">🗑️</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<ServerDto>? servers;
    private bool loading = true;
    private bool configuringLocalhost;

    protected override async Task OnInitializedAsync()
    {
        await LoadServers();
    }

    private async Task LoadServers()
    {
        loading = true;
        try
        {
            servers = await Http.GetFromJsonAsync<List<ServerDto>>("api/servers");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load servers list");
            servers = new List<ServerDto>();
        }
        finally
        {
            loading = false;
        }
    }

    private bool HasLocalhost()
    {
        return servers?.Any(s => s.Host == "localhost" || s.Host == "127.0.0.1") ?? false;
    }

    private async Task ConfigureLocalhost()
    {
        configuringLocalhost = true;
        try
        {
            var response = await Http.PostAsync("api/servers/configure-localhost", null);

            if (response.IsSuccessStatusCode)
            {
                await LoadServers();
                await JS.InvokeVoidAsync("alert", "Localhost server configured successfully!");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                await JS.InvokeVoidAsync("alert", $"Failed to configure localhost: {error}");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
        finally
        {
            configuringLocalhost = false;
        }
    }

    private void NavigateToAdd() => Navigation.NavigateTo("/servers/new");
    private void NavigateToEdit(int id) => Navigation.NavigateTo($"/servers/{id}/edit");
    private void NavigateToDetails(int id) => Navigation.NavigateTo($"/servers/{id}");
    private void NavigateToSwarmNodes(int id) => Navigation.NavigateTo($"/swarm/nodes/{id}");

    private async Task InitializeSwarm(int id)
    {
        if (await JS.InvokeAsync<bool>("confirm", "Initialize Docker Swarm on this server?\n\nThis will make it a Swarm Manager."))
        {
            try
            {
                var response = await Http.PostAsync($"api/servers/{id}/swarm/init", null);

                if (response.IsSuccessStatusCode)
                {
                    await JS.InvokeVoidAsync("alert", "✅ Swarm initialized successfully!");
                    await LoadServers();
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    await JS.InvokeVoidAsync("alert", $"❌ Failed to initialize swarm: {error}");
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to initialize Docker Swarm on server {ServerId}", id);
                await JS.InvokeVoidAsync("alert", $"❌ Error: {ex.Message}");
            }
        }
    }

    private async Task DeleteServer(int id)
    {
        var server = servers?.FirstOrDefault(s => s.Id == id);
        var serverName = server?.Name ?? $"Server #{id}";

        if (await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete {serverName}?\n\nThis action cannot be undone."))
        {
            try
            {
                var response = await Http.DeleteAsync($"api/servers/{id}");

                if (response.IsSuccessStatusCode)
                {
                    await JS.InvokeVoidAsync("alert", $"✅ {serverName} deleted successfully");
                    await LoadServers();
                }
                else
                {
                    var errorContent = await response.Content.ReadAsStringAsync();
                    var statusCode = (int)response.StatusCode;

                    string errorMessage = statusCode switch
                    {
                        404 => "Server not found. It may have already been deleted.",
                        409 => "Cannot delete server with active applications. Please remove all applications first.",
                        _ => $"Failed to delete server ({statusCode}): {errorContent}"
                    };

                    await JS.InvokeVoidAsync("alert", $"❌ {errorMessage}");
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to delete server {ServerName}", serverName);
                await JS.InvokeVoidAsync("alert", $"❌ Error deleting server: {ex.Message}");
            }
        }
    }

    private string GetStatusClass(ServerStatus status) => status switch
    {
        ServerStatus.Online => "online",
        ServerStatus.Offline => "offline",
        _ => "error"
    };

    private string GetStatusIcon(ServerStatus status) => status switch
    {
        ServerStatus.Online => "🟢",
        ServerStatus.Offline => "🔴",
        ServerStatus.Error => "⚠️",
        _ => "🔄"
    };

    private string GetTypeBadgeClass(ServerType type) => type switch
    {
        ServerType.SwarmManager => "manager",
        ServerType.SwarmWorker => "worker",
        _ => "standalone"
    };

    private string GetTypeIcon(ServerType type) => type switch
    {
        ServerType.SwarmManager => "👑",
        ServerType.SwarmWorker => "⚙️",
        _ => "💻"
    };

    private string GetTimeSince(DateTime date)
    {
        var span = DateTime.Now - date;
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        return $"{(int)span.TotalDays}d ago";
    }

    private string GetNodeStateIcon(string state) => state.ToLower() switch
    {
        "ready" => "✅",
        "down" => "🔴",
        "disconnected" => "⚠️",
        _ => "⚪"
    };

    private string GetAvailabilityIcon(string availability) => availability.ToLower() switch
    {
        "active" => "✅",
        "drain" => "🔄",
        "pause" => "⏸️",
        _ => "⚪"
    };

    private int GetManagerCount() => servers?.Count(s => s.IsSwarmManager) ?? 0;

    public class ServerDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Host { get; set; } = string.Empty;
        public int Port { get; set; }
        public string Username { get; set; } = string.Empty;
        public string User => Username; // Backward compatibility
        public ServerType Type { get; set; }
        public ServerStatus Status { get; set; }
        public RegionDto? Region { get; set; }
        public string? SwarmId { get; set; }
        public string? SwarmNodeId { get; set; }
        public string? SwarmNodeState { get; set; }
        public string? SwarmNodeAvailability { get; set; }
        public string? ActualHostname { get; set; }
        public string? SwarmAdvertiseAddress { get; set; }
        public DateTime CreatedAt { get; set; }
        public DateTime? LastSeenAt { get; set; }
        public bool IsSwarmManager => Type == ServerType.SwarmManager;
        public bool IsSwarmWorker => Type == ServerType.SwarmWorker;
        public bool IsSwarm => Type == ServerType.SwarmManager || Type == ServerType.SwarmWorker;
    }

    public class RegionDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Code { get; set; } = string.Empty;
    }
}

<style>
    .servers-page {
        padding: 0 0 1.5rem 0;
    }

    .server-hero {
        display: grid;
        grid-template-columns: 2fr 1.1fr;
