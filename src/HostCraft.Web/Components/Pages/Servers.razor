                    radial-gradient(120% 120% at 80% 0%, rgba(139, 92, 246, 0.08) 0%, transparent 60%),
                    linear-gradient(135deg, #0f162f 0%, #0b1027 100%);
        border: 1px solid rgba(99, 102, 241, 0.15);
        border-radius: 16px;
        box-shadow: var(--shadow-lg, 0 12px 35px rgba(0,0,0,0.4));
