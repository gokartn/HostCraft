# HostCraft Environment Configuration
# Copy this file to .env and customize for your deployment
# This file is used by docker-compose.yml
# SECURITY: Never commit actual .env files with real values to version control!

# ==================================================
# BUILD CONFIGURATION
# ==================================================
# Build from source by default (install script detects if src/ directory exists)
# To use pre-built images, set WEB_IMAGE and API_IMAGE to registry URLs
BUILD_FROM_SOURCE=true

# Image names (override these to use pre-built images from a registry)
# Default: Builds from source and tags with these names
# WEB_IMAGE=ghcr.io/gokartn/hostcraft-web:latest
# API_IMAGE=ghcr.io/gokartn/hostcraft-api:latest
WEB_IMAGE=hostcraft-web:latest
API_IMAGE=hostcraft-api:latest

# ==================================================
# DEPLOYMENT MODE
# ==================================================
# Network driver: "overlay" for Docker Swarm (HA mode), "bridge" for standalone
# Default: overlay (HA/DR mode as per project philosophy)
NETWORK_DRIVER=overlay

# Is localhost a Swarm manager? (true/false)
# Set to true if running install script on a Swarm manager node
LOCALHOST_IS_SWARM_MANAGER=true

# Skip automatic localhost server registration? (true/false)
SKIP_LOCALHOST_SEED=false

# ==================================================
# DATABASE CONFIGURATION
# ==================================================
# PostgreSQL password (REQUIRED - change this!)
# Generated automatically by install.sh or set manually
POSTGRES_PASSWORD=HostCraft2024!SecureDefault

# ==================================================
# SECURITY
# ==================================================
# Encryption key for sensitive data (REQUIRED)
# Must be base64-encoded 32-byte key
# Generated automatically by install.sh
# Generate manually with: openssl rand -base64 32
ENCRYPTION_KEY=

# ==================================================
# TRAEFIK & SSL CONFIGURATION
# ==================================================
# Let's Encrypt email for SSL certificates (REQUIRED if using Traefik)
# Install script will prompt for this
TRAEFIK_EMAIL=admin@example.com

# Alternative email env var (fallback)
LETSENCRYPT_EMAIL=

# ==================================================
# DOMAIN CONFIGURATION
# ==================================================
# HostCraft web UI domain (can be configured later via Settings UI)
HOSTCRAFT_DOMAIN=hostcraft.localhost

# HostCraft API domain (can be configured later via Settings UI)
HOSTCRAFT_API_DOMAIN=hostcraft.localhost

# ==================================================
# DOCKER REGISTRY
# ==================================================
# Docker Registry HTTP secret (for private registry)
# Generated automatically by install.sh
# Generate manually with: openssl rand -hex 32
REGISTRY_HTTP_SECRET=changeme-generate-random-secret

# Note: All services (Traefik, Registry, Registry UI) are included by default
# for HA/DR deployments. To disable a service in standalone mode, comment it
# out in docker-compose.yml or create a custom compose file.

# ==================================================
# APPLICATION PORTS
# ==================================================
WEB_PORT=5050
API_PORT=5100

# ==================================================
# ASP.NET CORE ENVIRONMENT
# ==================================================
# Options: Development, Staging, Production
ASPNETCORE_ENVIRONMENT=Production

# ==================================================
# DOCKER COMPOSE PROJECT NAME
# ==================================================
# Used for network naming: ${COMPOSE_PROJECT_NAME}_hostcraft-network
# Default: hostcraft
COMPOSE_PROJECT_NAME=hostcraft
